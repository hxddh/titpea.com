{
  "name": "titpea.com",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "assets:og": "node scripts/generate-og-images.mjs",
    "assets:check": "npm run assets:og && tsx scripts/check-og-assets.mjs",
    "format": "prettier --write .",
