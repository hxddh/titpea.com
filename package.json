{
  "name": "titpea.com",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "tsx scripts/check.ts",
    "check:dist": "node scripts/check-dist.mjs",
    "typecheck": "astro check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "releases:sync": "node scripts/sync-releases.mjs",
    "assets:og": "tsx scripts/generate-og-images.ts",
    "assets:fonts": "tsx scripts/subset-zh-display-font.mjs",
    "new:product": "node scripts/new-product.mjs",
    "assets:images": "tsx scripts/generate-image-variants.ts",
    "assets:favicon": "tsx scripts/generate-favicons.ts",
    "assets:icons": "tsx scripts/generate-icons.ts",
    "qa:pages": "tsx scripts/qa-pages.mjs",
    "a11y:check": "node scripts/a11y-check.mjs",
    "visual:check": "tsx scripts/check-visual-baseline.mjs",
    "visual:approve": "VISUAL_APPROVE=1 tsx scripts/check-visual-baseline.mjs",
    "smoke:production": "tsx scripts/smoke-production.mjs",
    "astro": "astro",
    "test": "node --test scripts/*.test.mjs"
  },
  "dependencies": {
    "astro": "^7.3.8"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/node": "^26.6.5",
    "axe-core": "^4.14.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "sharp": "^0.34.5",
    "subset-font": "^2.9.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
