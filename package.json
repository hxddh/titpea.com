{
  "name": "titpea.com",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "assets:og": "node scripts/generate-og-images.mjs",
    "assets:check": "npm run assets:og && tsx scripts/check-og-assets.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "astro check",
    "facts:check": "tsx scripts/check-product-facts.ts",
    "facts:external": "node scripts/check-external-facts.mjs",
    "model:check": "tsx scripts/check-site-page-model.mjs",
    "contracts:check": "tsx scripts/check-page-model-contracts.mjs && tsx scripts/check-section-contracts.mjs",
    "boundaries:check": "node scripts/check-dependency-boundaries.mjs && node scripts/check-i18n-boundaries.mjs",
    "architecture:check": "node scripts/check-architecture.mjs",
    "manifest:products": "tsx scripts/check-product-manifest.mjs",
    "security:check": "node scripts/check-security.mjs",
    "a11y:check": "node scripts/check-accessibility.mjs",
    "content:check": "tsx scripts/check-content-contracts.ts",
    "manifest:check": "tsx scripts/check-site-manifest.mjs",
    "copy:lint": "node scripts/lint-copy.mjs",
    "qa:pages": "tsx scripts/qa-pages.mjs",
    "visual:check": "tsx scripts/check-visual-baseline.mjs",
    "visual:approve": "VISUAL_APPROVE=1 tsx scripts/check-visual-baseline.mjs",
    "review:screens": "node scripts/capture-review-screenshots.mjs",
    "smoke:production": "node scripts/smoke-production.mjs",
    "astro": "astro"
  },
  "dependencies": {
    "astro": "^6.4.6"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "playwright": "^1.60.0",
    "prettier": "^3.8.4",
    "prettier-plugin-astro": "^0.14.1",
    "sharp": "^0.34.5",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
