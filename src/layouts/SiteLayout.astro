---
import SiteHeader from "../components/SiteHeader.astro";
import { site, ui } from "../content/site";
import type { Locale } from "../content/schema";
import { navGroups } from "../lib/pages";
import type { CurrentPage, PageLanguageLink, PageSeo } from "../lib/pages";
import "../styles/global.css";

interface Props {
  current?: CurrentPage;
  locale?: Locale;
  seo: PageSeo;
  language: PageLanguageLink;
  pageClass?: string;
  /** True on product pages, which pin a product local nav instead of the site header. */
  localNav?: boolean;
}

const { current = "home", locale = "en", seo, language, pageClass, localNav = false } = Astro.props;
const htmlLang = locale === "zh" ? "zh-CN" : "en";
const imageUrl = seo.ogImageUrl;
const copy = ui[locale];
const year = new Date().getFullYear();
// The footer maps the whole site: every product line, then Titpea itself.
const [main, ...rest] = navGroups(locale);
const footerGroups: Array<{
  label: string;
  items: Array<{ label: string; href: string; external?: boolean; hreflang?: string }>;
}> = [
  ...rest.filter((group) => group.line),
  {
    label: site.brand,
    items: [
      ...main.items,
      { label: copy.footerFeed, href: "/releases.xml" },
      { label: "GitHub", href: site.github, external: true },
      { label: language.label, href: language.href, hreflang: language.hreflang },
    ],
  },
];
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline src="/scripts/theme.js"></script>
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={seo.description} />
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.brand} />
    <meta property="og:locale" content={locale === "zh" ? "zh_CN" : "en_US"} />
    <meta property="og:locale:alternate" content={locale === "zh" ? "en_US" : "zh_CN"} />
    <meta property="og:url" content={seo.canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seo.title} />
    <meta name="twitter:description" content={seo.description} />
    <meta name="twitter:image" content={imageUrl} />
    {seo.robots && <meta name="robots" content={seo.robots} />}
    <meta name="theme-color" content="#fbfbfd" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />
    {
      /* A noindex page (the 404) has no canonical address and no translations. */
      !seo.robots?.includes("noindex") && (
        <>
          <link rel="canonical" href={seo.canonicalUrl} />
          <link rel="alternate" hreflang="en" href={seo.alternates.en} />
          <link rel="alternate" hreflang="zh-CN" href={seo.alternates.zh} />
          <link rel="alternate" hreflang="x-default" href={seo.alternates.xDefault} />
        </>
      )
    }
    <link rel="alternate" type="application/atom+xml" title="Titpea releases" href="/releases.xml" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {
      seo.structuredData && (
        <script
          is:inline
          type="application/ld+json"
          set:html={JSON.stringify(seo.structuredData).replace(/</g, "\\u003c")}
        />
      )
    }
    <title>{seo.title}</title>
  </head>
  <body class:list={[pageClass]}>
    <a class="skip-link" href="#main-content">{copy.skipLink}</a>
    <SiteHeader
      current={current}
      locale={locale}
      alternateHref={language.href}
      alternateLabel={language.label}
      alternateLocale={language.locale}
      scrollsAway={localNav}
    />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      <nav class="shell foot-map" aria-label={copy.footerLabel}>
        {
          footerGroups.map((group) => (
            <div class="foot-group">
              <p class="foot-group-label">{group.label}</p>
              <ul>
                {group.items.map((item) => (
                  <li>
                    <a href={item.href} rel={item.external ? "noreferrer" : undefined} hreflang={item.hreflang}>
                      {item.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </nav>
      <div class="shell">
        <div class="foot">
          <span>© {year} {site.brand}</span>
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </div>
      </div>
    </footer>
    <slot name="scripts" />
    <script is:inline src="/scripts/reveal.js" defer></script>
    {
      site.analyticsToken && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: site.analyticsToken })}
        />
      )
    }
  </body>
</html>
