---
import SiteHeader from "../components/SiteHeader.astro";
import { site, ui } from "../content/site";
import type { Locale } from "../content/schema";
import type { CurrentPage, PageLanguageLink, PageSeo } from "../lib/pages";
import "../styles/global.css";

interface Props {
  current?: CurrentPage;
  locale?: Locale;
  seo: PageSeo;
  language: PageLanguageLink;
  pageClass?: string;
  /** True on product pages, which pin a product local nav instead of the site header. */
  localNav?: boolean;
}

const { current = "home", locale = "en", seo, language, pageClass, localNav = false } = Astro.props;
const htmlLang = locale === "zh" ? "zh-CN" : "en";
const imageUrl = seo.ogImageUrl;
const copy = ui[locale];
const year = new Date().getFullYear();
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline src="/scripts/theme.js"></script>
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={seo.description} />
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={seo.canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seo.title} />
    <meta name="twitter:description" content={seo.description} />
    <meta name="twitter:image" content={imageUrl} />
    {seo.robots && <meta name="robots" content={seo.robots} />}
    <meta name="theme-color" content="#fbfbfd" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />
    <link rel="canonical" href={seo.canonicalUrl} />
    <link rel="alternate" hreflang="en" href={seo.alternates.en} />
    <link rel="alternate" hreflang="zh-CN" href={seo.alternates.zh} />
    <link rel="alternate" hreflang="x-default" href={seo.alternates.xDefault} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    {
      seo.structuredData && (
        <script is:inline type="application/ld+json" set:html={JSON.stringify(seo.structuredData)} />
      )
    }
    <title>{seo.title}</title>
  </head>
  <body class:list={[pageClass]}>
    <a class="skip-link" href="#main-content">{copy.skipLink}</a>
    <SiteHeader
      current={current}
      locale={locale}
      alternateHref={language.href}
      alternateLabel={language.label}
      alternateLocale={language.locale}
      scrollsAway={localNav}
    />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="shell foot">
        <span>© {year} {site.brand}</span>
        <nav aria-label={copy.footerLabel}>
          <a href={site.github} rel="noreferrer">GitHub</a>
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </nav>
      </div>
    </footer>
    <script is:inline src="/scripts/reveal.js" defer></script>
  </body>
</html>
