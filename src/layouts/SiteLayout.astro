---
import SiteHeader from "../components/SiteHeader.astro";
import { siteConfig } from "../content/siteConfig";
import type { PageLanguageLink, PageSeo } from "../content/siteModel";
import type { CurrentPage, Locale } from "../lib/site";
import "../styles/global.css";

interface Props {
  current?: CurrentPage;
  locale?: Locale;
  seo: PageSeo;
  language: PageLanguageLink;
}

const { current = "home", locale = "en", seo, language } = Astro.props;
const htmlLang = locale === "zh" ? "zh-CN" : "en";
const imageUrl = seo.ogImageUrl || siteConfig.assets.favicon;
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={seo.description} />
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={seo.canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seo.title} />
    <meta name="twitter:description" content={seo.description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="theme-color" content="#f9fafc" />
    <link rel="canonical" href={seo.canonicalUrl} />
    <link rel="alternate" hreflang="en" href={seo.alternates.en} />
    <link rel="alternate" hreflang="zh-CN" href={seo.alternates.zh} />
    <link rel="alternate" hreflang="x-default" href={seo.alternates.xDefault} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    {
      seo.structuredData && (
        <script is:inline type="application/ld+json" set:html={JSON.stringify(seo.structuredData)} />
      )
    }
    <title>{seo.title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">{locale === "zh" ? "跳到主要内容" : "Skip to content"}</a>
    <SiteHeader
      current={current}
      locale={locale}
      alternateHref={language.href}
      alternateLabel={language.label}
      alternateLocale={language.locale}
    />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      <span>© 2026 {siteConfig.brand}</span>
      <span>{siteConfig.email}</span>
    </footer>
  </body>
</html>
