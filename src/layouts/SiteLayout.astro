---
import SiteHeader from "../components/SiteHeader.astro";
import { pathFor, slugForCurrentPage, type CurrentPage, type Locale } from "../lib/site";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  current?: CurrentPage;
  locale?: Locale;
}

const { title, description, current = "home", locale = "en" } = Astro.props;
const siteTitle = title === "Titpea" ? title : `${title} - Titpea`;
const isZh = locale === "zh";
const htmlLang = isZh ? "zh-CN" : "en";
const currentSlug = slugForCurrentPage(current);
const englishHref = pathFor("en", currentSlug);
const chineseHref = pathFor("zh", currentSlug);
const canonicalPath = isZh ? chineseHref : englishHref;
const canonicalUrl = `https://titpea.com${canonicalPath}`;
const englishUrl = `https://titpea.com${englishHref}`;
const chineseUrl = `https://titpea.com${chineseHref}`;
const alternateLocale = isZh ? "en" : "zh";
const alternateLabel = isZh ? "English" : "中文";
const alternateHref = isZh ? englishHref : chineseHref;
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="theme-color" content="#f9fafc" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="en" href={englishUrl} />
    <link rel="alternate" hreflang="zh-CN" href={chineseUrl} />
    <link rel="alternate" hreflang="x-default" href={englishUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <title>{siteTitle}</title>
  </head>
  <body>
    <SiteHeader
      current={current}
      locale={locale}
      alternateHref={alternateHref}
      alternateLabel={alternateLabel}
      alternateLocale={alternateLocale}
    />
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <span>© 2026 Titpea</span>
      <span>info@titpea.com</span>
    </footer>
  </body>
</html>
