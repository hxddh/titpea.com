---
import ProductPage from "../components/ProductPage.astro";
import { productModel } from "../content/siteModel";
import { productSlugs } from "../content/products";

export function getStaticPaths() {
  return productSlugs.map((slug) => ({
    params: { slug },
    props: { model: productModel(slug, "en") },
  }));
}

interface Props {
  model: ReturnType<typeof productModel>;
}

const { model } = Astro.props;
---

<ProductPage model={model} />
