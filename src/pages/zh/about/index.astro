---
import SiteLayout from "../../../layouts/SiteLayout.astro";

const products = [
  {
    name: "世界时钟",
    href: "/zh/world-clock/",
    summary: "一个极简 Chrome 扩展，用来查看主要城市的实时本地时间。",
  },
  {
    name: "豆瓣电影评分助手",
    href: "/zh/douban-movie-rating/",
    summary: "在豆瓣电影详情页直接显示 IMDb 评分和 Rotten Tomatoes 新鲜度。",
  },
  {
    name: "s3-turbo-list",
    href: "/zh/s3-turbo-list/",
    summary: "高性能 S3 兼容存储桶列举、追踪、差异对比、断点续跑和 Parquet 导出工具。",
  },
  {
    name: "StorageOps",
    href: "/zh/storageops/",
    summary: "面向 S3 兼容对象存储问题的诊断系统和 Pi 技能包。",
  },
  {
    name: "https-traffic-inspector",
    href: "https://github.com/hxddh/https-traffic-inspector",
    summary: "用于请求分析和兼容性测试的 HTTPS 流量检查工作台。",
  },
];

const writing = [
  "对象存储诊断与兼容性测试",
  "S3 兼容列举、追踪、差异对比和 Parquet 导出",
  "服务日常工作流的 Chrome 扩展产品",
];
---

<SiteLayout
  title="关于"
  description="hxddh 的个人简介、Chrome 扩展和基础设施项目。"
  current="about"
  locale="zh"
>
  <section class="about-hero shell">
    <div>
      <p class="eyebrow">hxddh</p>
      <h1>构建面向浏览器、存储系统和日常技术工作的专注工具。</h1>
      <p class="lead">
        我做小产品和开发者工具：用于日常场景的 Chrome 扩展，以及围绕 S3 兼容存储、诊断和 HTTPS 流量检查的基础设施工具。
      </p>
      <div class="socials" aria-label="社交链接">
        <a href="https://github.com/hxddh" rel="noreferrer">GitHub</a>
        <a href="https://chromewebstore.google.com/detail/world-clock/mghphbjnicggehnhbjbpjddfidkepnfp" rel="noreferrer">Chrome Web Store</a>
        <a href="mailto:info@titpea.com">Email</a>
      </div>
    </div>
    <figure class="portrait-card">
      <div class="portrait-grid" aria-hidden="true">
        <span></span><span></span><span></span><span></span>
        <span></span><span></span><span></span><span></span>
        <span></span><span></span><span></span><span></span>
      </div>
      <figcaption>Chrome extensions / storage tools / technical notes</figcaption>
    </figure>
  </section>

  <section class="shell content-section">
    <p class="section-kicker">产品和项目</p>
    <div class="product-list">
      {products.map((product) => (
        <a class="product-row" href={product.href}>
          <span>{product.name}</span>
          <p>{product.summary}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="band">
    <div class="shell split-content">
      <div>
        <p class="section-kicker">简介</p>
        <h2>做目标清晰、边界明确、能被长期维护的软件。</h2>
      </div>
      <div class="prose">
        <p>
          当前的产品组合包含两个公开 Chrome 扩展：用于快速查看时区的世界时钟，以及把国际电影评分带到豆瓣页面的豆瓣电影评分助手。
        </p>
        <p>
          开发者工具方向主要是 s3-turbo-list、StorageOps 和 https-traffic-inspector，覆盖列举性能、诊断、兼容性检查、追踪、导出流程和请求检查。
        </p>
      </div>
    </div>
  </section>

  <section class="shell content-section" id="writing">
    <p class="section-kicker">关注方向</p>
    <ul class="writing-list">
      {writing.map((item) => <li>{item}</li>)}
    </ul>
  </section>
</SiteLayout>
