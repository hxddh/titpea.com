---
import SiteLayout from "../../../layouts/SiteLayout.astro";

const features = [
  ["实时城市时间", "快速查看全球主要城市的当前时间。"],
  ["极简界面", "为快速查询设计，而不是复杂的日历和排期工具。"],
  ["多语言", "支持 9 种语言，包括英文、中文、日文、韩文、法文、德文、西班牙文和葡萄牙文。"],
  ["隐私友好", "Chrome Web Store 信息显示，该扩展不会收集或使用用户数据。"],
];
---

<SiteLayout
  title="世界时钟"
  description="一个用于查看主要城市实时本地时间的极简 Chrome 扩展。"
  current="world-clock"
  locale="zh"
>
  <section class="product-hero shell">
    <div class="product-copy">
      <p class="eyebrow">Chrome 扩展</p>
      <h1>一键查看世界时间。</h1>
      <p class="lead">
        世界时钟是一个极简 Chrome 扩展，用于查看主要城市的实时本地时间，不需要打开完整日历或搜索页面。
      </p>
      <div class="actions">
        <a class="button primary" href="https://chromewebstore.google.com/detail/world-clock/mghphbjnicggehnhbjbpjddfidkepnfp" rel="noreferrer">安装扩展</a>
        <a class="button ghost" href="/zh/about/">返回简介</a>
      </div>
      <p class="meta-line">Version 7.0 · Updated June 1, 2026 · 138 users · 44.08 KiB</p>
    </div>
    <div class="clock-visual" aria-label="World Clock preview">
      <div class="clock-city primary-city">
        <span>Singapore</span>
        <strong>00:06</strong>
      </div>
      <div class="clock-city">
        <span>Tokyo</span>
        <strong>01:06</strong>
      </div>
      <div class="clock-city">
        <span>London</span>
        <strong>17:06</strong>
      </div>
      <div class="clock-city">
        <span>New York</span>
        <strong>12:06</strong>
      </div>
    </div>
  </section>

  <section class="shell content-section">
    <p class="section-kicker">功能</p>
    <div class="feature-grid">
      {features.map(([title, body]) => (
        <article class="feature">
          <h2>{title}</h2>
          <p>{body}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="band">
    <div class="shell split-content">
      <div>
        <p class="section-kicker">详情</p>
        <h2>小、快，并且原生运行在浏览器里。</h2>
      </div>
      <div class="prose">
        <p>
          该扩展在 Chrome Web Store 中归类为 Tools，由 titpea.com 提供，安装包体积很轻。
        </p>
        <p>
          适合远程协作、旅行安排，或快速确认某个城市是否处于工作时间。
        </p>
      </div>
    </div>
  </section>
</SiteLayout>
