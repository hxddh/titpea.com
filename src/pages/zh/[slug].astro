---
import ProductPage from "../../components/ProductPage.astro";
import { products } from "../../content/products";
import { productPage, type ProductPageModel } from "../../lib/pages";

export function getStaticPaths() {
  return products.map((product) => ({ params: { slug: product.slug }, props: { model: productPage(product, "zh") } }));
}

const { model } = Astro.props as { model: ProductPageModel };
---

<ProductPage model={model} />
