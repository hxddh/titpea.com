---
import ProductPage from "../../components/ProductPage.astro";
import type { ProductSlug } from "../../lib/site";
import { productSlugs, products } from "../../content/products";

export function getStaticPaths() {
  return productSlugs.map((slug) => ({
    params: { slug },
    props: { product: products[slug] },
  }));
}

interface Props {
  product: (typeof products)[ProductSlug];
}

const { product } = Astro.props;
---

<ProductPage locale="zh" product={product} />
