---
import SiteLayout from "../../../layouts/SiteLayout.astro";
import { buildSeo, languageLink } from "../../../lib/pages";

const path = "/easier-bookmarks/privacy/";
const alternatePath = "/zh/easier-bookmarks/privacy/";
const seo = buildSeo({
  title: "Easier Bookmarks Privacy Policy - Titpea",
  description: "How Easier Bookmarks handles bookmark data and local preferences.",
  path,
  alternatePath,
  locale: "en",
  ogImage: "/assets/og-easier-bookmarks.png",
});
---

<SiteLayout seo={seo} current="easier-bookmarks" locale="en" language={languageLink("en", alternatePath)}>
  <article class="privacy-page shell">
    <header class="privacy-header">
      <p class="eyebrow"><a href="/easier-bookmarks/">Easier Bookmarks</a></p>
      <h1>Privacy Policy</h1>
      <p class="privacy-updated">Last updated: September 30, 2026</p>
      <p class="lead">Easier Bookmarks is a local Chrome side panel for the bookmarks already in this browser.</p>
    </header>

    <div class="privacy-content prose">
      <section>
        <h2>What the extension accesses, and why</h2>
        <p>
          Easier Bookmarks does not collect, transmit, sell, or share any of your data. It has no servers, accounts,
          analytics, or advertising; everything happens inside your browser.
        </p>
        <ul>
          <li>
            <code>bookmarks</code>: showing your Chrome bookmarks and creating, editing, moving, or deleting them when
            you ask. Changes go to Chrome's own bookmarks, so Chrome Sync behaves as it does for bookmarks you edit
            yourself.
          </li>
          <li>
            <code>storage</code>: remembering which folders are open, the IDs and last-opened times of up to 500
            bookmarks you opened from the panel (to rank search results), and whether the optional permission below was
            already requested. Stored locally with <code>chrome.storage.local</code>.
          </li>
          <li><code>sidePanel</code>: displaying the extension in Chrome's side panel.</li>
          <li>
            <code>favicon</code>: showing each site's icon from Chrome's local icon cache. No network requests are made.
          </li>
          <li>
            <code>tabs</code> (optional): requested only the first time you choose + → Bookmark, and used only then to read
            the current tab's title and address so they can be filled in. You can decline; the form then opens empty.
          </li>
        </ul>
      </section>
      <section>
        <h2>What stays on your device</h2>
        <p>
          Only the items listed under <code>storage</code>: which folders are open, the IDs and last-opened times of up
          to 500 bookmarks, and whether the optional permission was requested. They are never sent anywhere and are
          removed when you uninstall the extension. Your bookmarks themselves are Chrome's own data; with Chrome Sync
          on, Chrome syncs them exactly as it does without this extension.
        </p>
      </section>
      <section>
        <h2>What we never do</h2>
        <p>
          We do not collect personal information, browsing history, bookmark contents, or usage data. We do not use
          remote code, third-party services, or trackers. Your data is not sold, transferred to third parties, or used
          for any purpose other than the features described above.
        </p>
      </section>
      <section>
        <h2>Limited Use</h2>
        <p>
          Easier Bookmarks' use of information received from Chrome APIs adheres to the Chrome Web Store User Data
          Policy, including the Limited Use requirements.
        </p>
      </section>
      <section>
        <h2>Changes to this policy</h2>
        <p>If this policy changes, the updated version will be published on this page with a new date.</p>
      </section>
      <section>
        <h2>Contact</h2>
        <p>For privacy questions, email <a href="mailto:info@titpea.com">info@titpea.com</a>.</p>
      </section>
    </div>
  </article>
</SiteLayout>
