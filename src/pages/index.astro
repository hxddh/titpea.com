---
import SiteLayout from "../layouts/SiteLayout.astro";

const productLines = [
  {
    label: "Storage tools",
    title: "Infrastructure diagnostics and inventory.",
    items: [
      {
        name: "s3-turbo-list",
        href: "/s3-turbo-list/",
        text: "Fast S3-compatible listing, tracing, diffing, checkpoint/resume, and Parquet export.",
      },
      {
        name: "StorageOps",
        href: "/storageops/",
        text: "Pi extension and skill pack for evidence-based object storage diagnosis.",
      },
      {
        name: "https-traffic-inspector",
        href: "https://github.com/hxddh/https-traffic-inspector",
        text: "HTTPS traffic inspection workbench for request behavior and compatibility checks.",
      },
    ],
  },
  {
    label: "Browser extensions",
    title: "Focused helpers for everyday browsing.",
    items: [
      {
        name: "World Clock",
        href: "/world-clock/",
        text: "Minimal live time lookup across major cities.",
      },
      {
        name: "豆瓣电影评分助手",
        href: "/douban-movie-rating/",
        text: "IMDb and Rotten Tomatoes ratings on Douban movie pages.",
      },
    ],
  },
];
---

<SiteLayout
  title="Titpea"
  description="Titpea is the personal site and product index for hxddh."
  current="home"
>
  <section class="home-hero home-hero-modern shell">
    <div class="home-copy">
      <p class="eyebrow">hxddh / product index</p>
      <h1>Useful tools, kept small.</h1>
      <p class="lead">
        Chrome extensions and infrastructure utilities for object storage,
        diagnostics, time, and movies.
      </p>
      <div class="actions">
        <a class="button primary" href="/s3-turbo-list/">s3-turbo-list</a>
        <a class="button ghost" href="/storageops/">StorageOps</a>
        <a class="button ghost" href="/about/">About</a>
      </div>
    </div>

    <div class="home-panel" aria-label="Featured projects">
      <a class="featured-product featured-primary" href="/s3-turbo-list/">
        <span>01 / Storage</span>
        <strong>s3-turbo-list</strong>
        <p>Concurrent S3-compatible bucket inventory with traces and Parquet output.</p>
      </a>
      <div class="featured-row">
        <a class="featured-product" href="/storageops/">
          <span>02 / Diagnosis</span>
          <strong>StorageOps</strong>
        </a>
        <a class="featured-product" href="/world-clock/">
          <span>03 / Browser</span>
          <strong>World Clock</strong>
        </a>
      </div>
    </div>
  </section>

  <section class="home-products shell">
    {productLines.map((line) => (
      <section class="product-line" aria-label={line.label}>
        <div class="product-line-heading">
          <p class="section-kicker">{line.label}</p>
          <h2>{line.title}</h2>
        </div>
        <div class="compact-list">
          {line.items.map((item) => (
            <a class="compact-link" href={item.href}>
              <span>{item.name}</span>
              <p>{item.text}</p>
            </a>
          ))}
        </div>
      </section>
    ))}
  </section>
</SiteLayout>
