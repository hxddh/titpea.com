---
import SiteLayout from "../layouts/SiteLayout.astro";
import { site } from "../content/site";
import { products } from "../content/products";
import { buildSeo, languageLink, pathFor } from "../lib/pages";

const path = "/404.html";
const seo = buildSeo({
  title: "Page not found - Titpea",
  description: "This address does not match a Titpea product or page.",
  path,
  alternatePath: "/zh/",
  locale: "en",
  ogImage: site.og.home,
  robots: "noindex",
});
---

<SiteLayout seo={seo} locale="en" language={languageLink("en", "/zh/")} pageClass="page-notfound">
  <article class="privacy-page shell">
    <header class="privacy-header">
      <p class="eyebrow">Titpea</p>
      <h1>This page is not here</h1>
      <p class="lead">Try the home index, or switch language below.</p>
      <p class="lead">回首页，或切换到另一语言。</p>
      <div class="actions">
        <a class="button primary" href="/">Home</a>
        <a class="button ghost" href="/zh/">中文首页</a>
      </div>
    </header>
    <nav class="notfound-products" aria-label="Products · 产品">
      <p class="section-kicker">Products · 产品</p>
      <ul>
        {
          products.map((product) => (
            <li>
              <a href={pathFor("en", product.slug)}>
                <img src={product.icon} alt="" width="28" height="28" />
                <span>{product.en.title}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </article>
</SiteLayout>
