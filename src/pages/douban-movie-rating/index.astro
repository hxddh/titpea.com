---
import SiteLayout from "../../layouts/SiteLayout.astro";

const features = [
  ["IMDb rating", "Automatically shows IMDb scores on Douban movie detail pages."],
  ["Rotten Tomatoes", "Adds Rotten Tomatoes freshness when a reliable match is available."],
  ["Direct jumps", "Click a rating to open the matching IMDb or Rotten Tomatoes page."],
  ["Title matching", "Supports intelligent matching across Chinese and English movie titles."],
];
---

<SiteLayout
  title="豆瓣电影评分助手"
  description="A Chrome extension that shows IMDb and Rotten Tomatoes ratings on Douban movie pages."
  current="douban"
>
  <section class="product-hero shell">
    <div class="product-copy">
      <p class="eyebrow">Chrome Extension</p>
      <h1>把 IMDb 和烂番茄带到豆瓣电影页面。</h1>
      <p class="lead">
        豆瓣电影评分助手会在豆瓣电影详情页自动显示 IMDb 评分和烂番茄新鲜度，
        帮你在同一个页面里快速对照不同评分体系。
      </p>
      <div class="actions">
        <a class="button primary" href="https://chromewebstore.google.com/detail/%E8%B1%86%E7%93%A3%E7%94%B5%E5%BD%B1%E8%AF%84%E5%88%86%E5%8A%A9%E6%89%8B/alhcfchcficmeggkhcpkojoipdkkgoif" rel="noreferrer">安装扩展</a>
        <a class="button ghost" href="/about/">返回简介</a>
      </div>
      <p class="meta-line">Version 1.2 · Updated May 31, 2026 · 39 users · 35.42 KiB</p>
    </div>
    <div class="rating-visual" aria-label="Douban movie rating assistant preview">
      <div class="movie-panel">
        <span class="movie-title">电影详情</span>
        <div class="score-row">
          <span>Douban</span>
          <strong>8.7</strong>
        </div>
        <div class="score-row imdb">
          <span>IMDb</span>
          <strong>8.4</strong>
        </div>
        <div class="score-row tomato">
          <span>Rotten Tomatoes</span>
          <strong>94%</strong>
        </div>
      </div>
    </div>
  </section>

  <section class="shell content-section">
    <p class="section-kicker">Features</p>
    <div class="feature-grid">
      {features.map(([title, body]) => (
        <article class="feature">
          <h2>{title}</h2>
          <p>{body}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="band">
    <div class="shell split-content">
      <div>
        <p class="section-kicker">Details</p>
        <h2>一个页面里看完中外电影评分。</h2>
      </div>
      <div class="prose">
        <p>
          Chrome Web Store 信息显示，该扩展属于 Entertainment 分类，由 titpea.com 提供。
        </p>
        <p>
          商店隐私说明显示开发者声明不会收集或使用用户数据，并提供了 GitHub 上的隐私政策链接。
        </p>
      </div>
    </div>
  </section>
</SiteLayout>
