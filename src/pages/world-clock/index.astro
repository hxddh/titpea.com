---
import SiteLayout from "../../layouts/SiteLayout.astro";

const features = [
  ["Live city times", "Quickly check the current time in major cities around the world."],
  ["Minimal surface", "A compact extension designed for fast lookup instead of calendar-heavy planning."],
  ["Multilingual", "Available in 9 languages including English, Chinese, Japanese, Korean, French, German, Spanish, and Portuguese."],
  ["Private by design", "The Chrome Web Store listing states that the extension does not collect or use user data."],
];
---

<SiteLayout
  title="World Clock"
  description="A minimalist Chrome extension showing live time across major cities."
  current="world-clock"
>
  <section class="product-hero shell">
    <div class="product-copy">
      <p class="eyebrow">Chrome Extension</p>
      <h1>World time, one click away.</h1>
      <p class="lead">
        World Clock is a minimalist Chrome extension for checking live time across
        major cities without opening a full calendar or search page.
      </p>
      <div class="actions">
        <a class="button primary" href="https://chromewebstore.google.com/detail/world-clock/mghphbjnicggehnhbjbpjddfidkepnfp" rel="noreferrer">Install</a>
        <a class="button ghost" href="/about/">Back to profile</a>
      </div>
      <p class="meta-line">Version 7.0 · Updated June 1, 2026 · 138 users · 44.08 KiB</p>
    </div>
    <div class="clock-visual" aria-label="World Clock preview">
      <div class="clock-city primary-city">
        <span>Singapore</span>
        <strong>00:06</strong>
      </div>
      <div class="clock-city">
        <span>Tokyo</span>
        <strong>01:06</strong>
      </div>
      <div class="clock-city">
        <span>London</span>
        <strong>17:06</strong>
      </div>
      <div class="clock-city">
        <span>New York</span>
        <strong>12:06</strong>
      </div>
    </div>
  </section>

  <section class="shell content-section">
    <p class="section-kicker">Features</p>
    <div class="feature-grid">
      {features.map(([title, body]) => (
        <article class="feature">
          <h2>{title}</h2>
          <p>{body}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="band">
    <div class="shell split-content">
      <div>
        <p class="section-kicker">Details</p>
        <h2>Small, fast, and browser-native.</h2>
      </div>
      <div class="prose">
        <p>
          The extension is listed under Tools in the Chrome Web Store, offered by
          titpea.com, and is sized for a lightweight install.
        </p>
        <p>
          Use it as a quick timezone glance for remote work, travel coordination,
          or checking whether a city is in business hours.
        </p>
      </div>
    </div>
  </section>
</SiteLayout>
