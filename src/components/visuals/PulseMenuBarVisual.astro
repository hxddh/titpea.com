---
import type { PulseMenuBarVisualModel } from "../../content/visualModels";

interface Props {
  visual: PulseMenuBarVisualModel;
}

const { visual } = Astro.props;
---

<div class="pulse-menubar-visual" aria-label={visual.label}>
  <div class="pulse-menubar-bar">
    <span>{visual.menubarLabel}</span>
    <strong class="pulse-menubar-glance">
      <span class="pulse-lamp pulse-lamp-waiting" aria-hidden="true"></span>
      {visual.glanceTitle}
    </strong>
  </div>
  <div class="pulse-menubar-panel">
    <div class="pulse-menubar-header">
      <strong>{visual.headerStatus}</strong>
      <span>{visual.headerAgents}</span>
    </div>
    {
      visual.sections.map((section) => (
        <section class="pulse-menubar-section">
          <h3>{section.title}</h3>
          <ul>
            {section.rows.map((row) => (
              <li class={`pulse-row pulse-row-${row.state}`}>
                <span class={`pulse-lamp pulse-lamp-${row.state}`} aria-hidden="true" />
                <div>
                  <strong>{row.title}</strong>
                  <p>{row.meta}</p>
                </div>
                {row.chip ? <em>{row.chip}</em> : null}
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
  <div class="pulse-menubar-foot">
    {visual.footnotes.map((item) => <span>{item}</span>)}
  </div>
</div>
