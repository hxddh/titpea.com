---
import type { PagewiseWorkbenchVisualModel } from "../../content/visualModels";

interface Props {
  visual: PagewiseWorkbenchVisualModel;
}

const { visual } = Astro.props;
---

<div class="pagewise-visual" aria-label={visual.label}>
  <div class="workbench-titlebar">
    <span class="workbench-dots" aria-hidden="true"><i></i><i></i><i></i></span>
    <span class="workbench-title">{visual.windowTitle}</span>
    <span class="workbench-spacer"></span>
  </div>
  <div class="pagewise-body">
    <aside class="pagewise-sidebar">
      <span class="workbench-group">{visual.recentLabel}</span>
      <ul class="pagewise-files">
        {
          visual.recent.map((item, index) => (
            <li class:list={[index === 0 && "active"]}>
              <strong>{item.title}</strong>
              <small>{item.pages}</small>
            </li>
          ))
        }
      </ul>
    </aside>
    <div class="pagewise-preview">
      <div class="pagewise-preview-head">
        <strong>{visual.activeDoc}</strong>
        <span>
          {visual.pageLabel}
          {visual.currentPage} / {visual.totalPages}
        </span>
      </div>
      <div class="pagewise-page">
        <p>{visual.pageExcerpt}</p>
      </div>
    </div>
    <div class="pagewise-chat">
      <p class="workbench-q">{visual.question}</p>
      <p class="workbench-sub">{visual.subtitle}</p>
      <div class="workbench-input">
        <span class="workbench-input-ph">{visual.inputPlaceholder}</span>
        <div class="workbench-input-foot">
          <span class="workbench-model">{visual.model}</span>
        </div>
      </div>
      <div class="workbench-chips">
        {visual.chips.map((chip) => <span>{chip}</span>)}
      </div>
    </div>
  </div>
</div>
