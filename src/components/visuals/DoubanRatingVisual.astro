---
import type { ScreenshotVisualModel } from "../../content/visualModels";

interface Props {
  visual: ScreenshotVisualModel;
}

const { visual } = Astro.props;
const image = visual.images[0];
---

<figure class="product-screenshot-visual">
  <img src={image.src} alt={image.alt} width={image.width} height={image.height} fetchpriority="high" />
</figure>
