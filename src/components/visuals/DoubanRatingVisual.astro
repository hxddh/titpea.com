---
import type { ScreenshotVisualModel } from "../../content/visualModels";

interface Props {
  visual: ScreenshotVisualModel;
}

const { visual } = Astro.props;
const image = visual.images[0];
---

<div class="rating-visual product-scene rating-scene" aria-label={visual.label}>
  <div class="douban-shot-frame">
    <img src={image.src} alt={image.alt} loading="eager" />
  </div>
</div>
