---
import type { ScreenshotVisualModel } from "../../content/visualModels";

interface Props {
  visual: ScreenshotVisualModel;
}

const { visual } = Astro.props;
// Prefer a single primary shot for a clean product stage (light theme first).
const primary = visual.images[0] ?? null;
---

<div class="clock-visual product-scene clock-scene" aria-label={visual.label}>
  <div class="clock-shot-stack">
    {
      primary && (
        <img
          class={primary.className}
          src={primary.src}
          alt={primary.alt}
          width={primary.width}
          height={primary.height}
          loading="eager"
        />
      )
    }
  </div>
</div>
