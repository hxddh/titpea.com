---
import type { ScreenshotVisualModel } from "../../content/visualModels";

interface Props {
  visual: ScreenshotVisualModel;
}

const { visual } = Astro.props;
---

<div class="clock-visual product-scene clock-scene" aria-label={visual.label}>
  <div class="clock-shot-stack">
    {visual.images.map((image) => <img class={image.className} src={image.src} alt={image.alt} loading="eager" />)}
  </div>
</div>
