---
import type { StorageAgentVisualModel } from "../../content/visualModels";

interface Props {
  visual: StorageAgentVisualModel;
}

const { visual } = Astro.props;
---

<div class="diagnostic-visual agent-manifest-visual" aria-label={visual.label}>
  <div class="agent-manifest-head">
    <p class="section-kicker">{visual.kicker}</p>
    <h2>{visual.title}</h2>
    <p>{visual.body}</p>
  </div>
  <div class="agent-manifest-grid">
    {
      visual.cards.map((card) => (
        <div>
          <span>{card.number}</span>
          <strong>{card.title}</strong>
          <p>{card.body}</p>
        </div>
      ))
    }
  </div>
  <div class="agent-flow-line">
    <span>{visual.flow[0]}</span>
    <span>{visual.flow[1]}</span>
  </div>
</div>
