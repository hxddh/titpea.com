---
import type { GobanBoardVisualModel } from "../../content/visualModels";

interface Props {
  visual: GobanBoardVisualModel;
}

const { visual } = Astro.props;
---

<div class="goban-visual product-scene" aria-label={visual.label}>
  <div class="goban-window-bar">
    <span>{visual.status}</span>
    <span>{visual.moves}</span>
  </div>
  <div class="goban-board" role="img" aria-label={visual.label}>
    <i class="goban-stone black stone-1"></i>
    <i class="goban-stone white stone-2"></i>
    <i class="goban-stone black stone-3"></i>
    <i class="goban-stone white stone-4"></i>
    <i class="goban-stone black stone-5"></i>
    <i class="goban-stone white stone-6"></i>
    <i class="goban-hint"></i>
  </div>
  <div class="goban-status-bar">
    <strong>{visual.turn}</strong>
    <span>{visual.hint}</span>
  </div>
</div>
