---
import type { S3BenchmarkVisualModel } from "../../content/visualModels";

interface Props {
  visual: S3BenchmarkVisualModel;
}

const { visual } = Astro.props;
---

<div class="terminal-visual benchmark-visual benchmark-report" aria-label={visual.label}>
  <div class="benchmark-head">
    <p class="section-kicker">{visual.kicker}</p>
    <h2>{visual.title}</h2>
    <p>{visual.body}</p>
    <div class="benchmark-meta">
      {visual.meta.map((item) => <span>{item}</span>)}
    </div>
  </div>
  <div class="benchmark-layout">
    <div class="throughput-bars" aria-label={visual.barsLabel}>
      <div class="bars-head">
        <span>{visual.barsHead[0]}</span>
        <span>{visual.barsHead[1]}</span>
      </div>
      {
        visual.bars.map(({ label, throughput, seconds, state }) => (
          <div class:list={["bar-row", state && `is-${state}`]}>
            <span class="bar-label">{label}</span>
            <div class="bar-track">
              <span style={`width: ${(throughput / visual.maxThroughput) * 100}%`} />
            </div>
            <strong>{throughput.toLocaleString()}</strong>
            <em>{seconds}s</em>
          </div>
        ))
      }
    </div>
    <div class="automation-path">
      <span>{visual.pathLabel}</span>
      <p>{visual.pathBody}</p>
    </div>
  </div>
  <div class="benchmark-facts">
    {
      visual.facts.map((fact) => (
        <p>
          <strong>{fact.value}</strong>
          {fact.label}
        </p>
      ))
    }
  </div>
  <div class="benchmark-footnotes">
    {visual.footnotes.map((item) => <span>{item}</span>)}
  </div>
</div>
