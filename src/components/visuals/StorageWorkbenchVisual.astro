---
import type { StorageWorkbenchVisualModel } from "../../content/visualModels";

interface Props {
  visual: StorageWorkbenchVisualModel;
}

const { visual } = Astro.props;
---

<div class="workbench-visual" aria-label={visual.label}>
  <div class="workbench-titlebar">
    <span class="workbench-dots" aria-hidden="true"><i></i><i></i><i></i></span>
    <span class="workbench-title">{visual.windowTitle}</span>
    <span class="workbench-spacer"></span>
  </div>
  <div class="workbench-body">
    <aside class="workbench-sidebar">
      <span class="workbench-brand">{visual.brand}</span>
      <span class="workbench-newchat">+ {visual.newChat}</span>
      <span class="workbench-search">{visual.search}</span>
      <span class="workbench-group">{visual.pinnedLabel}</span>
      <div class="workbench-session active">
        <strong>{visual.pinned.title}</strong>
        <small>{visual.pinned.time}</small>
      </div>
      <span class="workbench-group">{visual.recentLabel}</span>
      <ul class="workbench-sessions">
        {
          visual.recent.map((item) => (
            <li>
              <strong>{item.title}</strong>
              <small>{item.time}</small>
            </li>
          ))
        }
      </ul>
      <span class="workbench-connected">{visual.connected}</span>
    </aside>
    <div class="workbench-welcome">
      <p class="workbench-q">{visual.question}</p>
      <p class="workbench-sub">{visual.subtitle}</p>
      <div class="workbench-input">
        <span class="workbench-input-ph">{visual.inputPlaceholder}</span>
        <div class="workbench-input-foot">
          <span class="workbench-attach" aria-hidden="true">◍</span>
          <span class="workbench-model">{visual.model}</span>
        </div>
      </div>
      <div class="workbench-chips">
        {visual.chips.map((chip) => <span>{chip}</span>)}
      </div>
    </div>
  </div>
</div>
