---
import type { ScreenshotVisualModel } from "../../content/visualModels";

interface Props {
  visual: ScreenshotVisualModel;
}

const { visual } = Astro.props;
const image = visual.images[0];
---

<div class="product-scene product-single-screenshot" aria-label={visual.label}>
  <div class="product-single-screenshot-frame">
    <img src={image.src} alt={image.alt} width={image.width} height={image.height} loading="eager" />
  </div>
</div>
