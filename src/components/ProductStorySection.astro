---
import type { ProductSection } from "../content/productSections";

interface Props {
  section: Extract<ProductSection, { kind: "story" }>;
}

const { section } = Astro.props;
---

<section id={section.id} class="product-story">
  <div class="split-content">
    <div>
      <p class="section-kicker">{section.label}</p>
      <h3>{section.title}</h3>
    </div>
    <div class="prose">
      {section.body.map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </div>
</section>
