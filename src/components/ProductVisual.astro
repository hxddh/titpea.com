---
import type { Product } from "../lib/site";

interface Props {
  product: Product;
}

const { product } = Astro.props;
---

{product.visual === "terminal" && (
  <div class="terminal-visual" aria-label="s3-turbo-list terminal preview">
    <div class="window-bar"><span></span><span></span><span></span></div>
    <div class="terminal-hero-grid">
      <pre><code>$ s3-turbo-list list s3://archive \
  --output objects.parquet \
  --trace trace.jsonl

discovering key-space…
listing segment 42/64
writing parquet row groups</code></pre>
      <div class="terminal-summary">
        <div><span>segments</span><strong>64</strong></div>
        <div><span>checkpoint</span><strong>ready</strong></div>
        <div><span>objects.parquet</span><strong>written</strong></div>
        <div><span>trace.jsonl</span><strong>captured</strong></div>
      </div>
    </div>
  </div>
)}

{product.visual === "diagnostic" && (
  <div class="diagnostic-visual" aria-label="StorageOps diagnostic preview">
    <div class="window-bar"><span></span><span></span><span></span></div>
    <div class="incident-card">
      <span>Input</span>
      <strong>s5cmd sync reports 429 SlowDown</strong>
    </div>
    <div class="diagnosis-grid">
      <div>
        <span>Domain</span>
        <strong>performance / throttling</strong>
      </div>
      <div>
        <span>Evidence</span>
        <strong>redacted HTTP trace</strong>
      </div>
    </div>
  </div>
)}

{product.visual === "clock" && (
  <div class="clock-visual" aria-label="World Clock preview">
    <div class="clock-city primary-city">
      <span>Singapore</span>
      <strong>00:06</strong>
    </div>
    <div class="clock-city">
      <span>Tokyo</span>
      <strong>01:06</strong>
    </div>
    <div class="clock-city">
      <span>London</span>
      <strong>17:06</strong>
    </div>
    <div class="clock-city">
      <span>New York</span>
      <strong>12:06</strong>
    </div>
  </div>
)}

{product.visual === "rating" && (
  <div class="rating-visual" aria-label="Douban movie rating assistant preview">
    <div class="movie-panel">
      <span class="movie-title">Movie details</span>
      <div class="score-row">
        <span>Douban</span>
        <strong>8.7</strong>
      </div>
      <div class="score-row imdb">
        <span>IMDb</span>
        <strong>8.4</strong>
      </div>
      <div class="score-row tomato">
        <span>Rotten Tomatoes</span>
        <strong>94%</strong>
      </div>
    </div>
  </div>
)}
