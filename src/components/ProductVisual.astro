---
import type { Product } from "../lib/site";

interface Props {
  product: Product;
}

const { product } = Astro.props;
---

{product.visual === "terminal" && (
  <div class="terminal-visual product-scene inventory-scene" aria-label="s3-turbo-list inventory preview">
    <div class="scene-topbar">
      <div class="window-bar"><span></span><span></span><span></span></div>
      <strong>s3://archive</strong>
      <span>list / diff run</span>
    </div>
    <div class="inventory-layout">
      <div class="scan-map" aria-hidden="true">
        <div class="scan-map-head">
          <span>list key-space</span>
          <strong>64 segments</strong>
        </div>
        <div class="segment-grid">
          <span class="done"></span><span class="done"></span><span class="done"></span><span class="done"></span>
          <span class="done"></span><span class="done"></span><span class="active"></span><span class="done"></span>
          <span class="done"></span><span class="split"></span><span class="done"></span><span class="done"></span>
          <span class="done"></span><span class="done"></span><span></span><span></span>
        </div>
        <div class="scan-progress"><span style="width: 72%"></span></div>
      </div>
      <div class="artifact-stack">
        <div><span>objects.parquet</span><strong>list output</strong></div>
        <div><span>diff.parquet</span><strong>DiffFlag rows</strong></div>
        <div><span>checkpoint.db</span><strong>resume enabled</strong></div>
      </div>
    </div>
    <div class="command-strip">
      <code>s3-turbo-list diff --bucket source --target-bucket target</code>
      <span>DiffFlag != 0</span>
    </div>
  </div>
)}

{product.visual === "diagnostic" && (
  <div class="diagnostic-visual product-scene diagnosis-scene" aria-label="StorageOps diagnostic preview">
    <div class="scene-topbar">
      <div class="window-bar"><span></span><span></span><span></span></div>
      <strong>Pi + StorageOps</strong>
      <span>skills + tools</span>
    </div>
    <div class="diagnosis-board">
      <div class="incident-card">
        <span>agent input</span>
        <strong>s5cmd sync reports 429 SlowDown</strong>
        <p>Pi loads storageops skills and extension tools</p>
      </div>
      <div class="diagnosis-path">
        <div><span>01</span><strong>detect_domain</strong><p>route to performance skill</p></div>
        <div><span>02</span><strong>capture_http_trace</strong><p>sanitized httpmon summary</p></div>
        <div><span>03</span><strong>helper scripts</strong><p>throttling and retry checks</p></div>
      </div>
      <div class="confidence-card">
        <span>loaded</span>
        <strong>15 skills · 4 tools</strong>
        <div><span style="width: 82%"></span></div>
      </div>
    </div>
  </div>
)}

{product.visual === "clock" && (
  <div class="clock-visual product-scene clock-scene" aria-label="World Clock preview">
    <div class="clock-shot-stack">
      <img class="clock-shot light" src="/assets/world-clock-light.png" alt="World Clock light theme timezone feed screenshot" loading="eager" />
      <img class="clock-shot dark" src="/assets/world-clock-dark.png" alt="World Clock dark theme timezone feed screenshot" loading="eager" />
    </div>
  </div>
)}

{product.visual === "rating" && (
  <div class="rating-visual product-scene rating-scene" aria-label="Douban movie rating assistant preview">
    <div class="douban-shot-frame">
      <img src="/assets/douban-rating-assistant.png" alt="Douban Movie Rating Assistant showing IMDb, Rotten Tomatoes, and Metacritic inside a Douban movie page" loading="eager" />
    </div>
  </div>
)}
