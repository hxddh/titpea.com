---
import type { Product } from "../lib/site";
import DoubanRatingVisual from "./visuals/DoubanRatingVisual.astro";
import S3BenchmarkVisual from "./visuals/S3BenchmarkVisual.astro";
import StorageOpsAgentVisual from "./visuals/StorageOpsAgentVisual.astro";
import WorldClockVisual from "./visuals/WorldClockVisual.astro";

interface Props {
  product: Product;
  locale?: "en" | "zh";
}

const { product, locale = "en" } = Astro.props;
---

{product.visual === "terminal" && <S3BenchmarkVisual locale={locale} />}
{product.visual === "diagnostic" && <StorageOpsAgentVisual locale={locale} />}
{product.visual === "clock" && <WorldClockVisual />}
{product.visual === "rating" && <DoubanRatingVisual />}
