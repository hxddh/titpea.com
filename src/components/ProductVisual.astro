---
import type { ProductVisualSpec } from "../content/productPageModel";
import DoubanRatingVisual from "./visuals/DoubanRatingVisual.astro";
import S3BenchmarkVisual from "./visuals/S3BenchmarkVisual.astro";
import StorageOpsAgentVisual from "./visuals/StorageOpsAgentVisual.astro";
import WorldClockVisual from "./visuals/WorldClockVisual.astro";

interface Props {
  visual: ProductVisualSpec;
  locale?: "en" | "zh";
}

const { visual, locale = "en" } = Astro.props;
---

{visual.kind === "s3Benchmark" && <S3BenchmarkVisual locale={locale} />}
{visual.kind === "storageAgent" && <StorageOpsAgentVisual locale={locale} />}
{visual.kind === "worldClockScreenshot" && <WorldClockVisual />}
{visual.kind === "doubanScreenshot" && <DoubanRatingVisual />}
