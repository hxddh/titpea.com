---
import type { ProductVisualModel } from "../content/visualModels";
import DoubanRatingVisual from "./visuals/DoubanRatingVisual.astro";
import S3BenchmarkVisual from "./visuals/S3BenchmarkVisual.astro";
import StorageOpsAgentVisual from "./visuals/StorageOpsAgentVisual.astro";
import StorageWorkbenchVisual from "./visuals/StorageWorkbenchVisual.astro";
import PagewiseWorkbenchVisual from "./visuals/PagewiseWorkbenchVisual.astro";
import AgentRadarTerminalVisual from "./visuals/AgentRadarTerminalVisual.astro";
import HttpmonTerminalVisual from "./visuals/HttpmonTerminalVisual.astro";
import WorldClockVisual from "./visuals/WorldClockVisual.astro";
import AgentWorkbenchScreenshotVisual from "./visuals/AgentWorkbenchScreenshotVisual.astro";
import ProductScreenshotVisual from "./visuals/ProductScreenshotVisual.astro";

interface Props {
  visual: ProductVisualModel;
}

const { visual } = Astro.props;
---

{visual.kind === "s3Benchmark" && <S3BenchmarkVisual visual={visual} />}
{visual.kind === "storageAgent" && <StorageOpsAgentVisual visual={visual} />}
{visual.kind === "storageWorkbench" && <StorageWorkbenchVisual visual={visual} />}
{visual.kind === "pagewiseWorkbench" && <PagewiseWorkbenchVisual visual={visual} />}
{visual.kind === "agentWorkbenchScreenshot" && <AgentWorkbenchScreenshotVisual visual={visual} />}
{visual.kind === "httpmonTerminal" && <HttpmonTerminalVisual visual={visual} />}
{visual.kind === "agentRadarTerminal" && <AgentRadarTerminalVisual visual={visual} />}
{visual.kind === "worldClockScreenshot" && <WorldClockVisual visual={visual} />}
{visual.kind === "doubanScreenshot" && <DoubanRatingVisual visual={visual} />}
{visual.kind === "gobanScreenshot" && <ProductScreenshotVisual visual={visual} />}
{visual.kind === "chessboardScreenshot" && <ProductScreenshotVisual visual={visual} />}
{visual.kind === "easierBookmarksScreenshot" && <ProductScreenshotVisual visual={visual} />}
