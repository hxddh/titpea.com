---
// One row per product: when it touches the network, where its data stays,
// and links to its own "Where your data goes" section and privacy policy.
// Every cell comes from the product file's `privacy` field, which repeats
// only what that product's data section or policy already says.
import SiteLayout from "../layouts/SiteLayout.astro";
import "../styles/privacy.css";
import Prose from "./product/Prose.astro";
import type { PrivacyPageModel } from "../lib/pages";

interface Props {
  model: PrivacyPageModel;
}

const { model } = Astro.props;
const { columns } = model;
---

<SiteLayout seo={model.seo} current={model.current} locale={model.locale} language={model.language}>
  <section class="about-hero privacy-index-hero">
    <div class="wash" aria-hidden="true"></div>
    <div class="shell narrow about-copy">
      <p class="eyebrow">{model.hero.eyebrow}</p>
      <h1>{model.hero.title}</h1>
      <p class="lead">{model.hero.lead}</p>
    </div>
  </section>

  <section class="privacy-index" aria-label={model.hero.title}>
    <div class="shell">
      <table class="privacy-table">
        <thead>
          <tr>
            <th scope="col">{columns.tool}</th>
            <th scope="col">{columns.network}</th>
            <th scope="col">{columns.stays}</th>
            <th scope="col">{columns.details}</th>
          </tr>
        </thead>
        <tbody>
          {model.rows.map((row) => (
            <tr>
              <th scope="row">
                <a class="privacy-tool" href={row.href}>
                  <img src={row.icon} alt="" width="32" height="32" loading="lazy" />
                  <span>{row.name}</span>
                </a>
              </th>
              {row.privacy ? (
                <>
                  <td data-label={columns.network}>
                    <span class="privacy-level" data-level={row.privacy.network}>
                      {row.privacy.level}
                    </span>
                    <span class="privacy-note">
                      <Prose text={row.privacy.networkNote} />
                    </span>
                  </td>
                  <td data-label={columns.stays}>
                    <Prose text={row.privacy.stays} />
                  </td>
                </>
              ) : (
                <td class="privacy-unstated" colspan="2" data-label={columns.network}>
                  {model.unstated}
                </td>
              )}
              <td data-label={columns.details}>
                <ul class="privacy-links">
                  {row.dataHref ? (
                    <li>
                      <a href={row.dataHref}>{model.dataLabel}</a>
                    </li>
                  ) : (
                    <li>
                      <a href={row.href}>{model.productPage}</a>
                    </li>
                  )}
                  {row.privacy?.policy && (
                    <li>
                      <a
                        href={row.privacy.policy.href}
                        rel={/^https?:/.test(row.privacy.policy.href) ? "noreferrer" : undefined}
                      >
                        {row.privacy.policy.label}
                      </a>
                    </li>
                  )}
                </ul>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
      {model.analytics && <p class="privacy-site-note">{model.analytics}</p>}
    </div>
  </section>
</SiteLayout>
