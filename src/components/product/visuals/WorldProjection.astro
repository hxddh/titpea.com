---
import type { Visual } from "../../../content/schema";

interface Props {
  visual: Extract<Visual, { kind: "worldProjection" }>;
}

const { visual } = Astro.props;
---

<div class="world-machine-projection-visual" aria-label={visual.label}>
  <div class="world-machine-projection-bar">
    <span>{visual.kicker}</span>
    <span>{visual.status}</span>
  </div>
  <div class="world-machine-projection-focus">
    <span>{visual.briefingLabel}</span>
    <strong>{visual.briefing}</strong>
    <span>{visual.commandsLabel}</span>
    <ul>
      {visual.commands.map((command) => <li>{command}</li>)}
    </ul>
  </div>
  <div class="world-machine-projection-panels">
    <div>
      <span>{visual.collectionLabel}</span>
      <ul>
        {visual.collection.map((item) => <li>{item}</li>)}
      </ul>
    </div>
    <div>
      <span>{visual.timelineLabel}</span>
      <ul>
        {visual.timeline.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </div>
  <div class="world-machine-projection-foot">
    {visual.footnotes.map((item) => <span>{item}</span>)}
  </div>
</div>
