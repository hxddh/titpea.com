---
import type { Visual } from "../../../content/schema";

interface Props {
  visual: Extract<Visual, { kind: "clockScreenshots" }>;
}

const { visual } = Astro.props;
---

<div class="product-scene clock-scene" aria-label={visual.label}>
  <div class="clock-shot-stack">
    {visual.images.map((image) => (
      <img
        class={image.className}
        src={image.src}
        alt={image.alt}
        width={image.width}
        height={image.height}
        loading="eager"
      />
    ))}
  </div>
</div>
