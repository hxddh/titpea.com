---
import type { Visual } from "../../../content/schema";
import { screenshotSizes, srcsetFor } from "../../../lib/images";

interface Props {
  visual: Extract<Visual, { kind: "screenshot" }>;
}

const { image, caption } = Astro.props.visual;
---

<figure class="product-scene product-screenshot-visual">
  <img
    src={image.src}
    srcset={srcsetFor(image.src, image.width)}
    sizes={screenshotSizes}
    alt={image.alt}
    width={image.width}
    height={image.height}
    fetchpriority="high"
  />
  {caption && <figcaption class="shot-caption">{caption}</figcaption>}
</figure>
