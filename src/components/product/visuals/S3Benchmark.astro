---
import type { Visual } from "../../../content/schema";

interface Props {
  visual: Extract<Visual, { kind: "s3Benchmark" }>;
}

// Two measured runs, two bars from zero: each bar is only its own figure, so
// nothing suggests the times in between that nobody measured.
const { visual } = Astro.props;
const maxSeconds = Math.max(...visual.points.map((point) => point.seconds));
const bars = visual.points.map((point) => ({
  ...point,
  text: point.display ?? `${point.seconds}s`,
  share: ((point.seconds / maxSeconds) * 100).toFixed(1),
}));
---

<div class="terminal-visual benchmark-visual benchmark-report" aria-label={visual.label}>
  <div class="benchmark-head">
    <p class="section-kicker">{visual.kicker}</p>
    <h2>{visual.title}</h2>
    <p>{visual.body}</p>
  </div>
  <figure class="benchmark-bars" aria-labelledby="benchmark-chart-title">
    <figcaption id="benchmark-chart-title">{visual.chartLabel}</figcaption>
    <dl>
      {
        bars.map((bar) => (
          <div class:list={["benchmark-bar", bar.state && `is-${bar.state}`]}>
            <dt>{bar.label}</dt>
            <dd>
              <svg viewBox="0 0 100 10" preserveAspectRatio="none" aria-hidden="true">
                <rect class="benchmark-track" x="0" y="0" width="100" height="10" />
                <rect class="benchmark-fill" x="0" y="0" width={bar.share} height="10" />
              </svg>
              <span>{bar.text}</span>
            </dd>
          </div>
        ))
      }
    </dl>
    <p>{visual.chartCaption}</p>
  </figure>
</div>
