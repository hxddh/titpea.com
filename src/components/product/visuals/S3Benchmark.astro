---
import type { Visual } from "../../../content/schema";

interface Props {
  visual: Extract<Visual, { kind: "s3Benchmark" }>;
}

const { visual } = Astro.props;
const chart = { width: 760, height: 280, left: 42, right: 28, top: 28, bottom: 42 };
const minSeconds = Math.min(...visual.points.map((point) => point.seconds));
const maxSeconds = Math.max(...visual.points.map((point) => point.seconds));
const plotWidth = chart.width - chart.left - chart.right;
const plotHeight = chart.height - chart.top - chart.bottom;
const chartPoints = visual.points.map((point, index) => ({
  ...point,
  x: chart.left + (plotWidth * index) / (visual.points.length - 1),
  y: chart.top + ((maxSeconds - point.seconds) / (maxSeconds - minSeconds)) * plotHeight,
}));
const linePoints = chartPoints.map((point) => `${point.x},${point.y}`).join(" ");
---

<div class="terminal-visual benchmark-visual benchmark-report" aria-label={visual.label}>
  <div class="benchmark-head">
    <p class="section-kicker">{visual.kicker}</p>
    <h2>{visual.title}</h2>
    <p>{visual.body}</p>
    <div class="benchmark-meta">
      {visual.meta.map((item) => <span>{item}</span>)}
    </div>
  </div>
  <figure class="benchmark-line-chart" aria-labelledby="benchmark-chart-title">
    <figcaption id="benchmark-chart-title">{visual.chartLabel}</figcaption>
    <svg viewBox={`0 0 ${chart.width} ${chart.height}`} role="img" aria-label={visual.chartLabel}>
      <line class="chart-axis" x1={chart.left} y1={chart.top} x2={chart.left} y2={chart.height - chart.bottom}></line>
      <line
        class="chart-axis"
        x1={chart.left}
        y1={chart.height - chart.bottom}
        x2={chart.width - chart.right}
        y2={chart.height - chart.bottom}></line>
      <line class="chart-guide" x1={chart.left} y1={chart.top} x2={chart.width - chart.right} y2={chart.top}></line>
      <line
        class="chart-guide"
        x1={chart.left}
        y1={(chart.top + chart.height - chart.bottom) / 2}
        x2={chart.width - chart.right}
        y2={(chart.top + chart.height - chart.bottom) / 2}></line>
      <text class="chart-y-label" x="0" y={chart.top + 4}>{maxSeconds.toFixed(0)}s</text>
      <text class="chart-y-label" x="0" y={chart.height - chart.bottom}>{minSeconds.toFixed(0)}s</text>
      <polyline class="chart-line" points={linePoints}></polyline>
      {
        chartPoints.map((point) => (
          <g class:list={["chart-point", point.state && `is-${point.state}`]}>
            <circle cx={point.x} cy={point.y} r="5" />
            <text class="chart-x-label" x={point.x} y={chart.height - 16} text-anchor="middle">
              {point.label}
            </text>
            {point.state && (
              <text class="chart-annotation" x={point.x} y={point.y - 14} text-anchor="middle">
                {point.seconds}s
              </text>
            )}
          </g>
        ))
      }
    </svg>
    <p>{visual.chartCaption}</p>
  </figure>
</div>
<div class="benchmark-footnotes">
  {visual.footnotes.map((item) => <span>{item}</span>)}
</div>
