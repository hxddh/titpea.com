---
import type { Visual } from "../../../content/schema";

interface Props {
  visual: Extract<Visual, { kind: "menuBar" }>;
  controls: { pause: string; play: string };
}

const { visual, controls } = Astro.props;
// The still (the fields above `scenes`) is what shows without JS and under
// reduced motion; public/scripts/demo-pulse.js steps through the scenes from
// the one that matches it, so the first frame never jumps.
const start = visual.scenes
  ? Math.max(
      0,
      visual.scenes.findIndex(
        (scene) => scene.headerStatus === visual.headerStatus && (scene.glanceTitle ?? "") === visual.glanceTitle,
      ),
    )
  : 0;
const stillLamp = visual.scenes?.[start]?.lamp ?? "waiting";
---

<div
  class:list={["pulse-menubar-visual", visual.scenes && "is-animated"]}
  aria-label={visual.label}
  data-demo-pulse={visual.scenes ? JSON.stringify(visual.scenes) : undefined}
  data-start={visual.scenes ? start : undefined}
>
  <div class="pulse-menubar-bar">
    <span>{visual.menubarLabel}</span>
    <strong class="pulse-menubar-glance">
      <span class={`pulse-lamp pulse-lamp-${stillLamp}`} aria-hidden="true" data-glance-lamp></span>
      <span data-glance-title>{visual.glanceTitle}</span>
    </strong>
  </div>
  {visual.lampSentence && (
    <p class="pulse-tooltip" data-sentence>
      {visual.lampSentence}
    </p>
  )}
  <div class="pulse-menubar-panel">
    <div class="pulse-menubar-header">
      <strong class={`is-${stillLamp}`} data-header>
        {visual.headerStatus}
      </strong>
      {visual.headerAgents ? <span>{visual.headerAgents}</span> : null}
    </div>
    {visual.sections.map((section) => (
      <section class="pulse-menubar-section">
        {section.title ? <p class="pulse-menubar-title">{section.title}</p> : null}
        <ul>
          {section.rows.map((row) => (
            <li class={`pulse-row pulse-row-${row.state}`} data-row>
              <span class={`pulse-lamp pulse-lamp-${row.state}`} aria-hidden="true" data-lamp />
              <div>
                <strong data-title>{row.title}</strong>
                {row.meta && <p data-meta>{row.meta}</p>}
              </div>
              {row.chip ? <em data-chip>{row.chip}</em> : null}
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
  <div class="pulse-menubar-foot">
    {visual.footnotes.map((item) => (
      <span>{item}</span>
    ))}
    {visual.scenes && (
      <button
        class="pulse-toggle"
        type="button"
        data-pulse-toggle
        data-pause-label={controls.pause}
        data-play-label={controls.play}
      >
        {controls.pause}
      </button>
    )}
  </div>
</div>

<script is:inline src="/scripts/demo-pulse.js" defer></script>
