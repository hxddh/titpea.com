---
import { headingText } from "../../lib/heading";
import Prose from "./Prose.astro";
import type { FaqSection } from "../../content/schema";

interface Props {
  section: FaqSection;
}

const { section } = Astro.props;
---

<section id={section.id} class="shell page-section product-section faq-section">
  <header class="section-head">
    <h2 class="heading">{headingText(section.label)}</h2>
  </header>
  <div class="section-body faq-list">
    {/* A disclosure list on hairlines: the first answer open. */}
    {section.items.map((item, index) => (
      <details class="faq-item" open={index === 0}>
        <summary>{item.title}</summary>
        <p class="faq-answer">
          <Prose text={item.body} />
          {item.link && (
            <>
              {" "}
              <a href={item.link.href}>{item.link.label}</a>
            </>
          )}
        </p>
      </details>
    ))}
  </div>
</section>
