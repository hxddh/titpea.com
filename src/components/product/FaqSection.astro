---
import Prose from "./Prose.astro";
import type { FaqSection } from "../../content/schema";

interface Props {
  section: FaqSection;
  /** Two columns, every answer open: the short extension pages. */
  grid?: boolean;
}

const { section, grid = false } = Astro.props;
---

<section id={section.id} class="product-section faq-section">
  <div class:list={["shell", !grid && "narrow"]}>
    <header class="section-head">
      <h2>{section.label}</h2>
    </header>
    <div class="faq-list" data-layout={grid ? "grid" : undefined}>
      {section.items.map((item, index) => (
        <details class="faq-item" open={grid || index === 0}>
          <summary>{item.title}</summary>
          <p class="faq-answer">
            <Prose text={item.body} />
            {item.link && (
              <>
                {" "}
                <a href={item.link.href}>{item.link.label}</a>
              </>
            )}
          </p>
        </details>
      ))}
    </div>
  </div>
</section>
