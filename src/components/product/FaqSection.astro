---
import Prose from "./Prose.astro";
import type { FaqSection } from "../../content/schema";

interface Props {
  section: FaqSection;
}

const { section } = Astro.props;
---

<section id={section.id} class="shell page-section product-section faq-section">
  <div class="cols rule">
    <header class="cols-margin">
      <h2 class="heading">{section.label}</h2>
    </header>
    <div class="cols-main faq-list">
      {/* Every answer is open; phones fold all but the first (faq.js). */}
      {section.items.map((item) => (
        <details class="faq-item" open>
          <summary>{item.title}</summary>
          <p class="faq-answer">
            <Prose text={item.body} />
            {item.link && (
              <>
                {" "}
                <a href={item.link.href}>{item.link.label}</a>
              </>
            )}
          </p>
        </details>
      ))}
    </div>
  </div>
</section>
