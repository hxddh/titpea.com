---
import type { StorySection } from "../../content/schema";

interface Props {
  section: StorySection;
}

const { section } = Astro.props;
---

<section id={section.id} class="product-section product-story">
  <div class="shell narrow">
    <header class="section-head">
      <p class="section-kicker">{section.label}</p>
      <h2>{section.title}</h2>
    </header>
    <div class="prose story-prose">
      {section.body.map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </div>
</section>
