---
import { headingText } from "../../lib/heading";
// Quoted from the release's own notes by scripts/sync-releases.mjs, only in
// the page's language; code spans in the notes (`SlowDown`) render as code.
import type { ProductPageModel } from "../../lib/pages";
import Prose from "./Prose.astro";

interface Props {
  notes: NonNullable<ProductPageModel["whatsNew"]>;
}

const { notes } = Astro.props;
// Nothing quoted in the page's language: the release is one line.
const quoted = Boolean(notes.summary) || notes.items.length > 0;
---

<section
  id="whats-new"
  class="shell page-section product-section whats-new"
  aria-label={quoted ? undefined : notes.title}
>
  <header class="section-head">
    {quoted ? <h2 class="heading">{headingText(notes.title)}</h2> : <p class="fact">{notes.version}</p>}
    {quoted && notes.released && <p class="fact">{notes.released}</p>}
  </header>
  <div class="section-body">
    {quoted ? (
      <>
        {notes.summary && (
          <p class="body-text">
            <Prose text={notes.summary} />
          </p>
        )}
        {notes.items.length > 0 && (
          <ul class="line-list whats-new-list">
            {notes.items.map((item) => (
              <li>
                <Prose text={item} />
              </li>
            ))}
          </ul>
        )}
        <a class="textlink whats-new-link" href={notes.url} rel="noreferrer">
          {notes.linkLabel}
        </a>
      </>
    ) : (
      <p class="whats-new-line">
        {notes.released && <span>{notes.released}</span>}
        <a href={notes.url} rel="noreferrer">
          {notes.linkLabel} ›
        </a>
      </p>
    )}
  </div>
</section>
