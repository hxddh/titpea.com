---
import { headingText } from "../../lib/heading";
import Prose from "./Prose.astro";
import type { Showcase } from "../../content/schema";
import { columnShotSizes, screenshotSizes, srcsetFor } from "../../lib/images";

interface Props {
  showcase: Showcase;
  /** The release the capture was taken at, when it differs from the hero's; else empty. */
  label?: string;
  /** Link text to the whole capture, for a showcase that shows a detail. */
  wholeLabel: string;
  pauseLabel: string;
  playLabel: string;
}

const { showcase, label, wholeLabel, pauseLabel, playLabel } = Astro.props;
// The heading and its line sit in the reading column; the picture lies on the
// product's colour across the whole shell, as the hero's does. A wide window
// capture (3:2 or wider) fills the block; a narrower one keeps product scale;
// a phone capture (taller than wide) stays at phone size. A capture with
// `focus` shows a detail at its own scale.
const portrait = showcase.height > showcase.width;
const detail = Boolean(showcase.focus) && !showcase.video;
const wide = !detail && showcase.width >= showcase.height * 1.5;
const sizes = wide ? screenshotSizes : portrait ? "280px" : columnShotSizes;
---

<section
  class="shell page-section product-section product-screenshot-showcase"
  data-portrait={portrait ? "" : undefined}
  data-wide={wide ? "" : undefined}
>
  <header class="section-head">
    <h2 class="heading">{headingText(showcase.title)}</h2>
    <p class="sub">
      <Prose text={showcase.body} />
    </p>
  </header>
  <figure class="showcase-figure">
    <div class="stage stage-show">
      {showcase.video ? (
        <div class="shot show-shot show-video">
          <video
            muted
            loop
            playsinline
            preload="none"
            poster={showcase.src}
            width={showcase.width}
            height={showcase.height}
            aria-label={showcase.alt}
            data-autoplay
          >
            {/* MP4 first: every browser plays it, and these encodes are the smaller file. */}
            <source src={showcase.video.mp4} type="video/mp4" />
            {showcase.video.webm && <source src={showcase.video.webm} type="video/webm" />}
          </video>
          <button
            class="video-toggle"
            type="button"
            hidden
            data-video-toggle
            data-pause-label={pauseLabel}
            data-play-label={playLabel}
          >
            {pauseLabel}
          </button>
        </div>
      ) : detail ? (
        <div class="crop" data-focus={showcase.focus}>
          {/* No srcset: the detail is the capture at its own pixel size. */}
          <img
            src={showcase.src}
            alt={showcase.alt}
            width={showcase.width}
            height={showcase.height}
            loading="lazy"
            data-appearance={showcase.dark ? "light" : undefined}
          />
          {showcase.dark && (
            <img
              src={showcase.dark.src}
              alt={showcase.alt}
              width={showcase.dark.width}
              height={showcase.dark.height}
              loading="lazy"
              data-appearance="dark"
            />
          )}
        </div>
      ) : (
        <div class="shot show-shot">
          <img
            src={showcase.src}
            srcset={srcsetFor(showcase.src, showcase.width)}
            sizes={sizes}
            alt={showcase.alt}
            width={showcase.width}
            height={showcase.height}
            loading="lazy"
            data-appearance={showcase.dark ? "light" : undefined}
          />
          {showcase.dark && (
            <img
              src={showcase.dark.src}
              srcset={srcsetFor(showcase.dark.src, showcase.dark.width)}
              sizes={sizes}
              alt={showcase.alt}
              width={showcase.dark.width}
              height={showcase.dark.height}
              loading="lazy"
              data-appearance="dark"
            />
          )}
        </div>
      )}
    </div>
    {(label || showcase.caption || detail) && (
      <figcaption class="figure-note">
        {showcase.caption && <span>{showcase.caption}</span>}
        {label && <span class="fact">{label}</span>}
        {detail && (
          <a class="fact" href={showcase.src}>
            {wholeLabel} ›
          </a>
        )}
      </figcaption>
    )}
  </figure>
</section>
