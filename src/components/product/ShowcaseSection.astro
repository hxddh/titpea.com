---
import Prose from "./Prose.astro";
import type { Showcase } from "../../content/schema";
import { screenshotSizes, srcsetFor } from "../../lib/images";

interface Props {
  /** Put the picture on the left (showcases alternate sides). */
  flip?: boolean;
  showcase: Showcase;
  pauseLabel: string;
  playLabel: string;
}

const { showcase, pauseLabel, playLabel, flip = false } = Astro.props;
// The text sits beside the picture on desktop; a phone capture (taller than
// wide) stays at phone size; a wide window capture (3:2 or wider) takes the
// whole frame under its head.
const portrait = showcase.height > showcase.width;
const wide = showcase.width >= showcase.height * 1.5;
---

<section
  class="product-section product-screenshot-showcase"
  data-layout="row"
  data-flip={flip ? "" : undefined}
  data-portrait={portrait ? "" : undefined}
  data-wide={wide ? "" : undefined}
>
  <div class="shell">
    <header class="section-head compact">
      <h2>{showcase.title}</h2>
      <p class="sub">
        <Prose text={showcase.body} />
      </p>
    </header>
    {showcase.video ? (
      <figure class="shot show-shot show-video">
        <video
          muted
          loop
          playsinline
          preload="none"
          poster={showcase.src}
          width={showcase.width}
          height={showcase.height}
          aria-label={showcase.alt}
          data-autoplay
        >
          {/* MP4 first: every browser plays it, and these encodes are the smaller file. */}
          <source src={showcase.video.mp4} type="video/mp4" />
          {showcase.video.webm && <source src={showcase.video.webm} type="video/webm" />}
        </video>
        <button
          class="video-toggle"
          type="button"
          hidden
          data-video-toggle
          data-pause-label={pauseLabel}
          data-play-label={playLabel}
        >
          {pauseLabel}
        </button>
      </figure>
    ) : showcase.caption ? (
      <figure class="show-figure">
        <div class="shot">
          <img
            src={showcase.src}
            srcset={srcsetFor(showcase.src, showcase.width)}
            sizes={screenshotSizes}
            alt={showcase.alt}
            width={showcase.width}
            height={showcase.height}
            loading="lazy"
            data-appearance={showcase.dark ? "light" : undefined}
          />
          {showcase.dark && (
            <img
              src={showcase.dark.src}
              srcset={srcsetFor(showcase.dark.src, showcase.dark.width)}
              sizes={screenshotSizes}
              alt={showcase.alt}
              width={showcase.dark.width}
              height={showcase.dark.height}
              loading="lazy"
              data-appearance="dark"
            />
          )}
        </div>
        <figcaption class="shot-caption">{showcase.caption}</figcaption>
      </figure>
    ) : (
      <figure class="shot show-shot">
        <img
          src={showcase.src}
          srcset={srcsetFor(showcase.src, showcase.width)}
          sizes={screenshotSizes}
          alt={showcase.alt}
          width={showcase.width}
          height={showcase.height}
          loading="lazy"
          data-appearance={showcase.dark ? "light" : undefined}
        />
        {showcase.dark && (
          <img
            src={showcase.dark.src}
            srcset={srcsetFor(showcase.dark.src, showcase.dark.width)}
            sizes={screenshotSizes}
            alt={showcase.alt}
            width={showcase.dark.width}
            height={showcase.dark.height}
            loading="lazy"
            data-appearance="dark"
          />
        )}
      </figure>
    )}
  </div>
</section>
