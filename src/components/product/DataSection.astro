---
import { headingText } from "../../lib/heading";
import Prose from "./Prose.astro";
import type { DataSection } from "../../content/schema";

interface Props {
  section: DataSection;
}

const { section } = Astro.props;
---

<section id={section.id} class="shell page-section product-section data-section">
  <header class="section-head">
    <h2 class="heading">{headingText(section.title)}</h2>
  </header>
  <ul class="section-body data-list">
    {section.items.map((item) => (
      <li>
        <Prose text={item} />
      </li>
    ))}
  </ul>
</section>
