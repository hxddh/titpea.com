---
import { headingText } from "../../lib/heading";
import { ui } from "../../content/site";
import Prose from "./Prose.astro";
import type { DataSection, Locale, PrivacySummary } from "../../content/schema";

interface Props {
  section: DataSection;
  privacy: PrivacySummary;
  locale: Locale;
}

const { section, privacy, locale } = Astro.props;
const copy = ui[locale];
// The data boundary: the network level and where data stays, the same words
// the privacy index uses (the product's `privacy` field), then the details
// the section adds. A detail that repeats a row is left out.
const norm = (text: string) => text.replace(/[\s.。]+$/u, "").trim();
const said = new Set([norm(privacy.networkNote), norm(privacy.stays)]);
const details = section.items.filter((item) => !said.has(norm(item)));
---

<section id={section.id} class="shell page-section product-section data-section">
  <header class="section-head">
    <h2 class="heading">{headingText(section.title)}</h2>
  </header>
  <div class="section-body boundary" role="group" aria-label={copy.boundary.label}>
    <dl class="boundary-rows">
      <div class="boundary-row">
        <dt>{copy.boundary.network}</dt>
        <dd>
          <span class="boundary-level" data-level={privacy.network}>
            {copy.privacyLevels[privacy.network]}
          </span>
          <span class="boundary-text">
            <Prose text={privacy.networkNote} />
          </span>
        </dd>
      </div>
      <div class="boundary-row">
        <dt>{copy.boundary.stays}</dt>
        <dd>
          <span class="boundary-text">
            <Prose text={privacy.stays} />
          </span>
        </dd>
      </div>
    </dl>
    {details.length > 0 && (
      <ul class="boundary-details">
        {details.map((item) => (
          <li>
            <Prose text={item} />
          </li>
        ))}
      </ul>
    )}
    {privacy.policy && (
      <a class="textlink boundary-policy" href={privacy.policy.href}>
        {privacy.policy.label}
      </a>
    )}
  </div>
</section>
