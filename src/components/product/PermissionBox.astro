---
import Prose from "./Prose.astro";
import { ui } from "../../content/site";
import type { Locale, PrivacySummary } from "../../content/schema";

interface Props {
  privacy: PrivacySummary;
  locale: Locale;
  /**
   * The page's data section, when it has one: its facts are listed here and
   * the section itself is not repeated further down.
   */
  facts?: string[];
}

const { privacy, locale, facts } = Astro.props;
const copy = ui[locale];
---

{/* Extension pages: what the extension touches, before anyone installs it. Same facts as the privacy index. */}
<div class="permission-box">
  <dl>
    <div>
      <dt>{copy.privacyColumns.network}</dt>
      <dd>
        <strong data-network={privacy.network}>{copy.privacyLevels[privacy.network]}</strong>
        {!facts && (
          <span>
            <Prose text={privacy.networkNote} />
          </span>
        )}
      </dd>
    </div>
    {facts ? (
      <div>
        <dt>{copy.privacyDataLink}</dt>
        <dd>
          <ul class="permission-facts">
            {facts.map((fact) => (
              <li>
                <Prose text={fact} />
              </li>
            ))}
          </ul>
        </dd>
      </div>
    ) : (
      <div>
        <dt>{copy.privacyColumns.stays}</dt>
        <dd>
          <Prose text={privacy.stays} />
        </dd>
      </div>
    )}
  </dl>
</div>
