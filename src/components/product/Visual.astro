---
import type { Visual } from "../../content/schema";
import ClockScreenshots from "./visuals/ClockScreenshots.astro";
import HttpTerminal from "./visuals/HttpTerminal.astro";
import MenuBar from "./visuals/MenuBar.astro";
import S3Benchmark from "./visuals/S3Benchmark.astro";
import Screenshot from "./visuals/Screenshot.astro";
import SkillMap from "./visuals/SkillMap.astro";
import TerminalBrief from "./visuals/TerminalBrief.astro";

interface Props {
  visual: Visual;
}

const { visual } = Astro.props;
---

{visual.kind === "screenshot" && <Screenshot visual={visual} />}
{visual.kind === "clockScreenshots" && <ClockScreenshots visual={visual} />}
{visual.kind === "s3Benchmark" && <S3Benchmark visual={visual} />}
{visual.kind === "skillMap" && <SkillMap visual={visual} />}
{visual.kind === "httpTerminal" && <HttpTerminal visual={visual} />}
{visual.kind === "terminalBrief" && <TerminalBrief visual={visual} />}
{visual.kind === "menuBar" && <MenuBar visual={visual} />}
