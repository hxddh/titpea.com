---
import type { ProductCopy } from "../../content/schema";

interface Props {
  stats: NonNullable<ProductCopy["stats"]>;
}

const { stats } = Astro.props;
---

<section class="product-section stats-band" aria-labelledby="stats-title">
  <div class="shell">
    <h2 id="stats-title">{stats.title}</h2>
    <dl class="stats" data-count={stats.items.length}>
      {stats.items.map((stat) => (
        <div class="stat">
          <dt>{stat.label}</dt>
          <dd>{stat.value}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>
