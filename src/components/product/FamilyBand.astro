---
import type { Family } from "../../lib/pages";
import "../../styles/family.css";

interface Props {
  family: Family;
}

const { family } = Astro.props;
const titleId = `family-${family.id}-title`;
---

<section class="family-band" aria-labelledby={titleId}>
  <header class="family-head">
    <h2 class="family-title" id={titleId}>
      {family.title}
    </h2>
    <p class="family-sub">{family.sub}</p>
  </header>
  <ol class="family-members">
    {family.members.map((member) => (
      <li class:list={["family-member", { "is-current": member.current }]}>
        {member.current ? (
          <span class="family-link" aria-current="page">
            <img src={member.icon} alt="" width="40" height="40" loading="lazy" />
            <strong>{member.name}</strong>
            <span class="family-role">{member.role}</span>
          </span>
        ) : (
          <a class="family-link" href={member.href}>
            <img src={member.icon} alt="" width="40" height="40" loading="lazy" />
            <strong>{member.name}</strong>
            <span class="family-role">{member.role}</span>
          </a>
        )}
      </li>
    ))}
  </ol>
</section>
