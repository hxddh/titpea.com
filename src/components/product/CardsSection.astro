---
import { headingText } from "../../lib/heading";
import Prose from "./Prose.astro";
import type { CardsSection, Line } from "../../content/schema";

interface Props {
  section: CardsSection;
  line: Line;
}

const { section, line } = Astro.props;
// Tools read as a spec list: the feature on the left, what it does on the
// right, rows on hairlines. Apps and games get a few larger points. Neither
// is a grid to fill: a list holds as many items as the product has.
const layout = section.layout ?? "points";
---

<section id={section.id} class={`shell page-section product-section features-section`}>
  <header class="section-head">
    <h2 class="heading">{headingText(section.label)}</h2>
  </header>
  {layout === "spec" ? (
    <dl class="section-body feature-spec">
      {section.items.map((item) => (
        <div class="feature-spec-row">
          <dt>{item.title}</dt>
          <dd>
            <Prose text={item.body} />
            {item.link && (
              <>
                {" "}
                <a href={item.link.href}>{item.link.label}</a>
              </>
            )}
          </dd>
        </div>
      ))}
    </dl>
  ) : (
    <ul class="feature-points" data-count={section.items.length}>
      {section.items.map((item) => (
        <li>
          <h3>{item.title}</h3>
          <p>
            <Prose text={item.body} />
            {item.link && (
              <>
                {" "}
                <a href={item.link.href}>{item.link.label}</a>
              </>
            )}
          </p>
        </li>
      ))}
    </ul>
  )}
</section>
