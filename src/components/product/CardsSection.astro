---
import Prose from "./Prose.astro";
import type { CardsSection } from "../../content/schema";

interface Props {
  section: CardsSection;
  /** Plain: titled lines on the canvas, no raised card (every template but games). */
  plain?: boolean;
}

const { section, plain = false } = Astro.props;
---

<section id={section.id} class={`product-section content-section ${section.id}-section`}>
  <div class="shell">
    <header class="section-head">
      <h2>{section.label}</h2>
    </header>
    <div
      class={`${section.id}-grid feature-grid`}
      data-count={section.items.length}
      data-variant={plain ? "plain" : undefined}
    >
      {section.items.map((item) => (
        <article class="feature-card">
          <h3>{item.title}</h3>
          <p>
            <Prose text={item.body} />
            {item.link && (
              <>
                {" "}
                <a href={item.link.href}>{item.link.label}</a>
              </>
            )}
          </p>
        </article>
      ))}
    </div>
  </div>
</section>
