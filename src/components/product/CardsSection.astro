---
import Prose from "./Prose.astro";
import type { CardsSection } from "../../content/schema";

interface Props {
  section: CardsSection;
}

const { section } = Astro.props;
---

<section id={section.id} class={`product-section content-section ${section.id}-section`}>
  <div class="shell">
    <header class="section-head">
      <h2>{section.label}</h2>
    </header>
    <div class={`${section.id}-grid feature-grid`} data-count={section.items.length}>
      {section.items.map((item) => (
        <article class="feature-card">
          <h3>{item.title}</h3>
          <p>
            <Prose text={item.body} />
            {item.link && (
              <>
                {" "}
                <a href={item.link.href}>{item.link.label}</a>
              </>
            )}
          </p>
        </article>
      ))}
    </div>
  </div>
</section>
