---
import Prose from "./Prose.astro";
import ReadoutDemo from "./demos/ReadoutDemo.astro";
import ChessPuzzleDemo from "./demos/ChessPuzzleDemo.astro";
import WorldClockDemo from "./demos/WorldClockDemo.astro";
import type { DemoSection } from "../../content/schema";

interface Props {
  section: DemoSection;
  controls: { pause: string; play: string };
}

const { section, controls } = Astro.props;
const { demo } = section;
---

<section id={section.id} class="product-section demo-section">
  <div class="shell">
    <header class="section-head compact">
      <h2>{section.title}</h2>
      <p class="sub"><Prose text={section.body} /></p>
    </header>
    {demo.kind === "worldClock" && <WorldClockDemo demo={demo} caption={section.caption} />}
    {demo.kind === "chessPuzzle" && <ChessPuzzleDemo demo={demo} caption={section.caption} />}
    {demo.kind === "readout" && <ReadoutDemo demo={demo} caption={section.caption} controls={controls} />}
  </div>
</section>
