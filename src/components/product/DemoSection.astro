---
import Prose from "./Prose.astro";
import ChessPuzzleDemo from "./demos/ChessPuzzleDemo.astro";
import type { DemoSection } from "../../content/schema";

interface Props {
  section: DemoSection;
  controls: { pause: string; play: string };
}

const { section } = Astro.props;
const { demo } = section;
---

<section id={section.id} class="shell page-section product-section demo-section">
  <div class="cols">
    <header class="cols-margin">
      <h2 class="heading">{section.title}</h2>
      <p class="sub">
        <Prose text={section.body} />
      </p>
    </header>
    <div class="cols-main">
      {demo.kind === "chessPuzzle" && <ChessPuzzleDemo demo={demo} caption={section.caption} />}
    </div>
  </div>
</section>
