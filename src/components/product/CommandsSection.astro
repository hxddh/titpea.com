---
import CommandReplay from "./CommandReplay.astro";
import Prose from "./Prose.astro";
import type { Commands } from "../../content/schema";

interface Props {
  commands: Commands;
  copyLabel: string;
  copiedLabel: string;
  outputLabel: string;
  controls: { pause: string; play: string };
  /** The command whose replay already plays in the hero; it is not repeated here. */
  replayInHero?: string;
  /** The hero already shows the first command: start from the second. */
  skipFirst?: boolean;
}

const { commands, copyLabel, copiedLabel, outputLabel, controls, replayInHero, skipFirst = false } = Astro.props;
const items = skipFirst ? commands.items.slice(1) : commands.items;
---

<section id="start" class="product-section commands-section">
  <div class="shell narrow">
    <header class="section-head">
      <h2>{commands.title}</h2>
      {commands.sub && (
        <p class="sub">
          <Prose text={commands.sub} />
        </p>
      )}
    </header>
    {items.length > 0 && (
      <ol class="command-list" data-count={items.length}>
        {items.map((item) => (
          <li class="command">
            <p class="command-comment">
              <Prose text={item.comment} />
            </p>
            <div class="command-line">
              <code class="command-code" tabindex="0" set:text={item.command} />
              <button
                class="copy-button"
                type="button"
                data-copy={item.command}
                data-copy-label={copyLabel}
                data-copied-label={copiedLabel}
                hidden
              >
                {copyLabel}
              </button>
            </div>
            {item.capturedOutput && item.replay && item.command !== replayInHero && (
              <CommandReplay
                item={{ ...item, capturedOutput: item.capturedOutput, replay: item.replay }}
                controls={controls}
              />
            )}
            {item.capturedOutput && !item.replay && (
              <details class="command-output">
                <summary>{outputLabel}</summary>
                <pre tabindex="0" set:text={item.capturedOutput} />
              </details>
            )}
          </li>
        ))}
      </ol>
    )}
  </div>
</section>

<script is:inline src="/scripts/copy.js" defer></script>
<script is:inline src="/scripts/demo-replay.js" defer></script>
