---
import Prose from "./Prose.astro";
import type { Commands } from "../../content/schema";

interface Props {
  commands: Commands;
  copyLabel: string;
  copiedLabel: string;
  outputLabel: string;
  controls: { pause: string; play: string };
}

const { commands, copyLabel, copiedLabel, outputLabel, controls } = Astro.props;
---

<section id="start" class="product-section commands-section">
  <div class="shell narrow">
    <header class="section-head">
      <h2>{commands.title}</h2>
      {
        commands.sub && (
          <p class="sub">
            <Prose text={commands.sub} />
          </p>
        )
      }
    </header>
    <ol class="command-list">
      {
        commands.items.map((item) => (
          <li class="command">
            <p class="command-comment">
              <Prose text={item.comment} />
            </p>
            <div class="command-line">
              <code class="command-code" tabindex="0" set:text={item.command} />
              <button
                class="copy-button"
                type="button"
                data-copy={item.command}
                data-copy-label={copyLabel}
                data-copied-label={copiedLabel}
                hidden
              >
                {copyLabel}
              </button>
            </div>
            {item.capturedOutput && item.replay && (
              <figure class="command-replay" data-replay>
                <figcaption class="replay-bar">
                  <span>{item.replay.label}</span>
                  <button
                    class="demo-toggle"
                    type="button"
                    data-replay-toggle
                    data-pause-label={controls.pause}
                    data-play-label={controls.play}
                  >
                    {controls.play}
                  </button>
                </figcaption>
                {/* The command, then its output: demo-replay.js prints them in order; "$ " comes from CSS. */}
                <pre
                  class="replay-screen"
                  tabindex="0"
                  data-replay-screen
                  set:text={`${item.command}\n${item.capturedOutput}`}
                />
              </figure>
            )}
            {item.capturedOutput && !item.replay && (
              <details class="command-output">
                <summary>{outputLabel}</summary>
                <pre tabindex="0" set:text={item.capturedOutput} />
              </details>
            )}
          </li>
        ))
      }
    </ol>
  </div>
</section>

<script is:inline src="/scripts/copy.js" defer></script>
<script is:inline src="/scripts/demo-replay.js" defer></script>
