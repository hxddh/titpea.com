---
import Prose from "./Prose.astro";
import type { FlowSection } from "../../content/schema";

interface Props {
  section: FlowSection;
}

const { section } = Astro.props;
const ordered = section.ordered !== false;
const List = ordered ? "ol" : "ul";
---

<section id={section.id} class="product-section product-deep-dive">
  <div class="shell">
    <header class="section-head">
      <h2>{section.title}</h2>
      <p class="sub">
        <Prose text={section.body} />
      </p>
    </header>
    <List
      class="feature-grid product-flow"
      aria-label={section.title}
      data-count={section.steps.length}
      data-numbered={ordered ? "" : undefined}
    >
      {section.steps.map((step, index) => (
        <li class="feature-card">
          {ordered && <span class="feature-step">{index + 1}</span>}
          <h3>{step.label}</h3>
          <p>
            <Prose text={step.body} />
          </p>
        </li>
      ))}
    </List>
  </div>
</section>
