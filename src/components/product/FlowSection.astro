---
import type { FlowSection } from "../../content/schema";

interface Props {
  section: FlowSection;
}

const { section } = Astro.props;
---

<section id={section.id} class="product-section product-deep-dive">
  <div class="shell">
    <header class="section-head">
      <p class="section-kicker">{section.kicker}</p>
      <h2>{section.title}</h2>
      <p class="sub">{section.body}</p>
    </header>
    <ol class="feature-grid product-flow" aria-label={section.title} data-count={section.steps.length} data-numbered>
      {
        section.steps.map((step, index) => (
          <li class="feature-card">
            <span class="feature-step">{index + 1}</span>
            <h3>{step.label}</h3>
            <p>{step.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
