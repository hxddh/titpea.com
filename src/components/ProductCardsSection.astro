---
import type { ProductSection } from "../content/productSections";

interface Props {
  section: Extract<ProductSection, { kind: "cards" }>;
}

const { section } = Astro.props;
const gridClass = `${section.id}-grid section-card-list`;
const cardClass = section.numbered ? "workflow-step" : `${section.id}-card`;
const surfaceCode = {
  cli: "cli",
  agent: "agent",
  browser: "browser",
  artifact: "output",
  protocol: "protocol",
};
---

<section id={section.id} class={`shell content-section ${section.id}-section`}>
  <p class="section-kicker">{section.label}</p>
  <h2 class="section-heading sr-only">{section.label}</h2>
  <div class={gridClass}>
    {
      section.items.map((item, index) => (
        <article
          class:list={[cardClass, item.priority === "primary" && "primary", item.compact && "compact"]}
          data-intent={item.intent}
          data-surface={item.surface ? surfaceCode[item.surface] : undefined}
        >
          {section.numbered && <span>{String(index + 1).padStart(2, "0")}</span>}
          {item.evidence && <small>{item.evidence}</small>}
          <h3>{item.title}</h3>
          <p>{item.body}</p>
        </article>
      ))
    }
  </div>
</section>
