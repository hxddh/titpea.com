---
import type { ProductSection } from "../content/productSections";
import type { ProductShowcaseFigure } from "../content/visualModels";

interface Props {
  section: Extract<ProductSection, { kind: "cards" }>;
  figure?: ProductShowcaseFigure;
}

const { section, figure } = Astro.props;
const gridClass = `${section.id}-grid feature-grid`;
const surfaceCode = {
  cli: "cli",
  agent: "agent",
  browser: "browser",
  artifact: "output",
  protocol: "protocol",
};
---

<section id={section.id} class={`product-section content-section ${section.id}-section`}>
  <div class="shell">
    <header class="section-head">
      <h2>{section.label}</h2>
    </header>
    <div class={gridClass} data-count={section.items.length} data-numbered={section.numbered ? "" : undefined}>
      {
        section.items.map((item, index) => (
          <article
            class:list={["feature-card", item.priority === "primary" && "primary", item.compact && "compact"]}
            data-intent={item.intent}
            data-surface={item.surface ? surfaceCode[item.surface] : undefined}
          >
            {section.numbered && <span class="feature-step">{index + 1}</span>}
            {item.evidence && <small class="feature-evidence">{item.evidence}</small>}
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </article>
        ))
      }
    </div>
    {
      figure && (
        <figure class="show-figure">
          <div class="shot">
            <img src={figure.src} alt={figure.alt} width={figure.width} height={figure.height} loading="lazy" />
          </div>
          <figcaption class="shot-caption">{figure.body}</figcaption>
        </figure>
      )
    }
  </div>
</section>
