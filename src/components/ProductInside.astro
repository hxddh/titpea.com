---
import type { Locale, Product } from "../lib/site";
import { s3BenchmarkEvidence } from "../content/evidence";

interface Props {
  locale: Locale;
  product: Product;
}

const { locale, product } = Astro.props;
const isZh = locale === "zh";
---

{
  product.role === "inventory" && (
    <section id="inside" class="inside-section shell">
      <div class="inside-copy">
        <p class="section-kicker">{isZh ? "内部视角" : "A look inside"}</p>
        <h2>{isZh ? "默认路径自动完成繁琐部分" : "The default path handles the hard parts"}</h2>
        <p>
          {isZh
            ? "s3-turbo-list 现在更像一个自动化 inventory / diff 工具：启动发现、运行时拆分、dry-run plan、run manifest 和 artifact 校验都在默认路径里。"
            : "s3-turbo-list now behaves more like an automated inventory and diff tool: startup discovery, runtime splitting, dry-run plans, run manifests, and artifact checks sit on the default path."}
        </p>
      </div>
      <div class="inside-workbench inventory-workbench" aria-label="s3-turbo-list run workbench">
        <div class="workbench-top">
          <span>s3-turbo-list {s3BenchmarkEvidence.version}</span>
          <strong>{isZh ? "automatic inventory path" : "automatic inventory path"}</strong>
        </div>
        <div class="inventory-grid benchmark-metrics">
          <div class="metric-tile strong">
            <>
              <span>{isZh ? "自动发现" : "startup discovery"}</span>
              <strong>{isZh ? "零 hints" : "zero hints"}</strong>
              <p>{isZh ? "第一次递归 list 就能并发" : "first recursive list can run in parallel"}</p>
            </>
          </div>
          <div class="metric-tile">
            <>
              <span>{isZh ? "OSS benchmark" : "OSS benchmark"}</span>
              <strong>~19s</strong>
              <p>{isZh ? "1M 对象，-c 8" : "1M objects at -c 8"}</p>
            </>
          </div>
          <div class="metric-tile">
            <>
              <span>{isZh ? "协议" : "license"}</span>
              <strong>Apache-2.0</strong>
              <p>{isZh ? "v0.18.0 起" : "from v0.18.0 onward"}</p>
            </>
          </div>
        </div>
        <div class="artifact-table benchmark-table" aria-label="Automation surfaces">
          <div>
            <>
              <span>{isZh ? "preflight" : "preflight"}</span>
              <strong>doctor --json · --dry-run --agent · --plan-json</strong>
            </>
          </div>
          <div>
            <>
              <span>{isZh ? "artifacts" : "artifacts"}</span>
              <strong>Parquet · key-space CSV · run manifest · trace JSONL</strong>
            </>
          </div>
          <div>
            <>
              <span>{isZh ? "verify" : "verify"}</span>
              <strong>manifest-summary --check · hashes · row counts · schema</strong>
            </>
          </div>
          <div>
            <>
              <span>{isZh ? "provider logs" : "provider logs"}</span>
              <strong>app/s3-turbo-list User-Agent · compat-probe</strong>
            </>
          </div>
        </div>
      </div>
    </section>
  )
}

{
  product.role === "diagnosis" && (
    <section id="inside" class="inside-section shell">
      <div class="inside-copy">
        <p class="section-kicker">{isZh ? "内部视角" : "A look inside"}</p>
        <h2>{isZh ? "让 Pi 会诊断对象存储问题" : "Turn Pi into a storage diagnosis agent"}</h2>
        <p>
          {isZh
            ? "StorageOps 不是一组排查说明，而是一套给 Pi 安装的能力：对象存储诊断技能、扩展工具、确定性脚本和回归用例。"
            : "StorageOps is not just a guide. It installs object-storage skills, Pi extension tools, helper scripts, and eval cases so Pi can diagnose S3-compatible failures."}
        </p>
      </div>
      <div class="inside-workbench agent-evidence-panel" aria-label="StorageOps skills and tools summary">
        <div class="workbench-top">
          <span>pi extension: storageops</span>
          <strong>{isZh ? "skills + tools loaded" : "skills + tools loaded"}</strong>
        </div>
        <div class="agent-evidence-grid">
          <div>
            <>
              <span>01</span>
              <strong>{isZh ? "15 个诊断技能" : "15 diagnostic skills"}</strong>
              <p>
                {isZh
                  ? "按鉴权、签名、限流、一致性、迁移、日志等对象存储领域组织。"
                  : "Organized around auth, signing, throttling, consistency, migration, logs, and other storage domains."}
              </p>
            </>
          </div>
          <div>
            <>
              <span>02</span>
              <strong>{isZh ? "4 个 Pi 工具" : "4 Pi tools"}</strong>
              <p>
                {isZh
                  ? "detect_domain、scan_secrets、search_memory、capture_http_trace 负责路由和取证。"
                  : "detect_domain, scan_secrets, search_memory, and capture_http_trace route and gather evidence."}
              </p>
            </>
          </div>
          <div>
            <>
              <span>03</span>
              <strong>{isZh ? "确定性脚本" : "deterministic helpers"}</strong>
              <p>
                {isZh
                  ? "检查 SigV4、ETag、payload hash、限流、访问日志和 endpoint 可达性。"
                  : "Inspect SigV4, ETags, payload hashes, throttling, access logs, and endpoint reachability."}
              </p>
            </>
          </div>
          <div>
            <>
              <span>04</span>
              <strong>{isZh ? "回归用例" : "eval cases"}</strong>
              <p>
                {isZh
                  ? "用 golden cases 约束 agent 行为，避免每次修改后诊断口径漂移。"
                  : "Golden cases keep agent behavior stable as skills and tools change."}
              </p>
            </>
          </div>
        </div>
      </div>
    </section>
  )
}

{
  product.role === "time" && (
    <section id="inside" class="inside-section shell">
      <div class="inside-copy">
        <p class="section-kicker">{isZh ? "内部视角" : "A look inside"}</p>
        <h2>{isZh ? "查时间应该很短" : "Time, checked quickly"}</h2>
        <p>
          {isZh
            ? "世界时钟不是排期系统。它是一个快速上下文工具：打开弹窗，看一眼城市时间、工作时段和日期，然后回到当前任务。"
            : "World Clock is not a scheduling system. It is a compact context tool: open it, glance at city time, and return to the task."}
        </p>
      </div>
    </section>
  )
}

{
  product.role === "ratings" && (
    <section id="inside" class="inside-section shell">
      <div class="inside-copy">
        <p class="section-kicker">{isZh ? "内部视角" : "A look inside"}</p>
        <h2>{isZh ? "不离开豆瓣，对照评分" : "Ratings without leaving Douban"}</h2>
        <p>
          {isZh
            ? "豆瓣电影评分助手只做补充上下文：匹配到影片时，把 IMDb、Rotten Tomatoes 和 Metacritic 放进豆瓣详情页，原来的阅读节奏不变。"
            : "The extension adds context rather than replacing Douban: when a reliable match exists, IMDb, Rotten Tomatoes, and Metacritic appear in the page you are already reading."}
        </p>
      </div>
    </section>
  )
}
