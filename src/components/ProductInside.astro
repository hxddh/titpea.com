---
import type { Locale, Product } from "../lib/site";

interface Props {
  locale: Locale;
  product: Product;
}

const { locale, product } = Astro.props;
const isZh = locale === "zh";
---

{product.role === "inventory" && (
  <section id="inside" class="inside-section shell">
    <div class="inside-copy">
      <p class="section-kicker">{isZh ? "内部视角" : "A look inside"}</p>
      <h2>{isZh ? "list、diff，然后分析。" : "List, diff, then analyze."}</h2>
      <p>{isZh ? "s3-turbo-list 的核心是一个高性能对象存储 CLI：并发 list 大桶，权威 diff 两个桶，并把结果写成后续工具能直接查询的 Parquet。" : "s3-turbo-list is a high-performance object storage CLI: list large buckets concurrently, diff two buckets authoritatively, then hand clean Parquet to the tools that analyze the result."}</p>
    </div>
    <div class="inside-workbench inventory-workbench" aria-label="s3-turbo-list run workbench">
      <div class="workbench-top">
        <span>mode: list / diff</span>
        <strong>parquet ready</strong>
      </div>
      <div class="inventory-grid">
        <div class="metric-tile strong">
          <span>{isZh ? "list" : "list"}</span>
          <strong>64</strong>
          <p>{isZh ? "并发 key-space segments" : "concurrent key-space segments"}</p>
        </div>
        <div class="metric-tile">
          <span>{isZh ? "diff" : "diff"}</span>
          <strong>DiffFlag</strong>
          <p>{isZh ? "标记相同、独有和变更对象" : "marks equal, only, and changed rows"}</p>
        </div>
        <div class="metric-tile">
          <span>{isZh ? "trace" : "trace"}</span>
          <strong>JSONL</strong>
          <p>{isZh ? "每次 S3 API 调用可回放" : "each S3 API call remains inspectable"}</p>
        </div>
      </div>
      <div class="artifact-table" aria-label="Run artifacts">
        <div><span>objects.parquet</span><strong>{isZh ? "list 模式：对象 Key、Size、LastModified、ETag" : "list mode: Key, Size, LastModified, ETag"}</strong></div>
        <div><span>diff.parquet</span><strong>{isZh ? "diff 模式：每行带 DiffFlag" : "diff mode: every row carries DiffFlag"}</strong></div>
        <div><span>checkpoint.db</span><strong>{isZh ? "中断后继续，不重扫已完成分段" : "resume without rescanning completed segments"}</strong></div>
        <div><span>trace.jsonl</span><strong>{isZh ? "provider 行为有证据可查" : "provider behavior has evidence"}</strong></div>
      </div>
    </div>
  </section>
)}

{product.role === "diagnosis" && (
  <section id="inside" class="inside-section shell">
    <div class="inside-copy">
      <p class="section-kicker">{isZh ? "内部视角" : "A look inside"}</p>
      <h2>{isZh ? "给 Pi 补上存储诊断能力。" : "Turn Pi into a storage diagnosis agent."}</h2>
      <p>{isZh ? "StorageOps 的主体不是一组说明文档，而是给 Pi 安装的对象存储 skills、extension tools、helper scripts 和 eval cases。" : "StorageOps is not just a guide. It installs object-storage skills, Pi extension tools, helper scripts, and eval cases so Pi can diagnose S3-compatible failures."}</p>
    </div>
    <div class="inside-workbench diagnosis-workbench" aria-label="StorageOps diagnosis workbench">
      <div class="workbench-top">
        <span>pi extension: storageops</span>
        <strong>{isZh ? "skills + tools loaded" : "skills + tools loaded"}</strong>
      </div>
      <div class="diagnosis-timeline">
        <div>
          <span>01</span>
          <strong>{isZh ? "Skills" : "Skills"}</strong>
          <p>{isZh ? "15 个对象存储诊断领域" : "15 object-storage diagnosis domains"}</p>
        </div>
        <div>
          <span>02</span>
          <strong>{isZh ? "Tools" : "Tools"}</strong>
          <p>{isZh ? "scan_secrets、detect_domain、search_memory、capture_http_trace" : "scan_secrets, detect_domain, search_memory, capture_http_trace"}</p>
        </div>
        <div>
          <span>03</span>
          <strong>{isZh ? "Helpers" : "Helpers"}</strong>
          <p>{isZh ? "SigV4、ETag、payload hash、access log、migration scripts" : "SigV4, ETag, payload hash, access log, migration scripts"}</p>
        </div>
      </div>
      <div class="diagnosis-result">
        <span>{isZh ? "agent 输出" : "agent output"}</span>
        <p>{isZh ? "基于 skills 和 tool output 的故障领域、证据、置信度、下一步检查和安全修改建议。" : "Domain, evidence, confidence, next checks, and safe changes grounded in skills and tool output."}</p>
      </div>
    </div>
  </section>
)}

{product.role === "time" && (
  <section id="inside" class="inside-section shell">
    <div class="inside-copy">
      <p class="section-kicker">{isZh ? "内部视角" : "A look inside"}</p>
      <h2>{isZh ? "查时间应该很短。" : "Time, checked quickly."}</h2>
      <p>{isZh ? "世界时钟页面要强调它不是排期系统，而是一个快速上下文工具：打开、看一眼、回到当前任务。" : "World Clock is not a scheduling system. It is a compact context tool: open it, glance at city time, and return to the task."}</p>
    </div>
  </section>
)}

{product.role === "ratings" && (
  <section id="inside" class="inside-section shell">
    <div class="inside-copy">
      <p class="section-kicker">{isZh ? "内部视角" : "A look inside"}</p>
      <h2>{isZh ? "不离开豆瓣，对照评分。" : "Ratings without leaving Douban."}</h2>
      <p>{isZh ? "豆瓣电影评分助手的页面重点应该是“补充上下文”而不是替代豆瓣：匹配到时显示 IMDb 和 Rotten Tomatoes，并保留原页面阅读节奏。" : "The extension adds context rather than replacing Douban: when a reliable match exists, IMDb and Rotten Tomatoes appear in the page you are already reading."}</p>
    </div>
  </section>
)}
