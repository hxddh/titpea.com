---
import type { ProductInsideModel } from "../content/productPageTypes";

interface Props {
  section: ProductInsideModel;
}

const { section } = Astro.props;
---

<section id={section.id} class="product-section inside-section">
  <div class="shell">
    <header class="section-head">
      <p class="section-kicker">{section.kicker}</p>
      <h2>{section.title}</h2>
      <p class="sub">{section.body}</p>
    </header>
    {
      section.panel?.kind === "s3Purpose" && (
        <div class="s3-purpose-panel" aria-label={section.panel.label}>
          <div class="feature-grid s3-purpose-grid" data-count={section.panel.items.length}>
            {section.panel.items.map((item) => (
              <article class="feature-card">
                <small class="feature-evidence">{item.label}</small>
                <h3>{item.title}</h3>
                <p>{item.body}</p>
              </article>
            ))}
          </div>
          <p class="s3-purpose-boundary">
            <strong>{section.panel.boundaryLabel}</strong>
            <span>{section.panel.boundary}</span>
          </p>
        </div>
      )
    }
    {
      section.panel?.kind === "agentEvidence" && (
        <div class="panel agent-evidence-panel" aria-label={section.panel.label}>
          <div class="panel-top">
            <span>{section.panel.eyebrow}</span>
            <strong>{section.panel.title}</strong>
          </div>
          <div class="feature-grid agent-evidence-grid" data-count={section.panel.metrics.length}>
            {section.panel.metrics.map((metric) => (
              <article class="feature-card">
                <small class="feature-evidence">{metric.label}</small>
                <h3>{metric.value}</h3>
                <p>{metric.body}</p>
              </article>
            ))}
          </div>
        </div>
      )
    }
  </div>
</section>
