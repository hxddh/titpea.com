---
import SiteLayout from "../layouts/SiteLayout.astro";
import ProductCardsSection from "./ProductCardsSection.astro";
import ProductCasesSection from "./ProductCasesSection.astro";
import ProductFaqSection from "./ProductFaqSection.astro";
import ProductInside from "./ProductInside.astro";
import ProductStorySection from "./ProductStorySection.astro";
import ProductVisual from "./ProductVisual.astro";
import { productSections } from "../content/productSections";
import type { Locale, Product } from "../lib/site";

interface Props {
  locale: Locale;
  product: Product;
}

const { locale, product } = Astro.props;
const copy = product.locales[locale];
const sections = productSections(locale, copy, product);
const navLabel = (id: string, label: string) => {
  const labels = {
    en: {
      inside: "Overview",
      positioning: "Fit",
      features: "Capabilities",
      workflow: "Flow",
      automation: "Automation",
      cases: "Compatibility",
      faq: "FAQ",
      story: "Details",
      examples: "Examples",
    },
    zh: {
      inside: "概览",
      positioning: "定位",
      features: "能力",
      workflow: "流程",
      automation: "自动化",
      cases: "兼容性",
      faq: "FAQ",
      story: "细节",
      examples: "示例",
    },
  } as const;

  return labels[locale][id as keyof (typeof labels)["en"]] ?? label;
};
const navItems = [
  ["inside", navLabel("inside", "Inside")],
  ...sections.map((section) => [section.id, navLabel(section.id, section.label)]),
];
const showSectionIndex = product.category === "storage";
const socialImage =
  product.visual === "clock"
    ? "/assets/world-clock-dark.png"
    : product.visual === "rating"
      ? "/assets/douban-rating-assistant.png"
      : "/favicon.svg";
const structuredData = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: copy.title,
  description: copy.description,
  applicationCategory: product.category === "browser" ? "BrowserApplication" : "DeveloperApplication",
  operatingSystem: product.category === "browser" ? "Chrome" : "Cross-platform",
  url: `https://titpea.com${locale === "zh" ? `/zh/${product.slug}/` : `/${product.slug}/`}`,
  sameAs: copy.primaryCta.href,
};
---

<SiteLayout
  title={copy.title}
  description={copy.description}
  current={product.current}
  locale={locale}
  image={socialImage}
  structuredData={structuredData}
>
  <section class="product-hero product-launch-hero shell">
    <div class="product-copy">
      <p class="eyebrow">{copy.eyebrow}</p>
      <h1>{copy.headline}</h1>
      <p class="lead">{copy.lead}</p>
      <div class="actions">
        <a class="button primary" href={copy.primaryCta.href} rel="noreferrer">{copy.primaryCta.label}</a>
        <a class="button ghost" href={copy.secondaryCta.href} rel="noreferrer">{copy.secondaryCta.label}</a>
      </div>
      <p class="meta-line">{copy.meta}</p>
    </div>
    <div class="hero-visual-frame">
      <ProductVisual product={product} locale={locale} />
    </div>
  </section>

  <section class="proof-strip shell" aria-label="Product evidence">
    {copy.proof.map((item) => <span>{item}</span>)}
  </section>

  {
    showSectionIndex && (
      <nav
        class="product-section-index shell"
        aria-label={locale === "zh" ? "页面目录" : "Page index"}
        data-section-index
      >
        <span>{locale === "zh" ? "阅读路径" : "Read this page"}</span>
        <div>
          {navItems.map(([id, label]) => (
            <a href={`#${id}`}>{label}</a>
          ))}
        </div>
      </nav>
    )
  }

  <script>
    const sectionIndexes = document.querySelectorAll<HTMLElement>("[data-section-index]");

    sectionIndexes.forEach((index) => {
      const links = Array.from(index.querySelectorAll<HTMLAnchorElement>('a[href^="#"]'));
      const sections = links
        .map((link) => {
          const id = decodeURIComponent(link.hash.slice(1));
          return { id, link, section: document.getElementById(id) };
        })
        .filter((item): item is { id: string; link: HTMLAnchorElement; section: HTMLElement } => Boolean(item.section));

      const setActive = (id: string) => {
        sections.forEach((item) => {
          if (item.id === id) {
            item.link.setAttribute("aria-current", "true");
          } else {
            item.link.removeAttribute("aria-current");
          }
        });
      };

      setActive(sections[0]?.id ?? "");

      const observer = new IntersectionObserver(
        (entries) => {
          const visible = entries
            .filter((entry) => entry.isIntersecting)
            .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)[0];

          if (visible?.target.id) setActive(visible.target.id);
        },
        {
          rootMargin: "-18% 0px -68% 0px",
          threshold: [0, 0.1, 0.35],
        },
      );

      sections.forEach((item) => observer.observe(item.section));
    });
  </script>

  <ProductInside locale={locale} product={product} />

  {
    sections.map((section) => {
      if (section.kind === "story") {
        return <ProductStorySection section={section} />;
      }

      if (section.kind === "cases") {
        return <ProductCasesSection section={section} />;
      }

      if (section.kind === "faq") {
        return <ProductFaqSection section={section} />;
      }

      return <ProductCardsSection section={section} />;
    })
  }

  {
    copy.finalCta && (
      <section class="shell final-cta">
        <h2>{copy.finalCta}</h2>
        <a class="button primary" href={copy.primaryCta.href} rel="noreferrer">
          {copy.finalCtaLabel ?? copy.primaryCta.label}
        </a>
      </section>
    )
  }
</SiteLayout>
