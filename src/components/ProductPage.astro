---
import SiteLayout from "../layouts/SiteLayout.astro";
import ProductInside from "./ProductInside.astro";
import ProductVisual from "./ProductVisual.astro";
import { productSections } from "../content/productSections";
import type { Locale, Product } from "../lib/site";

interface Props {
  locale: Locale;
  product: Product;
}

const { locale, product } = Astro.props;
const copy = product.locales[locale];
const sections = productSections(locale, copy);
const navItems = [
  ["inside", locale === "zh" ? "内部视角" : "Inside"],
  ...sections.map((section) => [section.id, section.label]),
];
---

<SiteLayout title={copy.title} description={copy.description} current={product.current} locale={locale}>
  <section class="product-hero product-launch-hero shell">
    <div class="product-copy">
      <p class="eyebrow">{copy.eyebrow}</p>
      <h1>{copy.headline}</h1>
      <p class="lead">{copy.lead}</p>
      <div class="actions">
        <a class="button primary" href={copy.primaryCta.href} rel="noreferrer">{copy.primaryCta.label}</a>
        <a class="button ghost" href={copy.secondaryCta.href} rel="noreferrer">{copy.secondaryCta.label}</a>
      </div>
      <p class="meta-line">{copy.meta}</p>
    </div>
    <div class="hero-visual-frame">
      <ProductVisual product={product} locale={locale} />
    </div>
  </section>

  <section class="proof-strip shell" aria-label="Product evidence">
    {copy.proof.map((item) => <span>{item}</span>)}
  </section>

  <nav class="product-anchor-nav shell" aria-label={locale === "zh" ? "页面导航" : "Page navigation"}>
    {navItems.map(([id, label]) => <a href={`#${id}`}>{label}</a>)}
  </nav>

  <ProductInside locale={locale} product={product} />

  {
    sections.map((section) => {
      if (section.kind === "story") {
        return (
          <section id={section.id} class="band product-story">
            <div class="shell split-content">
              <div>
                <p class="section-kicker">{section.label}</p>
                <h2>{section.title}</h2>
              </div>
              <div class="prose">
                {section.body.map((paragraph) => (
                  <p>{paragraph}</p>
                ))}
              </div>
            </div>
          </section>
        );
      }

      if (section.kind === "cases") {
        return (
          <section id={section.id} class="band">
            <div class="shell split-content">
              <div>
                <p class="section-kicker">{section.label}</p>
                <h2>{section.title}</h2>
              </div>
              <div>
                <div class="provider-list" aria-label={section.label}>
                  {section.items.map((item) => (
                    <span>{item}</span>
                  ))}
                </div>
                {section.body && <p class="prose">{section.body}</p>}
              </div>
            </div>
          </section>
        );
      }

      if (section.kind === "faq") {
        return (
          <section id={section.id} class="shell content-section faq-section">
            <p class="section-kicker">{section.label}</p>
            <div class="faq-list">
              {section.items.map(([question, answer]) => (
                <details>
                  <summary>{question}</summary>
                  <p>{answer}</p>
                </details>
              ))}
            </div>
          </section>
        );
      }

      return (
        <section id={section.id} class={`shell content-section ${section.id}-section`}>
          <p class="section-kicker">{section.label}</p>
          <div class={`${section.id}-grid`}>
            {section.items.map(([title, body], index) => (
              <article class={section.numbered ? "workflow-step" : `${section.id}-card`}>
                {section.numbered && <span>{String(index + 1).padStart(2, "0")}</span>}
                <h2>{title}</h2>
                <p>{body}</p>
              </article>
            ))}
          </div>
        </section>
      );
    })
  }

  {
    copy.finalCta && (
      <section class="shell final-cta">
        <h2>{copy.finalCta}</h2>
        <a class="button primary" href={copy.primaryCta.href} rel="noreferrer">
          {copy.finalCtaLabel ?? copy.primaryCta.label}
        </a>
      </section>
    )
  }
</SiteLayout>
