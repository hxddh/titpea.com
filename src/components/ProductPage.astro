---
import SiteLayout from "../layouts/SiteLayout.astro";
import { ui } from "../content/site";
import { products } from "../content/products";
import { templateOf } from "../content/schema";
import type { ProductPageModel } from "../lib/pages";
import CardsSection from "./product/CardsSection.astro";
import CasesSection from "./product/CasesSection.astro";
import CommandReplay from "./product/CommandReplay.astro";
import CommandsSection from "./product/CommandsSection.astro";
import DataSection from "./product/DataSection.astro";
import DemoSection from "./product/DemoSection.astro";
import FamilyBand from "./product/FamilyBand.astro";
import FaqSection from "./product/FaqSection.astro";
import FlowSection from "./product/FlowSection.astro";
import LocalNav from "./product/LocalNav.astro";
import PanelSection from "./product/PanelSection.astro";
import PermissionBox from "./product/PermissionBox.astro";
import Prose from "./product/Prose.astro";
import ShowcaseSection from "./product/ShowcaseSection.astro";
import StatsBand from "./product/StatsBand.astro";
import Visual from "./product/Visual.astro";
import WhatsNewSection from "./product/WhatsNewSection.astro";

interface Props {
  model: ProductPageModel;
}

const { model } = Astro.props;
const { copy } = model;
const copyUi = ui[model.locale];
const showcases = copy.showcases ?? [];
const opening = showcases.filter((figure) => !figure.beside);
const besideSection = (id: string) => showcases.find((figure) => figure.beside === id);
const hasFaq = copy.sections.some((section) => section.kind === "faq");
// A live demo opens the page, right after the hero and stats, before any photograph.
const demos = copy.sections.flatMap((section) => (section.kind === "demo" ? [section] : []));
// Every page closes on its main action, under the same label as the hero.
const closing = copy.primaryCta.label;
// The version in the meta line carries its release date: "v1.17.3 (Sep 4, 2026)",
// or only the date when the download button already shows the version.
const metaParts = copy.meta.split(" · ");
const releasedNote = model.released ? copyUi.released.replace("{date}", model.released) : "";
// One body composition per kind of product (DESIGN.md, "Templates").
const product = products.find((entry) => entry.slug === model.slug)!;
const template = templateOf(product.type);
// Tools and extensions put the claim beside the object; apps and games keep the centered stack.
const split = template === "tool" || template === "extension";
// Tools: the first command sits under the lead, ready to copy; a captured replay takes the hero's right side.
const heroCommand = template === "tool" ? copy.commands?.items[0] : undefined;
const heroReplay =
  template === "tool"
    ? copy.commands?.items.find((item): item is typeof item & { capturedOutput: string; replay: { label: string } } =>
        Boolean(item.capturedOutput && item.replay),
      )
    : undefined;
// The hero already shows the first command; Get started goes on from the next one,
// unless that first command carries output the hero does not play.
const skipFirstCommand = Boolean(
  heroCommand && (!heroCommand.capturedOutput || heroCommand.command === heroReplay?.command),
);
const bodyCommands = (copy.commands?.items.length ?? 0) - (skipFirstCommand ? 1 : 0);
const commandSteps = template === "tool" && bodyCommands >= 2;
const plainCards = template !== "game";
const showcaseRows = template === "app" || template === "extension";
const dataSection = copy.sections.find((section) => section.kind === "data");
// Extensions: the hero box carries the data section's facts, so the section is not repeated.
const permissionBox = template === "extension" && copy.privacy ? copy.privacy : undefined;
const commandsProps = {
  copyLabel: copyUi.copy,
  copiedLabel: copyUi.copied,
  outputLabel: copyUi.commandOutput,
  controls: { pause: copyUi.pauseVideo, play: copyUi.playVideo },
  steps: commandSteps,
  replayInHero: heroReplay?.command,
  skipFirst: skipFirstCommand,
};
---

<SiteLayout
  seo={model.seo}
  current={model.current}
  locale={model.locale}
  language={model.language}
  localNav
  product={{ slug: model.slug, line: model.line }}
>
  <LocalNav
    label={copy.title}
    icon={model.icon}
    items={model.sectionIndex ? model.navItems : []}
    locale={model.locale}
    cta={copy.primaryCta}
  />

  <section
    class="product-hero"
    data-frame={model.frame}
    data-template={template}
    data-layout={split ? "split" : undefined}
  >
    <div class="wash" aria-hidden="true"></div>
    <div class:list={[split && "shell hero-split"]}>
      <div class:list={["product-copy", !split && "shell"]}>
        <img class="app-icon" src={model.icon} alt="" width="104" height="104" />
        <p class="eyebrow">
          <strong class="eyebrow-name">{copy.title}</strong> · {copy.eyebrow}
        </p>
        <h1>{copy.headline}</h1>
        <p class="lead">{copy.lead}</p>
        {heroCommand && (
          <div class="hero-command command-line">
            <code class="command-code" tabindex="0" set:text={heroCommand.command} />
            <button
              class="copy-button"
              type="button"
              data-copy={heroCommand.command}
              data-copy-label={copyUi.copy}
              data-copied-label={copyUi.copied}
              hidden
            >
              {copyUi.copy}
            </button>
          </div>
        )}
        <div class="actions">
          {copy.primaryCta.soon ? (
            <span class="button primary large is-soon" aria-disabled="true">
              {copy.primaryCta.label}
            </span>
          ) : (
            <a class="button primary large" href={copy.primaryCta.href} rel="noreferrer">
              {copy.primaryCta.label}
              {model.downloadsRelease && <span class="button-version">{model.version}</span>}
            </a>
          )}
          <a class="button ghost" href={copy.secondaryCta.href} rel="noreferrer">
            {copy.secondaryCta.label}
          </a>
        </div>
        {copy.installNote && (
          <p class="install-note">
            <Prose text={copy.installNote} />
          </p>
        )}
        <p class="meta-line">
          {metaParts.map((part) =>
            // The download button already names the version; the meta line then gives only its date.
            part === model.version && model.downloadsRelease && model.released ? (
              <span>{model.released}</span>
            ) : part === model.version ? (
              <span>
                <span class="meta-tag">{part}</span>
                {releasedNote}
              </span>
            ) : (
              <span>{part}</span>
            ),
          )}
        </p>
        {permissionBox && (
          <PermissionBox
            privacy={permissionBox}
            locale={model.locale}
            facts={dataSection?.kind === "data" ? dataSection.items : undefined}
          />
        )}
      </div>
      <div class:list={["hero-visual-frame", !split && "shell"]}>
        {heroReplay ? (
          <CommandReplay item={heroReplay} controls={{ pause: copyUi.pauseVideo, play: copyUi.playVideo }} />
        ) : (
          <Visual visual={copy.visual} controls={{ pause: copyUi.pauseVideo, play: copyUi.playVideo }} />
        )}
      </div>
    </div>
  </section>

  {heroReplay && (
    <section class="product-section hero-visual-section">
      <div class="shell hero-visual-frame">
        <Visual visual={copy.visual} controls={{ pause: copyUi.pauseVideo, play: copyUi.playVideo }} />
      </div>
    </section>
  )}

  {copy.stats && <StatsBand stats={copy.stats} />}

  {demos.map((section) => (
    <DemoSection section={section} controls={{ pause: copyUi.pauseVideo, play: copyUi.playVideo }} />
  ))}

  {opening.map((showcase) => (
    <ShowcaseSection
      showcase={showcase}
      pauseLabel={copyUi.pauseVideo}
      playLabel={copyUi.playVideo}
      row={showcaseRows}
      flip={opening.indexOf(showcase) % 2 === 1}
    />
  ))}

  {copy.sections.map((section) => {
    const start =
      section.kind === "faq" ? (
        <>
          {model.whatsNew && <WhatsNewSection notes={model.whatsNew} />}
          {copy.commands && <CommandsSection commands={copy.commands} {...commandsProps} />}
        </>
      ) : null;
    if (section.kind === "cards")
      return <CardsSection section={section} figure={besideSection(section.id)} plain={plainCards} />;
    if (section.kind === "faq")
      return (
        <>
          {start}
          <FaqSection section={section} grid={template === "extension"} />
        </>
      );
    if (section.kind === "cases") return <CasesSection section={section} />;
    if (section.kind === "flow") return <FlowSection section={section} />;
    if (section.kind === "data") return permissionBox ? null : <DataSection section={section} />;
    if (section.kind === "demo") return null;
    return <PanelSection section={section} />;
  })}

  {!hasFaq && model.whatsNew && <WhatsNewSection notes={model.whatsNew} />}

  {copy.commands && !hasFaq && <CommandsSection commands={copy.commands} {...commandsProps} />}

  {/* One closing block: the main action once more, then where to go next (the family, or related tools). */}
  <section class="shell final-cta" aria-label={closing}>
    <img class="final-cta-icon" src={model.icon} alt="" width="64" height="64" />
    <p class="final-cta-name">{copy.title}</p>
    <div class="actions">
      {copy.primaryCta.soon ? (
        <span class="button primary large is-soon" aria-disabled="true">
          {closing}
        </span>
      ) : (
        <a class="button primary large" href={copy.primaryCta.href} rel="noreferrer">
          {closing}
          {model.downloadsRelease && <span class="button-version">{model.version}</span>}
        </a>
      )}
      <a class="button ghost" href={copy.secondaryCta.href} rel="noreferrer">
        {copy.secondaryCta.label}
      </a>
    </div>
    <div class="closing-next">
      {model.family ? (
        <FamilyBand family={model.family} />
      ) : (
        <nav class="product-related" aria-labelledby="related-title">
          <h2 id="related-title" class="product-related-title">
            {model.related.title}
          </h2>
          <ul class="product-related-list">
            {model.related.items.map((item) => (
              <li>
                <a href={item.href}>
                  <img src={item.icon} alt="" width="40" height="40" />
                  <span>{item.name}</span>
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )}
      <a class="closing-all" href={model.related.all.href}>
        {model.related.all.label}
      </a>
    </div>
  </section>
  <Fragment slot="scripts">
    <script is:inline src="/scripts/zoom.js" defer></script>
    <script is:inline src="/scripts/video.js" defer></script>
    <script is:inline src="/scripts/faq.js" defer></script>
  </Fragment>
</SiteLayout>
