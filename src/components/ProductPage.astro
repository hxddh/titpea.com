---
import SiteLayout from "../layouts/SiteLayout.astro";
import { ui } from "../content/site";
import type { ProductPageModel } from "../lib/pages";
import CardsSection from "./product/CardsSection.astro";
import CasesSection from "./product/CasesSection.astro";
import CommandsSection from "./product/CommandsSection.astro";
import DataSection from "./product/DataSection.astro";
import DemoSection from "./product/DemoSection.astro";
import FaqSection from "./product/FaqSection.astro";
import FlowSection from "./product/FlowSection.astro";
import LocalNav from "./product/LocalNav.astro";
import PanelSection from "./product/PanelSection.astro";
import ShowcaseSection from "./product/ShowcaseSection.astro";
import StatsBand from "./product/StatsBand.astro";
import Visual from "./product/Visual.astro";
import WhatsNewSection from "./product/WhatsNewSection.astro";

interface Props {
  model: ProductPageModel;
}

const { model } = Astro.props;
const { copy } = model;
const copyUi = ui[model.locale];
const showcases = copy.showcases ?? [];
const opening = showcases.filter((figure) => !figure.beside);
const besideSection = (id: string) => showcases.find((figure) => figure.beside === id);
const hasFaq = copy.sections.some((section) => section.kind === "faq");
// A live demo opens the page, right after the hero and stats, before any photograph.
const demos = copy.sections.flatMap((section) => (section.kind === "demo" ? [section] : []));
// Every page closes on its main action, under the same label as the hero.
const closing = copy.primaryCta.label;
// The version in the meta line carries its release date: "v1.17.3 (Sep 4, 2026)",
// or only the date when the download button already shows the version.
const metaParts = copy.meta.split(" · ");
const releasedNote = model.released ? copyUi.released.replace("{date}", model.released) : "";
---

<SiteLayout
  seo={model.seo}
  current={model.current}
  locale={model.locale}
  language={model.language}
  localNav
  product={{ slug: model.slug, line: model.line }}
>
  <LocalNav
    label={copy.title}
    icon={model.icon}
    items={model.sectionIndex ? model.navItems : []}
    locale={model.locale}
    cta={copy.primaryCta}
  />

  <section class="product-hero" data-frame={model.frame}>
    <div class="wash" aria-hidden="true"></div>
    <div class="shell product-copy">
      <img class="app-icon" src={model.icon} alt="" width="104" height="104" />
      <p class="eyebrow"><strong class="eyebrow-name">{copy.title}</strong> · {copy.eyebrow}</p>
      <h1>{copy.headline}</h1>
      <p class="lead">{copy.lead}</p>
      <div class="actions">
        {
          copy.primaryCta.soon ? (
            <span class="button primary large is-soon" aria-disabled="true">
              {copy.primaryCta.label}
            </span>
          ) : (
            <a class="button primary large" href={copy.primaryCta.href} rel="noreferrer">
              {copy.primaryCta.label}
              {model.downloadsRelease && <span class="button-version">{model.version}</span>}
            </a>
          )
        }
        <a class="button ghost" href={copy.secondaryCta.href} rel="noreferrer">{copy.secondaryCta.label}</a>
      </div>
      <p class="meta-line">
        {
          metaParts.map((part) =>
            // The download button already names the version; the meta line then gives only its date.
            part === model.version && model.downloadsRelease && model.released ? (
              <span>{model.released}</span>
            ) : part === model.version ? (
              <span>
                <span class="meta-tag">{part}</span>
                {releasedNote}
              </span>
            ) : (
              <span>{part}</span>
            ),
          )
        }
      </p>
    </div>
    <div class="shell hero-visual-frame">
      <Visual visual={copy.visual} />
    </div>
  </section>

  {copy.stats && <StatsBand stats={copy.stats} />}

  {demos.map((section) => <DemoSection section={section} />)}

  {
    opening.map((showcase) => (
      <ShowcaseSection showcase={showcase} pauseLabel={copyUi.pauseVideo} playLabel={copyUi.playVideo} />
    ))
  }

  {
    copy.sections.map((section) => {
      const start =
        section.kind === "faq" ? (
          <>
            {model.whatsNew && <WhatsNewSection notes={model.whatsNew} />}
            {copy.commands && (
              <CommandsSection
                commands={copy.commands}
                copyLabel={copyUi.copy}
                copiedLabel={copyUi.copied}
                outputLabel={copyUi.commandOutput}
              />
            )}
          </>
        ) : null;
      if (section.kind === "cards") return <CardsSection section={section} figure={besideSection(section.id)} />;
      if (section.kind === "faq")
        return (
          <>
            {start}
            <FaqSection section={section} />
          </>
        );
      if (section.kind === "cases") return <CasesSection section={section} />;
      if (section.kind === "flow") return <FlowSection section={section} />;
      if (section.kind === "data") return <DataSection section={section} />;
      if (section.kind === "demo") return null;
      return <PanelSection section={section} />;
    })
  }

  {!hasFaq && model.whatsNew && <WhatsNewSection notes={model.whatsNew} />}

  {
    copy.commands && !hasFaq && (
      <CommandsSection
        commands={copy.commands}
        copyLabel={copyUi.copy}
        copiedLabel={copyUi.copied}
        outputLabel={copyUi.commandOutput}
      />
    )
  }

  <section class="shell final-cta" aria-label={closing}>
    <img class="final-cta-icon" src={model.icon} alt="" width="64" height="64" />
    <p class="final-cta-name">{copy.title}</p>
    <div class="actions">
      {
        copy.primaryCta.soon ? (
          <span class="button primary large is-soon" aria-disabled="true">
            {closing}
          </span>
        ) : (
          <a class="button primary large" href={copy.primaryCta.href} rel="noreferrer">
            {closing}
            {model.downloadsRelease && <span class="button-version">{model.version}</span>}
          </a>
        )
      }
      <a class="button ghost" href={copy.secondaryCta.href} rel="noreferrer">{copy.secondaryCta.label}</a>
    </div>
  </section>

  <nav class="shell product-related" aria-labelledby="related-title">
    <h2 id="related-title" class="product-related-title">{model.related.title}</h2>
    <ul class="product-related-list">
      {
        model.related.items.map((item) => (
          <li>
            <a href={item.href}>
              <img src={item.icon} alt="" width="40" height="40" />
              <span>{item.name}</span>
            </a>
          </li>
        ))
      }
    </ul>
    <a class="button ghost" href={model.related.all.href}>{model.related.all.label}</a>
  </nav>
  <Fragment slot="scripts">
    <script is:inline src="/scripts/zoom.js" defer></script>
    <script is:inline src="/scripts/video.js" defer></script>
  </Fragment>
</SiteLayout>
