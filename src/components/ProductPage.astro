---
import SiteLayout from "../layouts/SiteLayout.astro";
import ProductCardsSection from "./ProductCardsSection.astro";
import ProductCasesSection from "./ProductCasesSection.astro";
import ProductDeepDive from "./ProductDeepDive.astro";
import ProductFaqSection from "./ProductFaqSection.astro";
import ProductInside from "./ProductInside.astro";
import ProductResults from "./ProductResults.astro";
import ProductSectionIndex from "./ProductSectionIndex.astro";
import ProductStorySection from "./ProductStorySection.astro";
import ProductVisual from "./ProductVisual.astro";
import ProductScreenshotShowcase from "./ProductScreenshotShowcase.astro";
import type { ProductPageModel } from "../content/siteModel";

interface Props {
  model: ProductPageModel;
}

const { model } = Astro.props;
const copy = model.copy;

// MOCKUP ONLY (iteration review, not for merge): live-release line.
// Real implementation would fetch GitHub latest releases at build time.
const isZhPage = model.locale === "zh";
const mockRelease: Record<string, { version: string; age: string; href: string }> = isZhPage
  ? {
      "storage-agent-workbench": {
        version: "v1.17.3",
        age: "12 天前发布",
        href: "https://github.com/hxddh/storage-agent-workbench/releases",
      },
      pagewise: { version: "v12.0.0", age: "5 天前发布", href: "https://github.com/hxddh/pagewise/releases" },
      pulse: { version: "v11.0.3", age: "26 天前发布", href: "https://github.com/hxddh/Pulse/releases/latest" },
    }
  : {
      "storage-agent-workbench": {
        version: "v1.17.3",
        age: "released 12 days ago",
        href: "https://github.com/hxddh/storage-agent-workbench/releases",
      },
      pagewise: { version: "v12.0.0", age: "released 5 days ago", href: "https://github.com/hxddh/pagewise/releases" },
      pulse: { version: "v11.0.3", age: "released 26 days ago", href: "https://github.com/hxddh/Pulse/releases/latest" },
    };
const release = mockRelease[model.slug];
const releaseNotesLabel = isZhPage ? "更新说明" : "Release notes";
---

<SiteLayout
  seo={model.seo}
  current={model.current}
  locale={model.locale}
  language={model.language}
  pageClass={model.pageClass}
>
  <section class:list={["product-hero shell", model.pageClass]} data-visual-kind={model.visual.kind}>
    <div class="product-copy">
      <p class="eyebrow"><strong class="eyebrow-name">{copy.title}</strong> · {copy.eyebrow}</p>
      <h1>{copy.headline}</h1>
      <p class="lead">{copy.lead}</p>
      <div class="actions">
        <a class="button primary" href={copy.primaryCta.href} rel="noreferrer">{copy.primaryCta.label}</a>
        <a class="button ghost" href={copy.secondaryCta.href} rel="noreferrer">{copy.secondaryCta.label}</a>
      </div>
      <p class="meta-line">{copy.meta.split(" · ").map((part) => <span>{part}</span>)}</p>
      {
        release && (
          <p class="meta-line release-line">
            <span class="release-version">{release.version}</span>
            <span>{release.age}</span>
            <a class="release-notes-link" href={release.href} rel="noreferrer">
              {releaseNotesLabel} →
            </a>
          </p>
        )
      }
    </div>
    <div class="hero-visual-frame">
      <ProductVisual visual={model.visual} />
    </div>
  </section>

  {
    copy.proof.length > 0 && (
      <section class="proof-strip shell" aria-label="Product evidence">
        {copy.proof.map((item) => (
          <span>{item}</span>
        ))}
      </section>
    )
  }

  {model.showcases.map((figure) => <ProductScreenshotShowcase supporting={figure} />)}

  {model.sectionIndex && <ProductSectionIndex label={model.indexLabel} items={model.navItems} locale={model.locale} />}

  {
    model.sections.map((section) => {
      if (section.kind === "inside") {
        return <ProductInside section={section} />;
      }

      if (section.kind === "evidence") {
        return <ProductDeepDive section={section} />;
      }

      if (section.kind === "results") {
        return <ProductResults section={section} />;
      }

      if (section.kind === "story") {
        return <ProductStorySection section={section} />;
      }

      if (section.kind === "cases") {
        return <ProductCasesSection section={section} />;
      }

      if (section.kind === "faq") {
        return <ProductFaqSection section={section} />;
      }

      return <ProductCardsSection section={section} />;
    })
  }

  {
    copy.finalCtaLabel && (
      <section class="shell final-cta" aria-label={copy.finalCtaLabel}>
        <a class="button primary" href={copy.primaryCta.href} rel="noreferrer">
          {copy.finalCtaLabel}
        </a>
      </section>
    )
  }
</SiteLayout>
