---
import SiteLayout from "../layouts/SiteLayout.astro";
import "../styles/visuals.css";
import "../styles/demo.css";
import "../styles/product.css";
import { ui } from "../content/site";
import { products } from "../content/products";
import { templateOf } from "../content/schema";
import { screenshotSizes, srcsetFor } from "../lib/images";
import type { ProductPageModel } from "../lib/pages";
import CardsSection from "./product/CardsSection.astro";
import CommandReplay from "./product/CommandReplay.astro";
import CommandsSection from "./product/CommandsSection.astro";
import DataSection from "./product/DataSection.astro";
import DemoSection from "./product/DemoSection.astro";
import FaqSection from "./product/FaqSection.astro";
import LocalNav from "./product/LocalNav.astro";
import Prose from "./product/Prose.astro";
import ShowcaseSection from "./product/ShowcaseSection.astro";
import Visual from "./product/Visual.astro";
import WhatsNewSection from "./product/WhatsNewSection.astro";
import { demoStyles } from "./product/demo-styles";

interface Props {
  model: ProductPageModel;
}

const { model } = Astro.props;
const { copy } = model;
const copyUi = ui[model.locale];
// After the hero the product is shown up to three more times (DESIGN.md,
// "Product Pages"): at most one live demo, then showcase photographs.
const showcases = copy.showcases ?? [];
const demos = copy.sections.flatMap((section) => (section.kind === "demo" ? [section] : []));
// Every page closes on its main action, under the same label as the hero.
const closing = copy.primaryCta.label;
const product = products.find((entry) => entry.slug === model.slug)!;
const template = templateOf(product.type);
// One skeleton for every kind of product (DESIGN.md, "Product Pages"). The
// template picks only what the hero carries: a tool's first command sits
// under the lede, and a captured replay is its hero object.
const heroCommand = template === "tool" ? copy.commands?.items[0] : undefined;
const heroReplay =
  template === "tool"
    ? copy.commands?.items.find((item): item is typeof item & { capturedOutput: string; replay: { label: string } } =>
        Boolean(item.capturedOutput && item.replay),
      )
    : undefined;
// The hero already shows the first command; Get started goes on from the next one,
// unless that first command carries output the hero does not play.
const skipFirstCommand = Boolean(
  heroCommand && (!heroCommand.capturedOutput || heroCommand.command === heroReplay?.command),
);
const controls = { pause: copyUi.pauseVideo, play: copyUi.playVideo };
const commandsProps = {
  copyLabel: copyUi.copy,
  copiedLabel: copyUi.copied,
  outputLabel: copyUi.commandOutput,
  controls,
  replayInHero: heroReplay?.command,
  skipFirst: skipFirstCommand,
};
// The spec sheet (DESIGN.md, "Spec sheet"): what the meta line says, a
// segment a row, then the facts the site knows by name. The version and its
// date come from releases.json, so the meta line's own version segment is
// left out when the release gives one.
const isVersion = (part: string) => part === model.version || /^v?\d+(\.\d+)+$/.test(part);
const isLicense = (part: string) => /^(MIT|Apache-|GPL|LGPL|AGPL|BSD|MPL|ISC)/.test(part);
const metaParts = copy.meta.split(" · ");
const license = metaParts.find(isLicense);
const metaVersion = metaParts.find(isVersion);
const specs: Array<{ label?: string; value: string; href?: string }> = [
  ...metaParts.filter((part) => !isVersion(part) && !isLicense(part)).map((value) => ({ value })),
  ...(license ? [{ label: copyUi.spec.license, value: license }] : []),
  ...(model.version || metaVersion ? [{ label: copyUi.spec.version, value: (model.version ?? metaVersion)! }] : []),
  ...(model.released ? [{ label: copyUi.spec.released, value: model.released }] : []),
  ...(copy.privacy ? [{ label: copyUi.spec.network, value: copyUi.privacyLevels[copy.privacy.network] }] : []),
  ...(product.repo
    ? [{ label: copyUi.spec.source, value: product.repo, href: `https://github.com/${product.repo}` }]
    : []),
];
// Figures are numbered down the page; each says the release it was captured at.
const figureLabel = (n: number, asOf?: string) =>
  (asOf ? copyUi.figureAsOf : copyUi.figure).replace("{n}", String(n)).replace("{version}", asOf ?? "");
const screenshot = copy.visual.kind === "screenshot" && !heroReplay ? copy.visual : undefined;
const firstShowcaseFigure = 2;
---

<SiteLayout
  seo={model.seo}
  current={model.current}
  locale={model.locale}
  language={model.language}
  localNav
  product={{ slug: model.slug, line: model.line }}
  styles={demoStyles(copy)}
>
  <LocalNav
    label={copy.title}
    icon={model.icon}
    items={model.sectionIndex ? model.navItems : []}
    locale={model.locale}
    cta={copy.primaryCta}
  />

  <section class="shell product-hero" data-template={template}>
    <p class="ident eyebrow">
      <img class="app-icon" src={model.icon} alt="" width="80" height="80" />
      <strong class="eyebrow-name">{copy.title}</strong>
      <span>{copy.eyebrow}</span>
    </p>
    <h1 class="display">{copy.headline}</h1>
    <div class="cols rule">
      <dl class="cols-margin specs">
        {specs.map((spec) => (
          <div data-plain={spec.label ? undefined : ""}>
            {spec.label && <dt>{spec.label}</dt>}
            <dd>
              {spec.href ? (
                <a href={spec.href} rel="noreferrer">
                  {spec.value}
                </a>
              ) : (
                spec.value
              )}
            </dd>
          </div>
        ))}
      </dl>
      <div class="cols-main product-copy">
        <p class="lead">{copy.lead}</p>
        {heroCommand && (
          <div class="hero-command command-line">
            <code class="command-code" tabindex="0" set:text={heroCommand.command} />
            <button
              class="copy-button"
              type="button"
              data-copy={heroCommand.command}
              data-copy-label={copyUi.copy}
              data-copied-label={copyUi.copied}
              hidden
            >
              {copyUi.copy}
            </button>
          </div>
        )}
        <div class="actions">
          {copy.primaryCta.soon ? (
            <span class="button primary large is-soon" aria-disabled="true">
              {copy.primaryCta.label}
            </span>
          ) : (
            <a class="button primary large" href={copy.primaryCta.href} rel="noreferrer">
              {copy.primaryCta.label}
              {model.downloadsRelease && <span class="button-version">{model.version}</span>}
            </a>
          )}
          <a class="textlink" href={copy.secondaryCta.href} rel="noreferrer">
            {copy.secondaryCta.label}
          </a>
        </div>
        {copy.installNote && (
          <p class="install-note">
            <Prose text={copy.installNote} />
          </p>
        )}
      </div>
    </div>
  </section>

  <section class="shell hero-figure">
    {screenshot ? (
      <figure class="product-scene product-screenshot-visual">
        <div class="stage stage-hero" data-portrait={screenshot.image.height > screenshot.image.width ? "" : undefined}>
          <img
            src={screenshot.image.src}
            srcset={srcsetFor(screenshot.image.src, screenshot.image.width)}
            sizes={screenshot.image.height > screenshot.image.width ? "380px" : screenshotSizes}
            alt={screenshot.image.alt}
            width={screenshot.image.width}
            height={screenshot.image.height}
            fetchpriority="high"
          />
        </div>
        <figcaption class="figure-note">
          <span class="fact">{figureLabel(1, screenshot.asOf)}</span>
          {screenshot.caption && <span>{screenshot.caption}</span>}
        </figcaption>
      </figure>
    ) : (
      <div class="stage stage-hero" data-plain>
        <div class="hero-visual-frame">
          {heroReplay ? (
            <CommandReplay item={heroReplay} controls={controls} />
          ) : (
            <Visual visual={copy.visual} controls={controls} />
          )}
        </div>
      </div>
    )}
  </section>

  {/* A captured replay takes the hero; the product's own object follows it. */}
  {heroReplay && (
    <section class="shell page-section product-section hero-visual-section">
      <div class="stage stage-hero" data-plain>
        <div class="hero-visual-frame">
          <Visual visual={copy.visual} controls={controls} />
        </div>
      </div>
    </section>
  )}

  {demos.map((section) => (
    <DemoSection section={section} controls={controls} />
  ))}

  {showcases.map((showcase, index) => (
    <ShowcaseSection
      showcase={showcase}
      label={figureLabel(index + firstShowcaseFigure, showcase.asOf)}
      wholeLabel={copyUi.wholeCapture}
      pauseLabel={copyUi.pauseVideo}
      playLabel={copyUi.playVideo}
    />
  ))}

  {/* What it does; then what's new and Get started; then where the data goes and the FAQ. */}
  {copy.sections.map((section) => (section.kind === "cards" ? <CardsSection section={section} /> : null))}

  {model.whatsNew && <WhatsNewSection notes={model.whatsNew} />}

  {copy.commands && <CommandsSection commands={copy.commands} {...commandsProps} />}

  {copy.sections.map((section) =>
    section.kind === "data" ? (
      <DataSection section={section} />
    ) : section.kind === "faq" ? (
      <FaqSection section={section} />
    ) : null,
  )}

  {/* The closing: where to go next in the margin (the family, or related tools), the main action once more. */}
  <section class="shell page-section page-end final-cta" aria-label={closing}>
    <div class="cols rule">
      <nav class="cols-margin closing-next" aria-labelledby="related-title">
        <h2 id="related-title" class="closing-label product-related-title">
          {model.family ? model.family.title : model.related.title}
        </h2>
        <ul class="tool-links">
          {model.family
            ? model.family.members.map((member) => (
                <li>
                  {member.current ? (
                    <span class="tool-link" aria-current="page">
                      <img class="icon-plate" src={member.icon} alt="" width="28" height="28" loading="lazy" />
                      <span>{member.name}</span>
                      <small>{member.role}</small>
                    </span>
                  ) : (
                    <a href={member.href}>
                      <img class="icon-plate" src={member.icon} alt="" width="28" height="28" loading="lazy" />
                      <span>{member.name}</span>
                      <small>{member.role}</small>
                    </a>
                  )}
                </li>
              ))
            : model.related.items.map((item) => (
                <li>
                  <a href={item.href}>
                    <img class="icon-plate" src={item.icon} alt="" width="28" height="28" loading="lazy" />
                    <span>{item.name}</span>
                  </a>
                </li>
              ))}
        </ul>
        <a class="textlink closing-all" href={model.related.all.href}>
          {model.related.all.label}
        </a>
      </nav>
      <div class="cols-main">
        <p class="final-cta-name">{copy.title}</p>
        <div class="actions">
          {copy.primaryCta.soon ? (
            <span class="button primary large is-soon" aria-disabled="true">
              {closing}
            </span>
          ) : (
            <a class="button primary large" href={copy.primaryCta.href} rel="noreferrer">
              {closing}
              {model.downloadsRelease && <span class="button-version">{model.version}</span>}
            </a>
          )}
          <a class="textlink" href={copy.secondaryCta.href} rel="noreferrer">
            {copy.secondaryCta.label}
          </a>
        </div>
      </div>
    </div>
  </section>
  <Fragment slot="scripts">
    <script is:inline src="/scripts/zoom.js" defer></script>
    <script is:inline src="/scripts/video.js" defer></script>
    <script is:inline src="/scripts/faq.js" defer></script>
  </Fragment>
</SiteLayout>
