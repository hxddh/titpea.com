---
import SiteLayout from "../layouts/SiteLayout.astro";
import ProductInside from "./ProductInside.astro";
import ProductVisual from "./ProductVisual.astro";
import type { Locale, Product } from "../lib/site";

interface Props {
  locale: Locale;
  product: Product;
}

const { locale, product } = Astro.props;
const copy = product.locales[locale];
const navItems = [
  ["inside", locale === "zh" ? "内部视角" : "Inside"],
  ["positioning", copy.positioningLabel],
  ["features", copy.featuresLabel],
  copy.workflow && copy.workflowLabel ? ["workflow", copy.workflowLabel] : null,
  copy.cases && copy.casesLabel ? ["cases", copy.casesLabel] : null,
  copy.faq && copy.faqLabel ? ["faq", copy.faqLabel] : null,
].filter(Boolean) as Array<[string, string]>;
---

<SiteLayout
  title={copy.title}
  description={copy.description}
  current={product.current}
  locale={locale}
>
  <section class="product-hero product-launch-hero shell">
    <div class="product-copy">
      <p class="eyebrow">{copy.eyebrow}</p>
      <h1>{copy.headline}</h1>
      <p class="lead">{copy.lead}</p>
      <div class="actions">
        <a class="button primary" href={copy.primaryCta.href} rel="noreferrer">{copy.primaryCta.label}</a>
        <a class="button ghost" href={copy.secondaryCta.href} rel="noreferrer">{copy.secondaryCta.label}</a>
      </div>
      <p class="meta-line">{copy.meta}</p>
    </div>
    <div class="hero-visual-frame">
      <ProductVisual product={product} locale={locale} />
    </div>
  </section>

  <section class="proof-strip shell" aria-label="Product evidence">
    {copy.proof.map((item) => <span>{item}</span>)}
  </section>

  <nav class="product-anchor-nav shell" aria-label={locale === "zh" ? "页面导航" : "Page navigation"}>
    {navItems.map(([id, label]) => <a href={`#${id}`}>{label}</a>)}
  </nav>

  <ProductInside locale={locale} product={product} />

  <section id="positioning" class="shell positioning-section">
    <p class="section-kicker">{copy.positioningLabel}</p>
    <div class="positioning-grid">
      {copy.positioning.map(([title, body]) => (
        <article class="positioning-card">
          <h2>{title}</h2>
          <p>{body}</p>
        </article>
      ))}
    </div>
  </section>

  <section id="features" class="shell content-section">
    <p class="section-kicker">{copy.featuresLabel}</p>
    <div class="feature-grid">
      {copy.features.map(([title, body]) => (
        <article class="feature">
          <h2>{title}</h2>
          <p>{body}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="band product-story">
    <div class="shell split-content">
      <div>
        <p class="section-kicker">{copy.rationaleLabel}</p>
        <h2>{copy.rationaleTitle}</h2>
      </div>
      <div class="prose">
        {copy.rationaleBody.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </div>
  </section>

  {copy.workflow && copy.workflowLabel && (
    <section id="workflow" class="shell content-section">
      <p class="section-kicker">{copy.workflowLabel}</p>
      <div class="workflow-grid">
        {copy.workflow.map(([title, body], index) => (
          <article class="workflow-step">
            <span>{String(index + 1).padStart(2, "0")}</span>
            <h2>{title}</h2>
            <p>{body}</p>
          </article>
        ))}
      </div>
    </section>
  )}

  {copy.cases && copy.casesLabel && copy.casesTitle && (
    <section id="cases" class="band">
      <div class="shell split-content">
        <div>
          <p class="section-kicker">{copy.casesLabel}</p>
          <h2>{copy.casesTitle}</h2>
        </div>
        <div>
          <div class="provider-list" aria-label={copy.casesLabel}>
            {copy.cases.map((item) => <span>{item}</span>)}
          </div>
          {copy.casesBody && <p class="prose">{copy.casesBody}</p>}
        </div>
      </div>
    </section>
  )}

  {copy.faq && copy.faqLabel && (
    <section id="faq" class="shell content-section faq-section">
      <p class="section-kicker">{copy.faqLabel}</p>
      <div class="faq-list">
        {copy.faq.map(([question, answer]) => (
          <details>
            <summary>{question}</summary>
            <p>{answer}</p>
          </details>
        ))}
      </div>
    </section>
  )}

  {copy.finalCta && (
    <section class="shell final-cta">
      <h2>{copy.finalCta}</h2>
      <a class="button primary" href={copy.primaryCta.href} rel="noreferrer">{copy.finalCtaLabel ?? copy.primaryCta.label}</a>
    </section>
  )}
</SiteLayout>
