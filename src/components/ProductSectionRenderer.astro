---
import ProductCardsSection from "./ProductCardsSection.astro";
import ProductCasesSection from "./ProductCasesSection.astro";
import ProductDeepDive from "./ProductDeepDive.astro";
import ProductFaqSection from "./ProductFaqSection.astro";
import ProductInside from "./ProductInside.astro";
import ProductResults from "./ProductResults.astro";
import ProductStorySection from "./ProductStorySection.astro";
import type { ProductPageSection } from "../content/productPageTypes";

interface Props {
  section: ProductPageSection;
}

const { section } = Astro.props;
---

{section.kind === "inside" && <ProductInside section={section} />}
{section.kind === "evidence" && <ProductDeepDive section={section} />}
{section.kind === "results" && <ProductResults section={section} />}
{section.kind === "story" && <ProductStorySection section={section} />}
{section.kind === "cases" && <ProductCasesSection section={section} />}
{section.kind === "faq" && <ProductFaqSection section={section} />}
{section.kind === "cards" && <ProductCardsSection section={section} />}
