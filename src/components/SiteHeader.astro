---
import { ui } from "../content/site";
import type { Locale } from "../content/schema";
import { navGroups, pathFor, type CurrentPage } from "../lib/pages";

interface Props {
  current: CurrentPage;
  locale: Locale;
  alternateHref: string;
  alternateLabel: string;
  alternateLocale: Locale;
  /** Product pages pin their own local nav, so the site header scrolls away. */
  scrollsAway?: boolean;
}

const { current, locale, alternateHref, alternateLabel, alternateLocale, scrollsAway = false } = Astro.props;
const copy = ui[locale];
const groups = navGroups(locale);
const lineGroups = groups.filter((group) => group.line);
const github = groups[groups.length - 1].items[0];
const isCurrent = (item: { current?: CurrentPage }) => (item.current === current ? "page" : undefined);
---

<header class="site-header" data-static={scrollsAway ? "" : undefined}>
  <div class="site-header-bar glass">
    <a class="brand" href={pathFor(locale)} aria-label="Titpea home">Titpea</a>

    <nav class="nav" aria-label={copy.primaryLabel}>
      <a href={pathFor(locale, "about")} aria-current={current === "about" ? "page" : undefined}>{copy.about}</a>
      {
        lineGroups.map((group) => (
          <details class="nav-dropdown">
            <summary aria-current={group.items.some((item) => item.current === current) ? "page" : undefined}>
              {group.label}
            </summary>
            <div class="nav-dropdown-panel" role="menu">
              {group.items.map((item) => (
                <a href={item.href} role="menuitem" aria-current={isCurrent(item)}>
                  {item.label}
                </a>
              ))}
            </div>
          </details>
        ))
      }
      <a href={github.href} rel="noreferrer">{github.label}</a>
    </nav>

    <a class="language-switch" href={alternateHref} hreflang={alternateLocale === "zh" ? "zh-CN" : "en"}>
      {alternateLabel}
    </a>

    <button
      class="theme-toggle"
      type="button"
      data-theme-toggle
      data-label-dark={copy.themeToDark}
      data-label-light={copy.themeToLight}
      data-text-dark={copy.themeDarkText}
      data-text-light={copy.themeLightText}
      aria-label={copy.themeToDark}
      hidden
    >
      {copy.themeDarkText}
    </button>

    <details class="mobile-menu">
      <summary aria-label={copy.menuLabel}>{copy.menuText}</summary>
      <div class="mobile-menu-panel">
        {
          groups.map((group) => (
            <section
              class="mobile-menu-group"
              aria-label={group.label}
              data-current={group.items.some((item) => item.current === current) ? "true" : undefined}
            >
              <p>{group.label}</p>
              {group.items.map((item) => (
                <a href={item.href} aria-current={isCurrent(item)} rel={item.external ? "noreferrer" : undefined}>
                  {item.label}
                </a>
              ))}
            </section>
          ))
        }
      </div>
    </details>
  </div>
</header>

<script is:inline src="/scripts/nav-dropdown.js" defer></script>
<script is:inline src="/scripts/mobile-menu.js" defer></script>
