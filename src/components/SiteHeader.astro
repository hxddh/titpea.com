---
import { pathFor, type CurrentPage, type Locale } from "../lib/site";
import { desktopNavEntries, headerNavGroups, headerUi } from "../content/nav";

interface Props {
  current: CurrentPage;
  locale: Locale;
  alternateHref: string;
  alternateLabel: string;
  alternateLocale: Locale;
}

const { current, locale, alternateHref, alternateLabel, alternateLocale } = Astro.props;
const copy = headerUi(locale);
const homeHref = pathFor(locale);
const desktopNav = desktopNavEntries(locale, current);
const navGroups = headerNavGroups(locale, current);
---

<header class="site-header">
  <a class="brand" href={homeHref} aria-label="Titpea home">
    <span class="brand-mark" aria-hidden="true">T</span>
    <span>Titpea</span>
  </a>

  <div class="header-actions">
    <nav class="nav" aria-label={copy.primaryLabel}>
      {
        desktopNav.map((entry) =>
          entry.kind === "link" ? (
            <a
              href={entry.href}
              aria-current={entry.current === current ? "page" : undefined}
              rel={entry.external ? "noreferrer" : undefined}
            >
              {entry.label}
            </a>
          ) : (
            <details class="nav-dropdown" open={entry.open || undefined}>
              <summary aria-current={entry.open ? "page" : undefined}>{entry.label}</summary>
              <div class="nav-dropdown-panel" role="menu">
                {entry.items.map((item) => (
                  <a href={item.href} role="menuitem" aria-current={item.current === current ? "page" : undefined}>
                    {item.label}
                  </a>
                ))}
              </div>
            </details>
          ),
        )
      }
    </nav>

    <a class="language-switch" href={alternateHref} hreflang={alternateLocale === "zh" ? "zh-CN" : "en"}>
      {alternateLabel}
    </a>

    <button
      class="theme-toggle"
      type="button"
      data-theme-toggle
      data-label-dark={copy.themeToDark}
      data-label-light={copy.themeToLight}
      aria-label={copy.themeToDark}
      hidden
    >
      <span class="theme-icon theme-icon-dark" aria-hidden="true">☾</span>
      <span class="theme-icon theme-icon-light" aria-hidden="true">☀</span>
    </button>

    <details class="mobile-menu">
      <summary aria-label={copy.menuLabel}>{copy.menuText}</summary>
      <div class="mobile-menu-panel">
        {
          navGroups.map((group) => (
            <section
              class="mobile-menu-group"
              aria-label={group.label}
              data-current={group.items.some((item) => item.current === current) ? "true" : undefined}
            >
              <p>{group.label}</p>
              {group.items.map((item) => (
                <a
                  href={item.href}
                  aria-current={item.current === current ? "page" : undefined}
                  rel={item.external ? "noreferrer" : undefined}
                >
                  {item.label}
                </a>
              ))}
            </section>
          ))
        }
      </div>
    </details>
  </div>
</header>

<script is:inline src="/scripts/mobile-menu.js" defer></script>
