---
import { ui } from "../content/site";
import type { Locale } from "../content/schema";
import { navGroups, pathFor, sitePages, type CurrentPage } from "../lib/pages";

interface Props {
  current: CurrentPage;
  locale: Locale;
  alternateHref: string;
  alternateLabel: string;
  alternateLocale: Locale;
  /** Product pages pin their own local nav, so the site header scrolls away. */
  scrollsAway?: boolean;
}

const { current, locale, alternateHref, alternateLabel, alternateLocale, scrollsAway = false } = Astro.props;
const copy = ui[locale];
const groups = navGroups(locale);
const pages = sitePages(locale);
const onProduct = groups.some((group) => group.items.some((item) => item.current === current));
---

{/* One header for every width: a Products menu (names only, by line), then
    Releases, About and GitHub. On phones those three move into the menu's
    foot, the same links, never a second copy of the product list. */}
<header class="site-header" data-static={scrollsAway ? "" : undefined}>
  <div class="site-header-bar">
    <a class="brand" href={pathFor(locale)} aria-label={copy.homeLabel}>
      <img src="/favicon.svg" alt="" width="22" height="22" />
      Titpea
    </a>

    <nav class="nav" aria-label={copy.primaryLabel}>
      <details class="nav-dropdown products-menu">
        <summary aria-current={onProduct ? "page" : undefined}>{copy.products}</summary>
        <div class="nav-dropdown-panel products-panel">
          <div class="products-grid">
            {groups.map((group) => (
              <div class="products-col">
                <p class="products-col-label" id={`menu-${group.line}`}>
                  {group.label}
                </p>
                <ul aria-labelledby={`menu-${group.line}`}>
                  {group.items.map((item) => (
                    <li>
                      <a href={item.href} aria-current={item.current === current ? "page" : undefined}>
                        <img class="icon-plate" src={item.icon} alt="" width="20" height="20" loading="lazy" />
                        <span>{item.label}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
          <ul class="products-panel-pages">
            {pages.map((page) => (
              <li>
                <a
                  href={page.href}
                  rel={page.external ? "noreferrer" : undefined}
                  aria-current={page.current === current ? "page" : undefined}
                >
                  {page.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </details>
      {pages.map((page) => (
        <a
          class="nav-page"
          href={page.href}
          rel={page.external ? "noreferrer" : undefined}
          aria-current={page.current === current ? "page" : undefined}
        >
          {page.label}
        </a>
      ))}
    </nav>

    <a class="language-switch" href={alternateHref} hreflang={alternateLocale === "zh" ? "zh-CN" : "en"}>
      {alternateLabel}
    </a>

    <button
      class="theme-toggle"
      type="button"
      data-theme-toggle
      data-label-dark={copy.themeToDark}
      data-label-light={copy.themeToLight}
      aria-label={copy.themeToDark}
      hidden
    ></button>
  </div>
</header>

<script is:inline src="/scripts/nav-dropdown.js" defer></script>
