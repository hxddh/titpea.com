---
import type { ProductShowcaseFigure } from "../content/visualModels";

interface Props {
  supporting: ProductShowcaseFigure;
}

const { supporting } = Astro.props;
---

<section class="product-section product-screenshot-showcase">
  <div class="shell">
    <header class="section-head compact">
      <p class="section-kicker">{supporting.kicker}</p>
      <h2>{supporting.title}</h2>
      <p class="sub">{supporting.body}</p>
    </header>
    <figure class="shot show-shot">
      <img
        src={supporting.src}
        alt={supporting.alt}
        width={supporting.width}
        height={supporting.height}
        loading="lazy"
      />
    </figure>
  </div>
</section>
