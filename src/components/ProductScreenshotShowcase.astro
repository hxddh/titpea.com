---
import type { AgentWorkbenchScreenshotVisualModel } from "../content/visualModels";

interface Props {
  supporting: AgentWorkbenchScreenshotVisualModel["supporting"];
}

const { supporting } = Astro.props;
---

<section class="product-screenshot-showcase shell">
  <div class="screenshot-showcase-copy">
    <p class="section-kicker">{supporting.kicker}</p>
    <h2>{supporting.title}</h2>
    <p>{supporting.body}</p>
  </div>
  <figure>
    <img src={supporting.src} alt={supporting.alt} width={supporting.width} height={supporting.height} loading="lazy" />
  </figure>
</section>
