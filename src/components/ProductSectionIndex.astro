---
import type { Locale } from "../lib/site";

interface Props {
  locale: Locale;
  items: Array<[string, string]>;
  archetype?: "storageCli" | "agentPackage" | "browserExtension";
}

const { locale, items, archetype } = Astro.props;
const label =
  locale === "zh"
    ? archetype === "agentPackage"
      ? "诊断路径"
      : "阅读路径"
    : archetype === "agentPackage"
      ? "Diagnosis path"
      : "Read this page";
---

{
  items.length > 0 && (
    <nav
      class="product-section-index shell"
      aria-label={locale === "zh" ? "页面目录" : "Page index"}
      data-section-index
    >
      <span>{label}</span>
      <div>
        {items.map(([id, label]) => (
          <a href={`#${id}`} data-section-link={id}>
            {label}
          </a>
        ))}
      </div>
    </nav>
  )
}

<script>
  import "../scripts/section-index";
</script>
