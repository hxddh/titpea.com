---
import { headerCopy } from "../content/i18n/navCopy";

interface Props {
  label: string;
  items: Array<{ id: string; label: string }>;
  locale: "en" | "zh";
}

const { label, items, locale } = Astro.props;
const directoryLabel = headerCopy[locale].sectionDirectory;
const directoryId = `section-directory-${locale}`;
---

{
  items.length > 0 && (
    <nav class="product-section-index shell" aria-label={label} data-section-index>
      <span class="product-section-index-name">{label}</span>
      <button
        class="product-section-index-toggle"
        type="button"
        aria-expanded="false"
        aria-controls={directoryId}
        data-section-index-toggle
      >
        <span>{directoryLabel}</span>
        <span aria-hidden="true" data-section-index-symbol>
          +
        </span>
      </button>
      <div class="product-section-index-links" id={directoryId}>
        {items.map((item) => (
          <a href={`#${item.id}`} data-section-link={item.id}>
            {item.label}
          </a>
        ))}
      </div>
    </nav>
  )
}

<script>
  import "../scripts/section-index";
</script>
