---
interface Props {
  href: string;
  meta: string[];
  title: string;
  excerpt: string;
  group?: string;
}

const { href, meta, title, excerpt, group } = Astro.props;
---

<a class="feed-row" href={href} data-group={group}>
  <div class="feed-row-main">
    <p class="feed-row-meta">
      {meta.map((part) => <span>{part}</span>)}
    </p>
    <h3 class="feed-row-title">{title}</h3>
    <p class="feed-row-excerpt">{excerpt}</p>
  </div>
  <span class="feed-row-link" aria-hidden="true">→</span>
</a>
