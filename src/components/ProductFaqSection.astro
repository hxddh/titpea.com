---
import type { ProductSection } from "../content/productSections";

interface Props {
  section: Extract<ProductSection, { kind: "faq" }>;
}

const { section } = Astro.props;
---

<section id={section.id} class="content-section faq-section shell">
  <h2>{section.label}</h2>
  <div class="faq-list">
    {
      section.items.map((item) => (
        <details>
          <summary>{item.title}</summary>
          <p>{item.body}</p>
        </details>
      ))
    }
  </div>
</section>
