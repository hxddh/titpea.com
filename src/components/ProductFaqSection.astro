---
import type { ProductSection } from "../content/productSections";

interface Props {
  section: Extract<ProductSection, { kind: "faq" }>;
}

const { section } = Astro.props;
---

<section id={section.id} class="shell content-section faq-section">
  <p class="section-kicker">{section.label}</p>
  <div class="faq-list">
    {
      section.items.map(([question, answer]) => (
        <details>
          <summary>{question}</summary>
          <p>{answer}</p>
        </details>
      ))
    }
  </div>
</section>
