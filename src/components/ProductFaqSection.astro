---
import type { ProductSection } from "../content/productSections";

interface Props {
  section: Extract<ProductSection, { kind: "faq" }>;
}

const { section } = Astro.props;
---

<section id={section.id} class="shell content-section faq-section">
  <p class="section-kicker">{section.label}</p>
  <h2 class="section-heading sr-only">{section.label}</h2>
  <div class="faq-list">
    {
      section.items.map((item) => (
        <article>
          <h3>{item.title}</h3>
          <p>
            {item.body}
            {item.link && (
              <>
                {" "}
                <a href={item.link.href}>{item.link.label}</a>
              </>
            )}
          </p>
        </article>
      ))
    }
  </div>
</section>
