---
import SiteLayout from "../layouts/SiteLayout.astro";
import "../styles/home.css";
import { headingText } from "../lib/heading";
import type { HomePageModel } from "../lib/pages";

interface Props {
  model: HomePageModel;
}

const { model } = Astro.props;
---

<SiteLayout seo={model.seo} current={model.current} locale={model.locale} language={model.language}>
  <section class="shell home-hero">
    <h1 class="display">
      {model.hero.titleParts.map((part) => (
        <span class="display-line">{part}</span>
      ))}
    </h1>
    <p class="lead">{model.hero.lead}</p>
    <p class="home-byline">
      <span class="fact">{model.hero.eyebrow}</span>
      <a class="textlink" href={model.hero.about.href}>
        {model.hero.about.label}
      </a>
    </p>
  </section>

  {/* The picks: three products side by side, each window whole on the same raised paper. */}
  <section class="shell page-section picks-section" aria-labelledby="picks-title">
    <header class="section-head">
      <h2 class="heading" id="picks-title">
        {headingText(model.featured.title)}
      </h2>
    </header>
    <ul class="picks">
      {model.featured.items.map((item, index) => (
        <li class="pick">
          <a href={item.href}>
            <span class="pick-stage">
              <img
                src={item.image.src}
                alt=""
                width={item.image.width}
                height={item.image.height}
                loading={index === 0 ? "eager" : "lazy"}
                decoding="async"
              />
            </span>
            <span class="pick-copy">
              <strong class="pick-name">{item.name}</strong>
              <span class="pick-text">{item.text}</span>
              {item.caption && <span class="pick-caption">{item.caption}</span>}
              <span class="fact">
                {item.role}
                {item.version && <span data-visual-live> · {item.version}</span>}
              </span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  {/* The index: every product under its line, as icon, name and one line. */}
  <section class="shell page-section page-end" id="tools" aria-label={model.more.title}>
    {model.more.groups.map((group) => (
      <div class="index-group">
        <header class="index-head">
          <h2 class="index-title" id={`line-${group.line}-title`}>
            {group.label}
          </h2>
          <p class="fact">{group.count}</p>
        </header>
        <ul class="index-grid" aria-labelledby={`line-${group.line}-title`}>
          {group.items.map((item) => (
            <li>
              <a class="index-item" href={item.href}>
                <img class="icon-plate" src={item.icon} alt="" width="40" height="40" loading="lazy" />
                <span class="index-copy">
                  <strong class="index-name">{item.name}</strong>
                  <span class="index-text home-catalog-text">{item.text}</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </section>
</SiteLayout>
