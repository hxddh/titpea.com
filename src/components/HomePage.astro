---
import SiteLayout from "../layouts/SiteLayout.astro";
import type { HomePageModel } from "../content/siteModel";

interface Props {
  model: HomePageModel;
}

const { model } = Astro.props;

// MOCKUP ONLY (iteration review, not for merge): storage decision strip data.
// Real implementation would live in src/content/storageDecision.ts + content:check.
const isZh = model.locale === "zh";
const decisionTitle = isZh ? "存储选哪个" : "Which storage tool";
const decisionLabel = isZh ? "存储" : "Storage";
const decisionRows = (
  isZh
    ? [
        ["列举太慢、桶太大，中断要能续跑", "s3-turbo-list", "/zh/s3-turbo-list/"],
        ["线上出问题，但什么都不能动", "Storage Agent", "/zh/storage-agent-workbench/"],
        ["让 agent 用聊天里的日志和 trace 诊断", "StorageOps", "/zh/storageops/"],
        ["看一条命令实际发了什么请求", "httpmon", "/zh/httpmon/"],
        ["把 Pi 会话停在 BOS，换机器继续", "celagent", "/zh/celagent/"],
      ]
    : [
        ["Listing is slow, the bucket is huge, the run must resume", "s3-turbo-list", "/s3-turbo-list/"],
        ["Something is wrong in production, touch nothing", "Storage Agent", "/storage-agent-workbench/"],
        ["Let the agent diagnose from chat logs and traces", "StorageOps", "/storageops/"],
        ["See what a command actually sent", "httpmon", "/httpmon/"],
        ["Park a Pi session on BOS, resume it elsewhere", "celagent", "/celagent/"],
      ]
) as const;
---

<SiteLayout seo={model.seo} current={model.current} locale={model.locale} language={model.language}>
  <section class="home-hero shell">
    <div class="home-copy">
      <p class="eyebrow">{model.hero.eyebrow}</p>
      <h1>{model.hero.title}</h1>
      <p class="lead">{model.hero.lead}</p>
    </div>
  </section>

  <section class="home-evidence shell">
    <div class="home-evidence-heading">
      <h2>{model.featured.title}</h2>
    </div>
    <div class="home-evidence-grid">
      {
        model.featured.items.map((item) => (
          <a class="home-featured-card" href={item.href}>
            <figure>
              <img
                src={item.image.src}
                alt={item.image.alt}
                width={item.image.width}
                height={item.image.height}
                loading="eager"
              />
              <figcaption class="home-featured-caption">
                <strong>{item.name}</strong>
              </figcaption>
            </figure>
          </a>
        ))
      }
    </div>
  </section>

  <section class="home-decision shell" aria-label={decisionTitle}>
    <p class="about-product-line-label">{decisionLabel}</p>
    <h2>{decisionTitle}</h2>
    <ul class="home-decision-list">
      {
        decisionRows.map(([condition, name, href]) => (
          <li>
            <a class="home-decision-row" href={href}>
              <span class="home-decision-cond">{condition}</span>
              <strong class="home-decision-name">{name} →</strong>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="home-more-tools shell">
    <div class="browser-band-copy">
      <h2>{model.more.title}</h2>
    </div>
    <div class="home-catalog-columns">
      {
        model.more.groups.map((group) => (
          <section class="home-catalog-column">
            <h3 class="about-product-line-label">{group.label}</h3>
            <ul class="home-catalog-list">
              {group.items.map((item) => (
                <li>
                  <a href={item.href}>
                    {item.displayRole ? <span class="home-catalog-role">{item.displayRole}</span> : null}
                    <strong class="home-catalog-name">{item.name}</strong>
                    <p class="home-catalog-text">{item.text}</p>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </section>
</SiteLayout>
