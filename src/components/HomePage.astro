---
import CatalogCard from "./CatalogCard.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import type { HomePageModel } from "../lib/pages";
import { screenshotSizes, srcsetFor } from "../lib/images";

interface Props {
  model: HomePageModel;
}

const { model } = Astro.props;
---

<SiteLayout seo={model.seo} current={model.current} locale={model.locale} language={model.language}>
  <section class="home-hero">
    <div class="wash" aria-hidden="true"></div>
    <div class="shell home-copy">
      <ul class="home-icons" aria-label={model.hero.eyebrow}>
        {
          model.hero.icons.map((icon) => (
            <li>
              <a href={icon.href}>
                <img src={icon.src} alt={icon.name} width="72" height="72" />
                <span class="home-icon-name" aria-hidden="true">
                  {icon.name}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
      <p class="eyebrow">{model.hero.eyebrow}</p>
      <h1>{model.hero.title}</h1>
      <p class="lead">{model.hero.lead}</p>
      <div class="actions">
        <a class="button primary large" href="#more-title">{model.hero.browse}</a>
        <a class="button ghost" href={model.hero.about.href}>{model.hero.about.label}</a>
      </div>
    </div>
  </section>

  <section class="home-evidence" aria-labelledby="featured-title">
    <div class="shell">
      <header class="section-head">
        <h2 id="featured-title">{model.featured.title}</h2>
      </header>
      {
        model.featured.items.map((item) => (
          <a class="home-featured-card" href={item.href}>
            <span class="home-featured-copy">
              <span class="section-kicker">{item.role}</span>
              <strong class="home-featured-name">{item.name}</strong>
              <span class="sub">{item.text}</span>
              <span class="home-featured-more">{model.featured.learnMore}</span>
            </span>
            <figure class="shot">
              <img
                src={item.image.src}
                srcset={srcsetFor(item.image.src, item.image.width)}
                sizes={screenshotSizes}
                alt={item.image.alt}
                width={item.image.width}
                height={item.image.height}
                loading="eager"
              />
            </figure>
          </a>
        ))
      }
    </div>
  </section>

  <section class="home-more-tools" aria-labelledby="more-title">
    <div class="shell">
      <header class="section-head">
        <h2 id="more-title">{model.more.title}</h2>
      </header>
      {
        model.more.groups.map((group) => (
          <section class="home-catalog-group" data-line={group.line} aria-label={group.label}>
            <h3 class="home-catalog-label">{group.label}</h3>
            <ul class="home-catalog-list">
              {group.items.map((item) => (
                <li>
                  <CatalogCard item={item} />
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </section>
</SiteLayout>
