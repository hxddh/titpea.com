---
import SiteLayout from "../layouts/SiteLayout.astro";
import "../styles/home.css";
import type { HomePageModel } from "../lib/pages";

interface Props {
  model: HomePageModel;
}

const { model } = Astro.props;
---

<SiteLayout seo={model.seo} current={model.current} locale={model.locale} language={model.language}>
  <section class="shell home-hero">
    <h1 class="display">
      {model.hero.titleParts.map((part) => (
        <span class="display-line">{part}</span>
      ))}
    </h1>
    <div class="cols rule">
      <div class="cols-margin">
        <p class="fact">{model.hero.eyebrow}</p>
        <a class="textlink" href={model.hero.about.href}>
          {model.hero.about.label}
        </a>
      </div>
      <div class="cols-main home-copy">
        <p class="lead">{model.hero.lead}</p>
      </div>
    </div>
  </section>

  {/* The picks: three products across the whole width, each window whole on its own paper. */}
  <section class="shell page-section picks-section" aria-labelledby="picks-title">
    <div class="rule">
      <h2 class="heading" id="picks-title">
        {model.featured.title}
      </h2>
      <ul class="picks">
        {model.featured.items.map((item, index) => (
          <li class:list={["pick", index === 0 && "pick-lead"]}>
            <a href={item.href}>
              <span class="stage" data-tint={item.slug}>
                <img
                  src={item.image.src}
                  alt=""
                  width={item.image.width}
                  height={item.image.height}
                  loading={index === 0 ? "eager" : "lazy"}
                  decoding="async"
                />
              </span>
              <span class="pick-copy">
                <strong class="pick-name">{item.name}</strong>
                <span class="pick-text">{item.text}</span>
                {item.caption && <span class="pick-caption">{item.caption}</span>}
                <span class="fact">
                  {item.role}
                  {item.version && <span data-visual-live> · {item.version}</span>}
                </span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* The index: every product a row, under its line. */}
  <section class="shell page-section page-end" id="tools" aria-label={model.more.title}>
    {model.more.groups.map((group) => (
      <div class="cols rule index-group">
        <div class="cols-margin">
          <h2 class="heading" id={`line-${group.line}-title`}>
            {group.label}
          </h2>
          <p class="fact">{group.count}</p>
        </div>
        <ul class="cols-main index-list panel" aria-labelledby={`line-${group.line}-title`}>
          {group.items.map((item) => (
            <li>
              <a class="index-row" href={item.href}>
                <img class="icon-plate" src={item.icon} alt="" width="32" height="32" loading="lazy" />
                <strong class="index-name">{item.name}</strong>
                <span class="index-text home-catalog-text">{item.text}</span>
                <span class="fact index-fact" data-visual-live>
                  {item.version && <span>{item.version}</span>}
                  {item.released && <span>{item.released}</span>}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </section>
</SiteLayout>
