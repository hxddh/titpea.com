---
import SiteLayout from "../layouts/SiteLayout.astro";
import "../styles/home.css";
import type { HomePageModel } from "../lib/pages";
import { srcsetFor } from "../lib/images";

interface Props {
  model: HomePageModel;
}

const { model } = Astro.props;
---

<SiteLayout seo={model.seo} current={model.current} locale={model.locale} language={model.language}>
  <section class="home-hero">
    <div class="wash" aria-hidden="true"></div>
    <div class="shell home-copy">
      <p class="eyebrow">{model.hero.eyebrow}</p>
      <h1>
        {model.hero.titleParts.length > 1
          ? model.hero.titleParts.map((part) => <span class="title-part">{part}</span>)
          : model.hero.title}
      </h1>
      <p class="lead">{model.hero.lead}</p>
      <div class="actions">
        <a class="button primary large" href="#more-title">
          {model.hero.browse}
        </a>
        <a class="button ghost" href={model.hero.about.href}>
          {model.hero.about.label}
        </a>
      </div>
    </div>
  </section>

  <section class="home-more-tools" aria-labelledby="more-title">
    <div class="shell">
      <header class="section-head">
        <h2 id="more-title">{model.more.title}</h2>
      </header>
      {/* The featured products lead the catalog as larger cards. */}
      <ul class="home-catalog-featured" aria-label={model.featured.title}>
        {model.featured.items.map((item) => (
          <li>
            <a class="home-featured-card" href={item.href}>
              <figure class="home-featured-shot">
                <img
                  src={item.image.src}
                  srcset={srcsetFor(item.image.src, item.image.width)}
                  sizes="(max-width: 640px) 80vw, (max-width: 960px) calc(50vw - 28px), 340px"
                  alt=""
                  width={item.image.width}
                  height={item.image.height}
                  loading="lazy"
                  decoding="async"
                />
              </figure>
              <span class="home-featured-copy">
                <span class="section-kicker">{item.role}</span>
                <strong class="home-featured-name">{item.name}</strong>
                <span class="home-featured-text">{item.text}</span>
                {/* Under the text, so every card's title starts at the same height. */}
                {item.caption && <span class="home-featured-caption">{item.caption}</span>}
                <span class="home-featured-more">{model.featured.learnMore}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
      {/* Then every other product, under its line. */}
      {model.more.groups.map((group) => (
        <div class="home-line">
          <h3 class="home-line-title" id={`line-${group.line}-title`}>
            {group.label}
          </h3>
          <ul class="home-catalog-list" aria-labelledby={`line-${group.line}-title`}>
            {group.items.map((item) => (
              <li>
                <a class="catalog-card" href={item.href}>
                  <img class="catalog-icon" src={item.icon} alt="" width="40" height="40" loading="lazy" />
                  <span class="catalog-card-copy">
                    <strong class="home-catalog-name">{item.name}</strong>
                    <span class="home-catalog-text">{item.text}</span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>
</SiteLayout>
