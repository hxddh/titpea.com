---
import SiteLayout from "../layouts/SiteLayout.astro";
import { homeProductLines, pathFor, products, ui, type Locale, type ProductSlug } from "../lib/site";

interface Props {
  locale: Locale;
}

type ProductLineItem = {
  slug?: ProductSlug;
  name?: string;
  href?: string;
  text: string;
};

const { locale } = Astro.props;
const copy = ui[locale];
const productLines = homeProductLines[locale];
const itemName = (item: ProductLineItem) => item.slug ? products[item.slug].locales[locale].title : item.name;
const itemHref = (item: ProductLineItem) => item.slug ? pathFor(locale, item.slug) : item.href;
const storageFlow = locale === "zh"
  ? [
      ["01", "List / Diff", "s3-turbo-list", "高性能列举大型 S3 兼容桶，对比两个 bucket，并写出带 DiffFlag 的 Parquet。", pathFor(locale, "s3-turbo-list")],
      ["02", "Agent", "StorageOps", "给 Pi 安装对象存储诊断 skills、extension tools、helper scripts 和 eval cases。", pathFor(locale, "storageops")],
      ["03", "下钻", "httpmon", "当 SDK 或 CLI 隐藏细节时，捕获真实 HTTP 请求、响应、重试和签名上下文。", "https://github.com/hxddh/https-traffic-inspector"],
    ]
  : [
      ["01", "List / Diff", "s3-turbo-list", "List large S3-compatible buckets fast, diff two buckets, and write Parquet rows with DiffFlag.", pathFor(locale, "s3-turbo-list")],
      ["02", "Agent", "StorageOps", "Install object-storage diagnostic skills, Pi extension tools, helper scripts, and eval cases.", pathFor(locale, "storageops")],
      ["03", "Inspect", "httpmon", "Capture real HTTP requests, responses, retries, and signing context when SDKs or CLIs hide the details.", "https://github.com/hxddh/https-traffic-inspector"],
    ];
---

<SiteLayout
  title="Titpea"
  description={locale === "zh" ? "Titpea 是 hxddh 的个人网站和产品索引。" : "Titpea is the personal site and product index for hxddh."}
  current="home"
  locale={locale}
>
  <section class="home-hero home-hero-modern shell">
    <div class="home-copy">
      <p class="eyebrow">{copy.productIndex}</p>
      <h1>{copy.homeTitle}</h1>
      <p class="lead">{copy.homeLead}</p>
      <div class="actions">
        <a class="button primary" href={pathFor(locale, "s3-turbo-list")}>{copy.homePrimary}</a>
        <a class="button ghost" href={pathFor(locale, "storageops")}>{copy.homeSecondary}</a>
        <a class="button ghost" href={pathFor(locale, "about")}>{copy.homeAbout}</a>
      </div>
    </div>

    <div class="home-panel product-map" aria-label={copy.featuredLabel}>
      <div class="map-intro">
        <p class="section-kicker">{copy.flowLabel}</p>
        <h2>{copy.flowTitle}</h2>
        <p>{copy.flowBody}</p>
      </div>
      <div class="flow-list">
        {storageFlow.map(([number, verb, name, body, href]) => (
          <a class="flow-card" href={href}>
            <span>{number}</span>
            <div>
              <strong>{verb}</strong>
              <h3>{name}</h3>
              <p>{body}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="proof-strip shell" aria-label={copy.thesisLabel}>
    {copy.proofItems.map((item) => <span>{item}</span>)}
  </section>

  <section class="band narrative-band">
    <div class="shell split-content">
      <div>
        <p class="section-kicker">{copy.thesisLabel}</p>
        <h2>{copy.thesisTitle}</h2>
      </div>
      <p class="prose">{copy.thesisBody}</p>
    </div>
  </section>

  <section class="home-products shell">
    {productLines.map((line) => (
      <section class="product-line" aria-label={line.label}>
        <div class="product-line-heading">
          <p class="section-kicker">{line.label}</p>
          <h2>{line.title}</h2>
        </div>
        <div class="compact-list">
          {line.items.map((item) => (
            <a class="compact-link" href={itemHref(item)}>
              <span>{itemName(item)}</span>
              <p>{item.text}</p>
            </a>
          ))}
        </div>
      </section>
    ))}
  </section>
</SiteLayout>
