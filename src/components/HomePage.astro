---
import SiteLayout from "../layouts/SiteLayout.astro";
import type { HomePageModel } from "../content/siteModel";

interface Props {
  model: HomePageModel;
}

const { model } = Astro.props;
---

<SiteLayout seo={model.seo} current={model.current} locale={model.locale} language={model.language}>
  <section class="home-hero home-workbench-hero shell">
    <div class="home-copy home-workbench-copy">
      <p class="eyebrow">{model.hero.eyebrow}</p>
      <h1>{model.hero.title}</h1>
      <p class="lead">{model.hero.lead}</p>
      <div class="actions">
        {
          model.hero.actions.map((action) => (
            <a class:list={["button", action.style]} href={action.href}>
              {action.label}
            </a>
          ))
        }
      </div>
      <div class="home-proof-rail" aria-label={model.hero.proofLabel}>
        {model.hero.proofItems.map((item) => <span>{item}</span>)}
      </div>
    </div>

    <div class="home-workbench-panel" aria-label={model.flow.label}>
      <div class="workbench-panel-head editorial-panel-head">
        <p class="section-kicker">{model.flow.label}</p>
        <h2>{model.flow.title}</h2>
        <p>{model.flow.body}</p>
      </div>
      <div class="workbench-flow-list">
        {
          model.flow.items.map((item) => (
            <a class="workbench-flow-card" href={item.href}>
              <span>{item.number}</span>
              <div>
                <strong>{item.verb}</strong>
                <h3>{item.name}</h3>
                <p>{item.text}</p>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="home-browser-band shell">
    <div class="browser-band-copy">
      <p class="section-kicker">{model.browser.label}</p>
      <h2>{model.browser.title}</h2>
      <p>{model.browser.body}</p>
    </div>
    <div class="browser-band-body">
      <div class="browser-tool-list">
        {
          model.browser.tools.map((item) => (
            <a href={item.href}>
              <span>{item.name}</span>
              <p>{item.text}</p>
            </a>
          ))
        }
      </div>
      <div class="browser-screenshot-row" aria-label={model.browser.screenshotLabel}>
        {
          model.browser.screenshots.map((screenshot) => (
            <a href={screenshot.href} class={screenshot.className}>
              <img src={screenshot.src} alt={screenshot.alt} loading="lazy" />
            </a>
          ))
        }
      </div>
    </div>
  </section>
</SiteLayout>
