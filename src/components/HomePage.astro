---
import SiteLayout from "../layouts/SiteLayout.astro";
import ProductVisual from "./ProductVisual.astro";
import type { HomePageModel } from "../content/siteModel";

interface Props {
  model: HomePageModel;
}

const { model } = Astro.props;

function metaLabel(item: HomePageModel["storage"]["items"][number]) {
  // Single label layer: number + form badge (or role if no badge).
  if (item.number && item.badge) return `${item.number} · ${item.badge}`;
  if (item.badge) return item.badge;
  if (item.number) return `${item.number} · ${item.displayRole}`;
  return item.displayRole;
}
---

<SiteLayout seo={model.seo} current={model.current} locale={model.locale} language={model.language}>
  <section class="home-hero shell home-hero-with-visual">
    <div class="home-copy home-workbench-copy">
      <p class="eyebrow">{model.hero.eyebrow}</p>
      <h1>{model.hero.title}</h1>
      <p class="lead">{model.hero.lead}</p>
      <div class="actions">
        {
          model.hero.actions.map((action) => (
            <a
              class:list={["button", action.style]}
              href={action.href}
              rel={action.external ? "noreferrer" : undefined}
            >
              {action.label}
            </a>
          ))
        }
      </div>
    </div>
    <a class="hero-visual-frame home-flagship-visual" href={model.hero.visualHref} aria-label={model.hero.visual.label}>
      <ProductVisual visual={model.hero.visual} />
    </a>
  </section>

  <section id={model.storage.id} class="home-catalog shell">
    <div class="catalog-heading">
      <p class="section-kicker">{model.storage.label}</p>
      <h2>{model.storage.title}</h2>
    </div>
    <div class="catalog-grid storage-catalog-grid">
      {
        model.storage.items.map((item) => (
          <a class:list={["catalog-card", item.isPrimary && "primary"]} href={item.href}>
            <div class="catalog-card-meta">
              <span>{metaLabel(item)}</span>
            </div>
            <h3>{item.name}</h3>
            <p>{item.text}</p>
          </a>
        ))
      }
    </div>
  </section>

  <section id={model.personal.id} class="home-catalog shell home-personal-catalog">
    <div class="catalog-heading">
      <p class="section-kicker">{model.personal.label}</p>
      <h2>{model.personal.title}</h2>
    </div>
    <div class="catalog-grid personal-catalog-grid">
      {
        model.personal.items.map((item) => (
          <a class:list={["catalog-card", item.isPrimary && "primary"]} href={item.href}>
            <div class="catalog-card-meta">
              <span>{metaLabel(item)}</span>
            </div>
            <h3>{item.name}</h3>
            <p>{item.text}</p>
          </a>
        ))
      }
    </div>
  </section>
</SiteLayout>
