---
import SiteLayout from "../layouts/SiteLayout.astro";
import { homeProductLines, pathFor, products, ui, type Locale, type ProductSlug } from "../lib/site";

interface Props {
  locale: Locale;
}

type ProductLineItem = {
  slug?: ProductSlug;
  name?: string;
  href?: string;
  text: string;
};

const { locale } = Astro.props;
const copy = ui[locale];
const productLines = homeProductLines[locale];
const itemName = (item: ProductLineItem) => item.slug ? products[item.slug].locales[locale].title : item.name;
const itemHref = (item: ProductLineItem) => item.slug ? pathFor(locale, item.slug) : item.href;
---

<SiteLayout
  title="Titpea"
  description={locale === "zh" ? "Titpea 是 hxddh 的个人网站和产品索引。" : "Titpea is the personal site and product index for hxddh."}
  current="home"
  locale={locale}
>
  <section class="home-hero home-hero-modern shell">
    <div class="home-copy">
      <p class="eyebrow">{copy.productIndex}</p>
      <h1>{copy.homeTitle}</h1>
      <p class="lead">{copy.homeLead}</p>
      <div class="actions">
        <a class="button primary" href={pathFor(locale, "s3-turbo-list")}>{copy.homePrimary}</a>
        <a class="button ghost" href={pathFor(locale, "storageops")}>{copy.homeSecondary}</a>
        <a class="button ghost" href={pathFor(locale, "about")}>{copy.homeAbout}</a>
      </div>
    </div>

    <div class="home-panel" aria-label={copy.featuredLabel}>
      <a class="featured-product featured-primary" href={pathFor(locale, "s3-turbo-list")}>
        <span>{locale === "zh" ? "01 / 大桶清单" : "01 / Large bucket inventory"}</span>
        <strong>s3-turbo-list</strong>
        <p>{locale === "zh" ? "自动发现 key-space 边界，并发列举，输出可分析的 Parquet 清单。" : "Auto-discover key-space boundaries, list in parallel, and produce analysis-ready Parquet inventory."}</p>
      </a>
      <div class="featured-row">
        <a class="featured-product" href={pathFor(locale, "storageops")}>
          <span>{locale === "zh" ? "02 / 故障诊断" : "02 / Failure diagnosis"}</span>
          <strong>StorageOps</strong>
        </a>
        <a class="featured-product" href="https://github.com/hxddh/https-traffic-inspector">
          <span>{locale === "zh" ? "03 / 流量证据" : "03 / Traffic evidence"}</span>
          <strong>httpmon</strong>
        </a>
      </div>
    </div>
  </section>

  <section class="proof-strip shell" aria-label={copy.thesisLabel}>
    {copy.proofItems.map((item) => <span>{item}</span>)}
  </section>

  <section class="band narrative-band">
    <div class="shell split-content">
      <div>
        <p class="section-kicker">{copy.thesisLabel}</p>
        <h2>{copy.thesisTitle}</h2>
      </div>
      <p class="prose">{copy.thesisBody}</p>
    </div>
  </section>

  <section class="home-products shell">
    {productLines.map((line) => (
      <section class="product-line" aria-label={line.label}>
        <div class="product-line-heading">
          <p class="section-kicker">{line.label}</p>
          <h2>{line.title}</h2>
        </div>
        <div class="compact-list">
          {line.items.map((item) => (
            <a class="compact-link" href={itemHref(item)}>
              <span>{itemName(item)}</span>
              <p>{item.text}</p>
            </a>
          ))}
        </div>
      </section>
    ))}
  </section>
</SiteLayout>
