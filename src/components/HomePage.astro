---
import SiteLayout from "../layouts/SiteLayout.astro";
import "../styles/home.css";
import { headingText } from "../lib/heading";
import type { HomePageModel } from "../lib/pages";

interface Props {
  model: HomePageModel;
}

const { model } = Astro.props;
const [lead, ...rest] = model.featured.items;
---

<SiteLayout seo={model.seo} current={model.current} locale={model.locale} language={model.language}>
  <section class="shell home-hero">
    <h1 class="display">
      {model.hero.titleParts.map((part) => (
        <span class="display-line">{part}</span>
      ))}
    </h1>
    <p class="lead">{model.hero.lead}</p>
    <p class="home-byline">
      <span class="fact">{model.hero.eyebrow}</span>
      <a class="textlink" href={model.hero.about.href}>
        {model.hero.about.label}
      </a>
    </p>
  </section>

  {/* The picks: one large, two beside it; each its real window, its claim and its tag. */}
  <section class="shell page-section picks-section" aria-labelledby="picks-title">
    <header class="index-head">
      <h2 class="heading" id="picks-title">
        {headingText(model.featured.title)}
      </h2>
    </header>
    <ul class="picks">
      {[lead, ...rest].map((item, index) => (
        <li class="pick" data-lead={index === 0 ? "" : undefined}>
          <a href={item.href}>
            <span class="pick-stage">
              <img
                src={item.image.src}
                alt=""
                width={item.image.width}
                height={item.image.height}
                loading={index === 0 ? "eager" : "lazy"}
                decoding="async"
              />
            </span>
            <span class="pick-copy">
              <span class="pick-ident">
                <img class="icon-plate" src={item.icon} alt="" width="24" height="24" loading="lazy" />
                <strong class="pick-name">{item.name}</strong>
                <span class="pick-eyebrow">{item.eyebrow}</span>
              </span>
              <span class="pick-text">{item.headline}</span>
              {item.caption && <span class="pick-caption">{item.caption}</span>}
              <span class="tags">
                {item.facts.platforms.map((platform) => (
                  <span class="tag">{platform}</span>
                ))}
                {item.facts.version && (
                  <span class="tag tag-version" data-visual-live>
                    {item.facts.version}
                  </span>
                )}
              </span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  {/* Everything, by line, as rows: name, one line of value, platform tags, version.
      The filters are buttons that public/scripts/filter.js wires; without
      scripts they stay hidden and every row shows. */}
  <section class="shell page-section page-end index-section" id="tools" aria-labelledby="index-title">
    <header class="index-head">
      <h2 class="heading" id="index-title">
        {headingText(model.more.title)}
      </h2>
    </header>
    <div class="filters" data-filters hidden>
      <div class="filter-row" role="group" aria-label={model.more.filters.lineLabel}>
        <span class="filter-label" aria-hidden="true">
          {model.more.filters.lineLabel}
        </span>
        {model.more.filters.lines.map((option) => (
          <button
            type="button"
            class="chip"
            data-filter-line={option.key}
            aria-pressed={option.key === "all" ? "true" : "false"}
          >
            {option.label}
          </button>
        ))}
      </div>
      <div class="filter-row" role="group" aria-label={model.more.filters.platformLabel}>
        <span class="filter-label" aria-hidden="true">
          {model.more.filters.platformLabel}
        </span>
        {model.more.filters.platforms.map((option) => (
          <button
            type="button"
            class="chip"
            data-filter-platform={option.key}
            aria-pressed={option.key === "all" ? "true" : "false"}
          >
            {option.label}
          </button>
        ))}
      </div>
    </div>
    {model.more.groups.map((group) => (
      <div class="index-group" data-line={group.line}>
        <h3 class="index-title" id={`line-${group.line}-title`}>
          {group.label}
          <span class="fact">{group.count}</span>
        </h3>
        <ul class="index-rows" aria-labelledby={`line-${group.line}-title`}>
          {group.items.map((item) => (
            <li data-line={item.line} data-platforms={item.filters.join(" ")}>
              <a class="index-row" href={item.href}>
                <img class="icon-plate" src={item.icon} alt="" width="36" height="36" loading="lazy" />
                <span class="index-copy">
                  <strong class="index-name">{item.name}</strong>
                  <span class="index-text">{item.text}</span>
                </span>
                <span class="index-meta">
                  <span class="tags">
                    <span class="tag tag-kind">{item.facts.kind}</span>
                    {item.facts.platforms.map((platform) => (
                      <span class="tag">{platform}</span>
                    ))}
                  </span>
                  {item.facts.version && (
                    <span class="index-version" data-visual-live>
                      {item.facts.version}
                    </span>
                  )}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}
    <p class="filter-empty" data-filter-empty hidden>
      {model.more.filters.empty}
    </p>
  </section>
  <Fragment slot="scripts">
    <script is:inline src="/scripts/filter.js" defer></script>
  </Fragment>
</SiteLayout>
