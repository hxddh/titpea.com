---
import SiteLayout from "../layouts/SiteLayout.astro";
import type { HomePageModel } from "../content/siteModel";

interface Props {
  model: HomePageModel;
}

const { model } = Astro.props;
---

<SiteLayout seo={model.seo} current={model.current} locale={model.locale} language={model.language}>
  <section class="home-hero shell">
    <div class="home-copy home-workbench-copy">
      <p class="eyebrow">{model.hero.eyebrow}</p>
      <h1>{model.hero.title}</h1>
      <p class="lead">{model.hero.lead}</p>
      <div class="actions">
        {
          model.hero.actions.map((action) => (
            <a
              class:list={["button", action.style]}
              href={action.href}
              rel={action.external ? "noreferrer" : undefined}
            >
              {action.label}
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="home-evidence shell">
    <div class="home-evidence-heading">
      <p class="section-kicker">{model.featured.label}</p>
      <h2>{model.featured.title}</h2>
    </div>
    <div class="home-evidence-grid home-featured-grid">
      {
        model.featured.items.map((item) => (
          <a class="home-evidence-card home-featured-card" href={item.href}>
            <figure>
              <img
                src={item.image.src}
                alt={item.image.alt}
                width={item.image.width}
                height={item.image.height}
                loading="lazy"
              />
            </figure>
            <span>{item.name}</span>
            <p>{item.text}</p>
            <div>
              {item.proof.map((proof) => (
                <strong>{proof}</strong>
              ))}
            </div>
          </a>
        ))
      }
    </div>
  </section>

  <section class="home-thesis-band shell">
    <div class="home-thesis-layout">
      <div>
        <p class="section-kicker">{model.principles.label}</p>
        <h2>{model.principles.title}</h2>
        <p class="prose">{model.principles.lead}</p>
      </div>
      <div class="home-principles-list">
        {
          model.principles.items.map((item) => (
            <article>
              <>
                <strong>{item.title}</strong>
                <p>{item.body}</p>
              </>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="home-catalog shell">
    <div class="catalog-heading">
      <p class="section-kicker">{model.storage.label}</p>
      <h2>{model.storage.title}</h2>
    </div>
    <div class="catalog-grid storage-catalog-grid">
      {
        model.storage.items.map((item) => (
          <a class:list={["catalog-card", item.isPrimary && "primary"]} href={item.href}>
            <span>{item.number ? `${item.number} · ${item.displayRole}` : item.displayRole}</span>
            <h3>{item.name}</h3>
            <p>{item.text}</p>
          </a>
        ))
      }
    </div>
  </section>

  <section class="home-browser-band shell">
    <div class="browser-band-copy">
      <p class="section-kicker">{model.personal.label}</p>
      <h2>{model.personal.title}</h2>
    </div>
    <div class="browser-tool-list compact">
      {
        model.personal.items.map((item) => (
          <a href={item.href}>
            <span>{item.displayRole}</span>
            <strong>{item.name}</strong>
            <p>{item.text}</p>
          </a>
        ))
      }
    </div>
  </section>
</SiteLayout>
