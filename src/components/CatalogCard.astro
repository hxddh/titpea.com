---
import type { CatalogItem } from "../lib/pages";

interface Props {
  item: CatalogItem;
}

const { item } = Astro.props;
---

<a class="catalog-row" href={item.href}>
  <img class="catalog-icon" src={item.icon} alt="" width="48" height="48" />
  <span class="catalog-row-copy">
    <strong class="home-catalog-name">{item.name}</strong>
    <span class="home-catalog-text">{item.text}</span>
  </span>
  <span class="catalog-chevron" aria-hidden="true">›</span>
</a>
