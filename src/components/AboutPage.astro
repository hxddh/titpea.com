---
import SiteLayout from "../layouts/SiteLayout.astro";
import type { AboutPageModel } from "../content/siteModel";

interface Props {
  model: AboutPageModel;
}

const { model } = Astro.props;
---

<SiteLayout seo={model.seo} current={model.current} locale={model.locale} language={model.language}>
  <section class="about-hero shell">
    <div class="about-redesign-copy">
      <p class="eyebrow">{model.hero.eyebrow}</p>
      <h1>{model.hero.lead}</h1>
      <p class="lead about-hero-body">{model.hero.body}</p>
    </div>
  </section>

  <section class="about-why shell" aria-labelledby="about-why-heading">
    <div class="about-section-heading">
      <p class="section-kicker">{model.why.label}</p>
      <h2 id="about-why-heading">{model.why.title}</h2>
      <p>{model.why.body}</p>
    </div>
    <ul class="about-why-lines">
      {
        model.why.lines.map((line) => (
          <li>
            <strong>{line.label}</strong>
            <span>{line.body}</span>
          </li>
        ))
      }
    </ul>
    <p class="about-why-closing">{model.why.closing}</p>
  </section>

  <section class="about-tool-index shell" aria-labelledby="about-tools-heading">
    <div class="about-section-heading">
      <p class="section-kicker" id="about-tools-heading">{model.tools.label}</p>
    </div>
    {
      model.tools.lines.map((line) => (
        <div class="about-tool-line">
          <p class="about-tool-line-label">{line.label}</p>
          <p class="about-tool-links">
            {line.items.map((item) => (
              <a href={item.href}>{item.name}</a>
            ))}
          </p>
        </div>
      ))
    }
  </section>

  <section class="about-contact shell" aria-label={model.contact.label}>
    <p class="section-kicker">{model.contact.label}</p>
    <div class="actions about-contact-row">
      {
        model.contact.actions.map((action) => (
          <a class:list={["button", action.style]} href={action.href} rel={action.external ? "noreferrer" : undefined}>
            {action.label}
          </a>
        ))
      }
    </div>
  </section>
</SiteLayout>
