---
import SiteLayout from "../layouts/SiteLayout.astro";
import { pathFor, type Locale } from "../lib/site";
import { ui } from "../content/home";
import { aboutProducts, products } from "../content/products";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = ui[locale];
const isZh = locale === "zh";
const productGroups = isZh
  ? [
      ["对象存储", "先把大桶列清楚，再把两个 bucket 的差异算清；出问题时，让 Pi 和 HTTP trace 接上诊断链路。"],
      ["浏览器扩展", "世界时钟和豆瓣评分助手都很小：不做平台，不抢流程，只补当前页面缺的一点信息。"],
      ["做事方式", "命令要清楚，输出要能继续处理，最好能接到 DuckDB、pandas、日志或下一步排查。"],
    ]
  : [
      [
        "Object storage",
        "List the bucket, compare object state, then use Pi and HTTP traces when a failure needs diagnosis.",
      ],
      [
        "Browser extensions",
        "World Clock and Douban Movie Rating Assistant stay small: no platform ambition, no workflow takeover.",
      ],
      [
        "Working style",
        "The bias is toward explainable tools with clear commands and outputs that can move into DuckDB, pandas, logs, or the next diagnostic step.",
      ],
    ];
---

<SiteLayout title={copy.aboutTitle} description={copy.aboutDescription} current="about" locale={locale}>
  <section class="about-hero about-redesign-hero shell">
    <div class="about-redesign-copy">
      <p class="eyebrow">hxddh</p>
      <h1>{copy.aboutHeadline}</h1>
      <p class="lead">{copy.aboutLead}</p>
      <div class="socials about-contact-row" aria-label={isZh ? "联系方式" : "Contact links"}>
        <a href="https://github.com/hxddh" rel="noreferrer">GitHub</a>
        <a href="https://chromewebstore.google.com/detail/world-clock/mghphbjnicggehnhbjbpjddfidkepnfp" rel="noreferrer"
          >Chrome Web Store</a
        >
        <a href="mailto:info@titpea.com">Email</a>
      </div>
    </div>
    <aside class="about-system-panel" aria-label={isZh ? "产品线" : "Product lines"}>
      {
        productGroups.map(([title, body]) => (
          <div>
            <span>{title}</span>
            <p>{body}</p>
          </div>
        ))
      }
    </aside>
  </section>

  <section class="about-products shell">
    <div class="about-section-heading">
      <p class="section-kicker">{copy.productsLabel}</p>
      <h2>{isZh ? "主线产品和旁支工具" : "Main products and side tools"}</h2>
    </div>
    <div class="about-product-grid">
      <a class="about-product-card primary" href={pathFor(locale, "s3-turbo-list")}>
        <span>s3-turbo-list</span>
        <strong>{isZh ? "高速对象存储 list / diff CLI" : "High-performance object storage list / diff CLI"}</strong>
        <p>{products["s3-turbo-list"].locales[locale].description}</p>
      </a>
      <a class="about-product-card primary" href={pathFor(locale, "storageops")}>
        <span>StorageOps</span>
        <strong>{isZh ? "Pi 的对象存储诊断 agent" : "Pi-based object storage diagnosis agent"}</strong>
        <p>{products.storageops.locales[locale].description}</p>
      </a>
      <a class="about-product-card" href="https://github.com/hxddh/https-traffic-inspector">
        <span>https-traffic-inspector</span>
        <strong>{isZh ? "命令行 HTTP / HTTPS 流量检查" : "Command-line HTTP / HTTPS inspection"}</strong>
        <p>
          {
            isZh
              ? "当 SDK 或 CLI 把细节藏起来，用它看真实请求、响应、重试和签名上下文。"
              : "Inspect real HTTP requests, responses, retries, and signing context when SDKs or CLIs hide the details."
          }
        </p>
      </a>
      {
        aboutProducts
          .filter((slug) => slug === "world-clock" || slug === "douban-movie-rating")
          .map((slug) => (
            <a class="about-product-card" href={pathFor(locale, slug)}>
              <span>{products[slug].locales[locale].title}</span>
              <strong>
                {products[slug].category === "browser"
                  ? isZh
                    ? "轻量 Chrome 扩展"
                    : "Lightweight Chrome extension"
                  : products[slug].name}
              </strong>
              <p>{products[slug].locales[locale].description}</p>
            </a>
          ))
      }
    </div>
  </section>

  <section class="about-principles">
    <div class="shell split-content">
      <div>
        <p class="section-kicker">{copy.profileLabel}</p>
        <h2>{copy.profileTitle}</h2>
      </div>
      <div class="prose">
        {copy.profileBody.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </div>
  </section>

  <section class="shell about-focus-section" id="writing">
    <div class="about-section-heading">
      <p class="section-kicker">{copy.focusLabel}</p>
      <h2>{isZh ? "关注边界" : "Working boundaries"}</h2>
    </div>
    <ul class="writing-list">
      {copy.focusItems.map((item) => <li>{item}</li>)}
    </ul>
  </section>
</SiteLayout>
