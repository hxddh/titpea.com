---
import SiteLayout from "../layouts/SiteLayout.astro";
import type { AboutPageModel } from "../content/siteModel";

interface Props {
  model: AboutPageModel;
}

const { model } = Astro.props;
---

<SiteLayout seo={model.seo} current={model.current} locale={model.locale} language={model.language}>
  <section class="about-hero about-redesign-hero shell">
    <div class="about-redesign-copy">
      <p class="eyebrow">{model.hero.eyebrow}</p>
      <h1>{model.hero.title}</h1>
      <p class="lead">{model.hero.lead}</p>
      <div class="actions about-contact-row" aria-label={model.hero.contactLabel}>
        {
          model.hero.actions.map((action) => (
            <a class:list={["button", action.style]} href={action.href} rel="noreferrer">
              {action.label}
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="about-products shell">
    <div class="about-section-heading">
      <p class="section-kicker">{model.products.label}</p>
      <h2>{model.products.title}</h2>
    </div>
    <div class="about-product-grid">
      {
        model.products.items.map((item) => (
          <a class:list={["about-product-card", item.isPrimary && "primary"]} href={item.href}>
            <span>{item.name}</span>
            <strong>{item.tagline}</strong>
            <p>{item.text}</p>
          </a>
        ))
      }
    </div>
  </section>
</SiteLayout>
