---
import SiteLayout from "../layouts/SiteLayout.astro";
import "../styles/about.css";
import type { AboutPageModel } from "../lib/pages";

interface Props {
  model: AboutPageModel;
}

const { model } = Astro.props;
---

<SiteLayout seo={model.seo} current={model.current} locale={model.locale} language={model.language}>
  {/* The claim, the owner's own words, how to reach them. The tools are in the
      header and the footer already (design v5.2). */}
  <section class="shell about-hero page-end">
    <h1 class="display">{model.hero.title}</h1>
    <div class="cols rule">
      <div class="cols-margin">
        {model.person?.portrait && (
          <img
            class="about-portrait"
            src={model.person.portrait.src}
            alt={model.person.portrait.alt}
            width={model.person.portrait.width}
            height={model.person.portrait.height}
          />
        )}
        <p class="fact">{model.hero.eyebrow}</p>
        <p class="about-links">
          {model.links.map((link) => (
            <a class="textlink" href={link.href} rel="noreferrer">
              {link.label}
            </a>
          ))}
        </p>
      </div>
      {model.person && (
        <div class="cols-main about-body">
          {model.person.paragraphs.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </div>
      )}
      {model.analytics && <p class="cols-full about-analytics">{model.analytics}</p>}
    </div>
  </section>
</SiteLayout>
