---
import SiteLayout from "../layouts/SiteLayout.astro";
import type { AboutPageModel } from "../content/siteModel";

interface Props {
  model: AboutPageModel;
}

const { model } = Astro.props;
---

<SiteLayout seo={model.seo} current={model.current} locale={model.locale} language={model.language}>
  <section class="about-hero about-redesign-hero shell">
    <div class="about-redesign-copy">
      <p class="eyebrow">{model.hero.eyebrow}</p>
      <h1>{model.hero.title}</h1>
      <p class="lead">{model.hero.lead}</p>
      <div class="actions about-contact-row" aria-label={model.hero.contactLabel}>
        {
          model.hero.actions.map((action) => (
            <a class:list={["button", action.style]} href={action.href} rel="noreferrer">
              {action.label}
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="about-focus-section shell">
    <div class="about-section-heading">
      <p class="section-kicker">{model.profile.label}</p>
      <h2>{model.profile.title}</h2>
      {model.profile.body.map((paragraph) => <p>{paragraph}</p>)}
    </div>
    <div class="about-system-panel">
      <div>
        <span>{model.focus.label}</span>
        <ul class="about-focus-list">
          {model.focus.items.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="about-products shell">
    <div class="about-section-heading">
      <p class="section-kicker">{model.products.label}</p>
      <h2>{model.products.title}</h2>
    </div>
    <div class="product-ledger about-product-ledger" aria-label={model.products.title}>
      {
        model.products.items.map((item) => (
          <a class:list={["product-ledger-row", item.isPrimary && "primary"]} href={item.href}>
            <span class="ledger-number">{item.number ?? "--"}</span>
            <span class="ledger-role">{item.displayRole}</span>
            <strong>{item.name}</strong>
            <p>{item.text}</p>
          </a>
        ))
      }
    </div>
  </section>
</SiteLayout>
