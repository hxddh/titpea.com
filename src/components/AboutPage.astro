---
import SiteLayout from "../layouts/SiteLayout.astro";
import type { AboutPageModel } from "../content/siteModel";

interface Props {
  model: AboutPageModel;
}

const { model } = Astro.props;
---

<SiteLayout seo={model.seo} current={model.current} locale={model.locale} language={model.language}>
  <section class="about-hero shell">
    <div class="about-hero-grid">
      <div class="about-person">
        <p class="eyebrow">{model.hero.eyebrow}</p>
        <h1>{model.hero.lead}</h1>
        <p class="lead about-hero-body">{model.hero.body}</p>
      </div>

      <div class="about-principles" aria-labelledby="about-why-heading">
        <p class="section-kicker">{model.why.label}</p>
        <h2 id="about-why-heading">{model.why.title}</h2>
        <ul class="about-principle-list">
          {
            model.why.lines.map((line) => (
              <li>
                <strong>{line.label}</strong>
                <span>{line.body}</span>
              </li>
            ))
          }
        </ul>
        <p class="about-why-closing">{model.why.closing}</p>
      </div>
    </div>
  </section>

  <section class="about-featured shell" aria-labelledby="about-featured-heading">
    <h2 id="about-featured-heading" class="home-catalog-label">{model.featured.label}</h2>
    <div class="work-list about-work-list" role="list">
      {
        model.featured.items.map((item) => (
          <a class="work-row is-flagship" href={item.href} role="listitem">
            <span class="work-row-name">{item.name}</span>
            <span class="work-row-text">{item.text}</span>
            <span class="work-row-arrow" aria-hidden="true">
              →
            </span>
          </a>
        ))
      }
    </div>
    <p class="about-all-products">
      <a class="text-link" href={model.featured.allProducts.href}>{model.featured.allProducts.label}</a>
    </p>
  </section>

  <section class="about-contact shell" aria-label={model.contact.label}>
    <p class="section-kicker">{model.contact.label}</p>
    <div class="actions about-contact-row">
      {
        model.contact.actions.map((action) => (
          <a class="text-link" href={action.href} rel={action.external ? "noreferrer" : undefined}>
            {action.label}
          </a>
        ))
      }
    </div>
  </section>
</SiteLayout>
