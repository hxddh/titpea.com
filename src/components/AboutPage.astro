---
import SiteLayout from "../layouts/SiteLayout.astro";
import type { AboutPageModel } from "../lib/pages";

interface Props {
  model: AboutPageModel;
}

const { model } = Astro.props;
---

<SiteLayout seo={model.seo} current={model.current} locale={model.locale} language={model.language}>
  <section class="about-hero">
    <div class="wash" aria-hidden="true"></div>
    <div class="shell narrow about-copy">
      <p class="eyebrow">{model.hero.eyebrow}</p>
      <h1>{model.hero.title}</h1>
      <p class="lead">{model.hero.lead}</p>
      <div class="about-body">
        {model.body.map((paragraph) => <p>{paragraph}</p>)}
      </div>
      <div class="actions about-contact-row" aria-label={model.hero.contactLabel}>
        {
          model.hero.actions.map((action) => (
            <a
              class:list={["button", action.style, action.style === "primary" && "large"]}
              href={action.href}
              rel="noreferrer"
            >
              {action.label}
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="about-principles" aria-labelledby="principles-title">
    <div class="shell">
      <header class="section-head">
        <h2 id="principles-title">{model.principles.title}</h2>
      </header>
      <ul class="feature-grid" data-count={model.principles.items.length}>
        {
          model.principles.items.map((item) => (
            <li class="feature-card">
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="about-releases" aria-labelledby="releases-title">
    <div class="shell narrow">
      <header class="section-head">
        <h2 id="releases-title">{model.releases.title}</h2>
        <p class="sub">{model.releases.sub}</p>
      </header>
      <ol class="release-list">
        {
          model.releases.items.map((item) => (
            <li>
              <a href={item.href}>
                {item.icon ? (
                  <img src={item.icon} alt="" width="36" height="36" />
                ) : (
                  <span class="release-dot" aria-hidden="true" />
                )}
                <strong>{item.name}</strong>
                <span class="release-version">{item.version}</span>
                {item.released && <span class="release-date">{item.released}</span>}
              </a>
            </li>
          ))
        }
      </ol>
      <p class="release-feed">
        <a class="button ghost" href={model.releases.feed.href}>{model.releases.feed.label}</a>
      </p>
    </div>
  </section>
</SiteLayout>
