---
import SiteLayout from "../layouts/SiteLayout.astro";
import "../styles/about.css";
import type { AboutPageModel } from "../lib/pages";

interface Props {
  model: AboutPageModel;
}

const { model } = Astro.props;
---

<SiteLayout seo={model.seo} current={model.current} locale={model.locale} language={model.language}>
  {/* The claim, then the owner's own words beside how to reach them, then the tools themselves. */}
  <section class="shell about-hero">
    <h1 class="display">{model.hero.title}</h1>
    <div class="cols rule">
      <div class="cols-margin">
        {model.person?.portrait && (
          <img
            class="about-portrait"
            src={model.person.portrait.src}
            alt={model.person.portrait.alt}
            width={model.person.portrait.width}
            height={model.person.portrait.height}
          />
        )}
        <p class="fact">{model.hero.eyebrow}</p>
        <p class="about-links">
          {model.links.map((link) => (
            <a class="textlink" href={link.href} rel="noreferrer">
              {link.label}
            </a>
          ))}
        </p>
      </div>
      {model.person && (
        <div class="cols-main about-body">
          {model.person.paragraphs.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </div>
      )}
    </div>
  </section>
  <section class="shell page-section page-end">
    <div class="cols rule">
      <div class="cols-margin">
        <h2 class="heading">{model.tools.label}</h2>
      </div>
      <div class="cols-main">
        <ul class="about-tools">
          {model.tools.items.map((item) => (
            <li>
              <a href={item.href}>
                <img src={item.icon} alt="" width="40" height="40" loading="lazy" />
                <span>{item.name}</span>
              </a>
            </li>
          ))}
        </ul>
        {model.analytics && <p class="about-analytics">{model.analytics}</p>}
      </div>
    </div>
  </section>
</SiteLayout>
