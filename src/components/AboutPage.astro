---
import SiteLayout from "../layouts/SiteLayout.astro";
import HomeFeed from "./home/HomeFeed.astro";
import SiteBottomCta from "./site/SiteBottomCta.astro";
import type { AboutPageModel } from "../content/siteModel";

interface Props {
  model: AboutPageModel;
}

const { model } = Astro.props;
---

<SiteLayout seo={model.seo} current={model.current} locale={model.locale} language={model.language}>
  <section class="about-hero shell">
    <div class="editorial-copy">
      <p class="eyebrow">{model.hero.eyebrow}</p>
      <h1>{model.hero.lead}</h1>
    </div>
  </section>

  <HomeFeed {...model.feed} sectionClass="about-feed" />
  {model.chrome.showBottomCta && <SiteBottomCta chrome={model.chrome} />}
</SiteLayout>
