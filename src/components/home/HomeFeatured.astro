---
import type { ProductCatalogItemModel } from "../../content/pages/types";

interface Props {
  items: ProductCatalogItemModel[];
}

const { items } = Astro.props;
---

<section class="home-featured shell" aria-label="Featured tools">
  <div class="featured-grid">
    {
      items.map((item) => (
        <a class="featured-card" href={item.href}>
          <p class="featured-meta">
            {item.number ? `${item.number} · ` : ""}
            {item.displayRole}
          </p>
          <h3>{item.name}</h3>
          <p class="featured-excerpt">{item.text}</p>
          <span class="feature-link">Learn more →</span>
        </a>
      ))
    }
  </div>
</section>
