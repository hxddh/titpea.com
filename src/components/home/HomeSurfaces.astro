---
import type { HomeSurfaceModel } from "../../content/pages/types";

interface Props {
  chapterTitle: string;
  chapterThesis: string;
  items: HomeSurfaceModel[];
}

const { chapterTitle, chapterThesis, items } = Astro.props;
---

<section class="home-surfaces shell">
  <div class="chapter-heading">
    <h2>{chapterTitle}</h2>
    <p class="chapter-thesis">{chapterThesis}</p>
  </div>
  <div class="surface-grid">
    {
      items.map((item) => (
        <a class="surface-card" href={item.href}>
          <span class="surface-card-label">{item.label}</span>
          <h3>{item.title}</h3>
          <p>{item.count}</p>
          <span class="surface-card-cta">{item.ctaLabel} →</span>
        </a>
      ))
    }
  </div>
</section>
