---
import FeedRow from "../FeedRow.astro";
import type { FeedFilterModel } from "../../content/pages/types";

interface Props extends FeedFilterModel {
  sectionClass?: string;
}

const { filterLabel, filters, items, sectionClass = "home-feed" } = Astro.props;

const groupLabel = (group: (typeof items)[number]["group"]) =>
  group === "storage"
    ? filters.find((item) => item.id === "storage")?.label
    : filters.find((item) => item.id === "personal")?.label;
---

<section class:list={["shell", sectionClass]}>
  <div class="feed-filter" role="tablist" aria-label={filterLabel} data-feed-filter>
    {
      filters.map((filter, index) => (
        <button type="button" role="tab" aria-selected={index === 0 ? "true" : "false"} data-filter={filter.id}>
          {filter.label}
        </button>
      ))
    }
  </div>
  <div class="feed-list">
    {
      items.map((item) => (
        <FeedRow
          href={item.href}
          group={item.group}
          meta={[...(item.number ? [item.number] : []), item.displayRole, groupLabel(item.group) ?? ""].filter(Boolean)}
          title={item.name}
          excerpt={item.text}
        />
      ))
    }
  </div>
</section>

<script is:inline src="/scripts/feed-filter.js" defer></script>
