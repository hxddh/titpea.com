---
import type { ProductEvidenceModel } from "../content/productPageTypes";

interface Props {
  section: ProductEvidenceModel;
}

const { section } = Astro.props;
const variantClass = {
  scanPlan: "s3-scan-plan",
  diagnosisFlow: "diagnosis-flow",
  trafficFlow: "traffic-flow",
}[section.variant];
---

<section id={section.id} class:list={["product-section product-deep-dive", variantClass]}>
  <div class="shell">
    <header class="section-head">
      <p class="section-kicker">{section.kicker}</p>
      <h2>{section.title}</h2>
      <p class="sub">{section.body}</p>
    </header>
    <ol class="feature-grid product-flow" aria-label={section.title} data-count={section.cards.length} data-numbered>
      {
        section.cards.map((card, index) => (
          <li class="feature-card">
            <span class="feature-step">{index + 1}</span>
            <h3>{card.label}</h3>
            <p>{card.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
