---
import type { Locale, Product } from "../lib/site";
import { s3EvidenceFacts, storageOpsEvidenceFacts } from "../content/productEvidenceFacts";

interface Props {
  locale: Locale;
  product: Product;
}

const { locale, product } = Astro.props;
const isZh = locale === "zh";
---

{
  product.role === "inventory" && (
    <section id="evidence" class="shell product-deep-dive s3-deep-dive">
      <div class="deep-dive-heading">
        <p class="section-kicker">{isZh ? "证据链" : "Evidence chain"}</p>
        <h2>{isZh ? "从发现到校验，一次运行闭环" : "One run from discovery to verification"}</h2>
        <p>
          {isZh
            ? "s3-turbo-list 的重点不是多给参数，而是把大型对象存储 list / diff 里最容易出错的步骤收进默认路径。"
            : "s3-turbo-list is not a pile of knobs. It pulls the error-prone parts of large object-storage list and diff runs into the default path."}
        </p>
      </div>
      <div class="deep-dive-grid s3-run-grid">
        {s3EvidenceFacts.deepDiveCards.map((card, index) => (
          <article>
            <span>{String(index + 1).padStart(2, "0")}</span>
            <h3>{card.label[locale]}</h3>
            <p>{card.body[locale]}</p>
          </article>
        ))}
      </div>
      <div class="deep-dive-benchmark">
        <div>
          <span>{isZh ? "第三方 OSS 测试" : "Third-party OSS run"}</span>
          <strong>{isZh ? "1M 对象" : "1M objects"}</strong>
        </div>
        {s3EvidenceFacts.parallelRuns.map((run) => (
          <div>
            <span>{run.label}</span>
            <strong>{run.seconds}s</strong>
            <p>{run.throughput.toLocaleString()} objects/s</p>
          </div>
        ))}
      </div>
    </section>
  )
}

{
  product.role === "diagnosis" && (
    <section id="evidence" class="shell product-deep-dive storageops-deep-dive">
      <div class="deep-dive-heading">
        <p class="section-kicker">{isZh ? "Agent 拓扑" : "Agent topology"}</p>
        <h2>{isZh ? "技能决定判断，工具负责取证" : "Skills decide; tools collect evidence"}</h2>
        <p>
          {isZh
            ? "StorageOps 的核心不是提示词，而是把 Pi 的诊断过程拆成领域技能、取证工具、确定性脚本和回归评测。"
            : "StorageOps is not a prompt pack. It breaks Pi diagnosis into domain skills, evidence tools, deterministic helpers, and evals."}
        </p>
      </div>
      <div class="agent-topology">
        {storageOpsEvidenceFacts.capabilityCards.map((card) => (
          <article>
            <span>{card.label[locale]}</span>
            <strong>{card.value}</strong>
            <p>{card.body[locale]}</p>
          </article>
        ))}
      </div>
    </section>
  )
}
